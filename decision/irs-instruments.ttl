@prefix : <http://example.org/trust-domain/decision#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =====================================================================
# IRS publications as instruments (DRAFT, read 2026-11-21 on irs.gov)
#
# The founder's framing: the publications "are the instruments that tell us
# what we can do, with the right perspective". Each instrument records what
# it permits, under which conditions and limits, which role can use it, the
# red flag it guards against and the check that flag became, the route a
# typical household misses, and how well it was read:
#   ReadInPublication - quoted from the edition named
#   ReadHeadingOnly   - only a heading, table of contents or a summary seen
#   Inferred          - our reading, not a sentence in the publication
#   NotRead           - named only
# Figures are the edition's own, with its year. A publication explains the
# law; the Code and regulations are the law. Not legal or tax advice.
# =====================================================================

<http://example.org/trust-domain/irs-instruments> a owl:Ontology ;
    rdfs:label "IRS publications as instruments"@en ;
    owl:versionInfo "0.1.0-proposed" ;
    owl:imports <http://example.org/trust-domain/stewardship> .

# ---------------------------------------------------------------------
# Vocabulary
# ---------------------------------------------------------------------
:Instrument a owl:Class ; rdfs:label "IRS publication or instructions, read as an instrument"@en .
:Permission a owl:Class ; rdfs:label "One thing an instrument permits, with its conditions"@en .
:Role a owl:Class ; rdfs:label "A role in the founder's structure"@en .
:InstrumentStatus a owl:Class .
:Current a :InstrumentStatus ; rdfs:label "current edition seen on irs.gov"@en .
:CurrentUnconfirmed a :InstrumentStatus ; rdfs:label "edition seen, but whether it is still the current one was not confirmed"@en .
:Discontinued a :InstrumentStatus ; rdfs:label "discontinued; history only"@en .

:edition a owl:DatatypeProperty ; rdfs:domain :Instrument .
:status a owl:ObjectProperty ; rdfs:domain :Instrument ; rdfs:range :InstrumentStatus .
:sourceUrl a owl:DatatypeProperty ; rdfs:range xsd:anyURI .
:replacedBy a owl:ObjectProperty ; rdfs:domain :Instrument .
:grants a owl:ObjectProperty ; rdfs:domain :Instrument ; rdfs:range :Permission .
:permits a owl:DatatypeProperty ; rdfs:domain :Permission .
:condition a owl:DatatypeProperty ; rdfs:domain :Permission .
:usableBy a owl:ObjectProperty ; rdfs:domain :Permission ; rdfs:range :Role .
:notUsableBy a owl:ObjectProperty ; rdfs:domain :Permission ; rdfs:range :Role .
:becomesCheck a owl:ObjectProperty ; rdfs:domain :Permission ; rdfs:range :DecisionCheck .
:ircSection a owl:DatatypeProperty ; rdfs:comment "The Code section the instrument cites for this permission."@en .
:householdMisses a owl:DatatypeProperty ; rdfs:domain :Permission ;
    rdfs:comment "The lawful route a typical household does not use, in plain words."@en .
:quote a owl:DatatypeProperty .

# Roles (playsRole in tests/decision/entity-deal-cases.ttl links the case roles here)
:Role_Foundation a :Role ; rdfs:label "the private foundation"@en .
:Role_FamilyTrust a :Role ; rdfs:label "the family trust (beneficiaries: the foundation and family members)"@en .
:Role_BusinessTrust a :Role ; rdfs:label "the business trust that owns the operating company"@en .
:Role_OperatingCompany a :Role ; rdfs:label "the operating company"@en .
:Role_ManagementCompany a :Role ; rdfs:label "the founder's management company"@en .
:Role_FounderAsTrustee a :Role ; rdfs:label "the founder as trustee (a steward, not a beneficiary)"@en .
:Role_FounderAsEmployee a :Role ; rdfs:label "the founder as a common-law employee of an entity"@en .
:Role_FounderSelfEmployed a :Role ; rdfs:label "the founder as sole proprietor, partner or 2% S corporation shareholder"@en .

# ---------------------------------------------------------------------
# Pub 15-B: what an employer may give tax-free
# ---------------------------------------------------------------------
:Pub15B a :Instrument ; rdfs:label "Publication 15-B, Employer's Tax Guide to Fringe Benefits"@en ;
    :edition "2026 (For use in 2026; dated Dec 23, 2025)" ; :status :Current ;
    :sourceUrl "https://www.irs.gov/publications/p15b"^^xsd:anyURI ;
    :quote "Any fringe benefit you provide is taxable and must be included in the recipient's pay unless the law specifically excludes it." ;
    :grants :Perm15B_HealthAndCafeteria , :Perm15B_GroupTermLife , :Perm15B_DependentCare ,
            :Perm15B_WorkingCondition , :Perm15B_Lodging , :Perm15B_TwoPercentRule .

:Perm15B_HealthAndCafeteria a :Permission ;
    :permits "Exclude employer-paid accident and health coverage; let employees choose between cash and qualified benefits in a cafeteria plan, including a health FSA (2026: $3,400)." ;
    :condition "A cafeteria plan covers 'A current common-law employee.' A plan that favors highly compensated or key employees: 'you must include in their wages the value of taxable benefits they could have selected.' Key-employee test: 'more than 25% of the total of the nontaxable benefits'. A simple cafeteria plan is open to an employer with 'an average of 100 or fewer employees during either of the 2 preceding years'." ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_Foundation , :Role_FounderAsEmployee ;
    :notUsableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX1 , :Check_FX2 , :Check_FX3 , :Check_ST1b ;
    :ircSection "105, 106, 125" ;
    :evidence :ReadInPublication ;
    :householdMisses "Health coverage and set-aside dollars paid by an entity where you are a common-law employee are not wages. Owners of pass-through entities lose this; a corporation taxed under subchapter C keeps it." ;
    rdfs:comment "That a plan with the founder as its only participant fails the 25% key-employee test is inferred, not read." .
:Perm15B_GroupTermLife a :Permission ;
    :permits "Exclude the cost of employer-paid group-term life insurance up to $50,000 of coverage." ;
    :condition "Include the cost beyond $50,000 of coverage. Key employees in a discriminatory plan lose the exclusion (79(d)(1)(A), read)." ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_Foundation , :Role_FounderAsEmployee ;
    :notUsableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX2 , :Check_FX3 ; :ircSection "79" ; :evidence :ReadInPublication ;
    :householdMisses "Employer-paid life insurance is tax-free only to the coverage line; above it, the cost is wages. This is the 'insurance policy' line an executive package uses." .
:Perm15B_DependentCare a :Permission ;
    :permits "Exclude dependent care assistance (2026 limit $7,500, up from $5,000)." ;
    :condition "Nondiscrimination rules apply." ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_Foundation , :Role_FounderAsEmployee ;
    :becomesCheck :Check_FX2 , :Check_FX3 ; :ircSection "129" ; :evidence :ReadInPublication .
:Perm15B_WorkingCondition a :Permission ;
    :permits "Reimburse business use of a personal vehicle at the cents-per-mile rate, tax-free, as a working condition benefit." ;
    :condition "'You may use this rate to reimburse an employee for business use of a personal vehicle.' The payment must be one that 'would be allowable as a deduction under section 162 or 167' (132(d), read), with records (Pub 463). The 2026 rate was not yet published when read; 2025 was 70 cents (Pub 463)." ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_Foundation , :Role_FounderAsEmployee ;
    :becomesCheck :Check_FX4 , :Check_FX0 ; :ircSection "132(d)" ; :evidence :ReadInPublication ;
    :householdMisses "A flat car allowance is wages. The same dollars paid against a mileage log are not. The executive 'car allowance' line in a proxy is the taxable version." ;
    rdfs:comment "15-B's own text on cash allowances was not read; the allowance-is-wages reading is inferred from the general rule." .
:Perm15B_Lodging a :Permission ;
    :permits "Exclude lodging furnished on the business premises." ;
    :condition "Table 2-1: 'Exempt if furnished on your business premises, for your convenience, and as a condition of employment.' 'Exemption doesn't apply to S corporation employees who are 2% shareholders.'" ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_FounderAsEmployee ;
    :notUsableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX5 ; :ircSection "119" ; :evidence :ReadInPublication ;
    :householdMisses "Housing is tax-free only where the job requires living on the business premises. A home that is an entity's mailing address is not that (inferred)." .
:Perm15B_TwoPercentRule a :Permission ;
    :permits "Nothing new: this is the limit on the others." ;
    :condition "'Don't treat a 2% shareholder of an S corporation as an employee of the corporation for this purpose.' 'Treat a 2% shareholder as you would a partner in a partnership for fringe benefit purposes'. A person may serve 'as an independent contractor, partner, or director.'" ;
    :notUsableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX1 ; :ircSection "1372" ; :evidence :ReadInPublication ;
    :householdMisses "The form of the employer decides the benefit. Pick the entity form before the benefits, not after." ;
    rdfs:comment "Section 1372 is the usual cite for the 2% rule; it was not read here."@en .

# ---------------------------------------------------------------------
# Form 7206: the owner's fallback for health premiums
# ---------------------------------------------------------------------
:Form7206Instr a :Instrument ; rdfs:label "Instructions for Form 7206, Self-Employed Health Insurance Deduction"@en ;
    :edition "2025" ; :status :Current ;
    :sourceUrl "https://www.irs.gov/instructions/i7206"^^xsd:anyURI ;
    :grants :Perm7206_SEHealth .
:Perm7206_SEHealth a :Permission ;
    :permits "Deduct health insurance premiums as a self-employed person, a partner, or a more-than-2% S corporation shareholder." ;
    :condition "Eligible if self-employed with a net profit, a partner with self-employment earnings, or 'You received wages in 2025 from an S corporation in which you were a more-than-2% shareholder.' The plan must be established under the business. 'You can't take the deduction for any month you were eligible to participate in any employer' subsidized plan. Long-term care premiums are capped by age ($480 to $6,020 for 2025)." ;
    :usableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX1 ; :ircSection "162(l)" ; :evidence :ReadInPublication ;
    :householdMisses "When the owner cannot exclude premiums (15-B), the premiums still come off income here, as long as no employer plan was open to them that month." .

# ---------------------------------------------------------------------
# What a business may deduct: guide page (Pub 535 replacement), 334, 463, 587, 538, 946
# ---------------------------------------------------------------------
:Pub535 a :Instrument ; rdfs:label "Publication 535, Business Expenses"@en ;
    :edition "2022 (last revision)" ; :status :Discontinued ;
    :quote "We have discontinued Publication 535, Business Expenses; the last revision was for 2022." ;
    :replacedBy :Pub334 , :Pub463 , :Pub587 , :Form7206Instr , :GuideBusinessExpenses ;
    rdfs:comment "History only. Pub 334 (2025) also says 'Pub. 535, Business Expenses, has been discontinued'."@en .
:GuideBusinessExpenses a :Instrument ; rdfs:label "IRS guide to business expense resources"@en ;
    :status :Current ; :sourceUrl "https://www.irs.gov/forms-pubs/guide-to-business-expense-resources"^^xsd:anyURI ;
    :evidence :ReadInPublication .

:Pub334 a :Instrument ; rdfs:label "Publication 334, Tax Guide for Small Business"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p334"^^xsd:anyURI ;
    :grants :Perm162_OrdinaryNecessary ;
    rdfs:comment "Its cash and accrual sections were not read; timing comes from Pub 538."@en .
:Perm162_OrdinaryNecessary a :Permission ;
    :permits "Deduct ordinary and necessary business expenses, including reasonable pay." ;
    :condition "162(a), read: 'all the ordinary and necessary expenses paid or incurred during the taxable year in carrying on any trade or business', including 'a reasonable allowance for salaries or other compensation for personal services actually rendered'. Not personal, living or family expenses (262(a), read). Not capital (263(a), read)." ;
    :usableBy :Role_OperatingCompany , :Role_ManagementCompany , :Role_BusinessTrust , :Role_FounderSelfEmployed ;
    :notUsableBy :Role_Foundation ;
    :becomesCheck :Check_BD1 , :Check_BD2 , :Check_BD3 , :Check_ST1a ; :ircSection "162, 262, 263" ;
    :evidence :ReadInStatute ;
    :householdMisses "The business deducts what it pays you as reasonable pay; you are taxed on it as wages unless an exclusion applies. Both halves must be true at once: that is the executive-package pattern." ;
    rdfs:comment "A private foundation pays no income tax on exempt activity, so a deduction is no use to it; its test is 4941 'not excessive' instead. That is inferred from the structure, not read in 334."@en .

:Pub463 a :Instrument ; rdfs:label "Publication 463, Travel, Gift, and Car Expenses"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p463"^^xsd:anyURI ;
    :grants :Perm463_RecordsAndRates .
:Perm463_RecordsAndRates a :Permission ;
    :permits "Deduct or reimburse travel, meals (generally 50%) and car costs at the standard mileage rate (2025: 70 cents a mile)." ;
    :condition "'An ordinary expense is one that is common and accepted in your trade or business.' 'An expense doesn't have to be required to be considered necessary.' 'you must keep records of all the expenses you have and any advances you receive from your employer.'" ;
    :usableBy :Role_OperatingCompany , :Role_ManagementCompany , :Role_FounderAsEmployee , :Role_FounderSelfEmployed ;
    :becomesCheck :Check_FX4 , :Check_BD1 ; :ircSection "162, 274" ; :evidence :ReadInPublication ;
    :householdMisses "The log is the deduction. Without contemporaneous records the same trip is personal." ;
    rdfs:comment "Its commuting section was not read. Pub 15-B (2026) says employer meals are no longer deductible after 2025."@en .

:Pub587 a :Instrument ; rdfs:label "Publication 587, Business Use of Your Home"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p587"^^xsd:anyURI ;
    :grants :Perm587_HomeOffice .
:Perm587_HomeOffice a :Permission ;
    :permits "Deduct the business part of a home, including under a simplified method ($5 a square foot, up to 300 square feet; year not stated on the page read)." ;
    :condition "'you must use a specific area of your home only for your trade or business'. 'Incidental or occasional business use is not regular use.' Principal place includes administrative or management work where 'You have no other fixed location where you conduct substantial administrative or management activities'. 'The rules in this publication apply to individuals.'" ;
    :usableBy :Role_FounderSelfEmployed ;
    :becomesCheck :Check_BD6 ; :ircSection "280A" ; :evidence :ReadInPublication ;
    :householdMisses "A room used only for running the business's books and management counts even when the real work happens elsewhere. A home that is only a mailing address does not count (inferred: 587 does not speak to mailing addresses)." ;
    rdfs:comment "An employee's home office is not deductible to the employee in these years; the route for an employee is an accountable-plan reimbursement by the employer (inferred, not read here). 280A was named, not read."@en .

:Pub538 a :Instrument ; rdfs:label "Publication 538, Accounting Periods and Methods"@en ;
    :edition "Rev. January 2022" ; :status :CurrentUnconfirmed ;
    :sourceUrl "https://www.irs.gov/publications/p538"^^xsd:anyURI ;
    :grants :Perm538_Timing .
:Perm538_Timing a :Permission ;
    :permits "Choose the cash or accrual method (or a hybrid) and deduct in the year the method allows; prepay up to 12 months under the 12-month rule." ;
    :condition "'Under the cash method, generally, you deduct expenses in the tax year in which you actually pay them.' Accrual: 'Generally, you cannot deduct or capitalize a business expense until economic performance occurs.' An amount owed to a related cash-method person is 'not deductible until you make the payment'. Gross receipts test '$26 million or less (indexed for inflation)' (448(c))." ;
    :usableBy :Role_OperatingCompany , :Role_ManagementCompany , :Role_BusinessTrust , :Role_FounderSelfEmployed ;
    :becomesCheck :Check_BD5 ; :ircSection "446, 448, 461, 267" ; :evidence :ReadInPublication ;
    :householdMisses "Timing is a lever: a cash-method business that pays a bill on December 31 deducts it this year. Between related entities, the deduction waits for the cash." .

:Pub946 a :Instrument ; rdfs:label "Publication 946, How To Depreciate Property"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p946"^^xsd:anyURI ;
    :grants :Perm946_Section179 .
:Perm946_Section179 a :Permission ;
    :permits "Elect to deduct the cost of qualifying property in the year placed in service, instead of capitalizing it; 100% special depreciation reinstated for property acquired after January 19, 2025." ;
    :condition "Section 179 limit $2,500,000 for 2025, reduced over $4,000,000; 'For tax years beginning in 2026, the maximum section 179 expense deduction is $2,560,000' (reduced over $4,090,000). Inventory and land are not depreciable. Listed property needs records." ;
    :usableBy :Role_OperatingCompany , :Role_ManagementCompany , :Role_FounderSelfEmployed ;
    :becomesCheck :Check_BD3 ; :ircSection "179, 168(k)" ; :evidence :ReadInPublication ;
    :householdMisses "Equipment does not have to be written off over years; the election takes it this year. Land never qualifies." .

:Perm195_Startup a :Permission ;
    :permits "Deduct up to $5,000 of start-up costs in the year the business begins, and the rest over 180 months." ;
    :condition "195(b)(1), read: '$5,000, reduced (but not below zero) by the amount by which such start-up expenditures exceed $50,000'; only on election and once the active business begins." ;
    :usableBy :Role_OperatingCompany , :Role_ManagementCompany , :Role_FounderSelfEmployed ;
    :becomesCheck :Check_BD4 ; :ircSection "195" ; :evidence :ReadInStatute ;
    :householdMisses "Costs of getting an acquisition or new company ready are not lost; the election recovers them." ;
    rdfs:comment "Read in the statute; no publication was read for it."@en .

# ---------------------------------------------------------------------
# Income side: Pub 525
# ---------------------------------------------------------------------
:Pub525 a :Instrument ; rdfs:label "Publication 525, Taxable and Nontaxable Income"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p525"^^xsd:anyURI ;
    :quote "an amount included in your income is taxable unless it is specifically exempted by law" ;
    :grants :Perm525_EmployeeSide .
:Perm525_EmployeeSide a :Permission ;
    :permits "Leave excluded fringe benefits and employer health coverage out of income." ;
    :condition "Fringe benefits are income 'unless you pay FMV for them or they're specifically excluded by law'. Health FSA limit 2025: $3,300 (125(i))." ;
    :usableBy :Role_FounderAsEmployee ;
    :becomesCheck :Check_FX0 ; :ircSection "61, 125(i)" ; :evidence :ReadInPublication ;
    :householdMisses "The employee's side of 15-B: the same benefit is checked twice, once for the payer, once for the person." .

# ---------------------------------------------------------------------
# Employment: Pub 15, 15-A
# ---------------------------------------------------------------------
:Pub15 a :Instrument ; rdfs:label "Publication 15, (Circular E), Employer's Tax Guide"@en ;
    :edition "2026 (dated Dec 15, 2025)" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p15"^^xsd:anyURI ;
    :grants :Perm15_FamilyEmployees .
:Perm15_FamilyEmployees a :Permission ;
    :permits "Pay family members who do real work; a child under 18 working for a parent's sole proprietorship or parents-only partnership is exempt from social security and Medicare tax." ;
    :condition "The exemption does not reach a corporation's payroll. Form 1099-NEC threshold $2,000 for 2026 (read)." ;
    :usableBy :Role_FounderSelfEmployed , :Role_ManagementCompany , :Role_OperatingCompany ;
    :becomesCheck :Check_ST1a , :Check_AL1b ; :ircSection "3121(b)(3)" ;
    :evidence :ReadHeadingOnly ;
    :householdMisses "Real wages to family for real work are a deduction and, in an unincorporated business, can skip payroll tax for a minor child. Pay must still be reasonable." ;
    rdfs:comment "The family-employee rules were seen only as a summary; verify in the publication before relying on them. Pay to the founder's children from the foundation is self-dealing in any case (4946(d) family)."@en .
:Pub15A a :Instrument ; rdfs:label "Publication 15-A, Employer's Supplemental Tax Guide"@en ;
    :edition "2026" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p15a"^^xsd:anyURI ;
    :grants :Perm15A_WorkerStatus .
:Perm15A_WorkerStatus a :Permission ;
    :permits "Classify workers as employees or contractors by the common-law control test; corporate officers who perform services are employees." ;
    :condition "Form SS-8 asks the IRS to decide; relief provisions exist for some misclassification." ;
    :usableBy :Role_ManagementCompany , :Role_OperatingCompany , :Role_Foundation ;
    :becomesCheck :Check_FX1 ; :evidence :ReadHeadingOnly ;
    :householdMisses "Being an officer-employee of your own corporation is what unlocks the employee-only exclusions." ;
    rdfs:comment "Seen only as a summary; verify in the publication."@en .

# ---------------------------------------------------------------------
# Foundation and giving: 4221-PF, 557, 526, 561, 1041 instructions
# ---------------------------------------------------------------------
:Pub4221PF a :Instrument ; rdfs:label "Publication 4221-PF, Compliance Guide for 501(c)(3) Private Foundations"@en ;
    :edition "Rev. August 2014" ; :status :CurrentUnconfirmed ;
    :sourceUrl "https://www.irs.gov/pub/irs-pdf/p4221pf.pdf"^^xsd:anyURI ;
    :evidence :NotRead ;
    rdfs:comment "Listed among current forms and publications; the PDF itself was not opened. A related IRS page (read) says a foundation files Form 990-PF while its exemption application is pending, those returns are open to public disclosure, and Form 990-T is required for unrelated business income over $1,000."@en .
:Pub557 a :Instrument ; rdfs:label "Publication 557, Tax-Exempt Status for Your Organization"@en ;
    :edition "Rev. January 2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p557"^^xsd:anyURI ;
    :grants :Perm557_OperatingFoundation .
:Perm557_OperatingFoundation a :Permission ;
    :permits "Qualify as a private operating foundation, which runs its own programs (4942(j)(3))." ;
    :condition "Seen as a summary: Form 8940 for some determinations; net investment income excise tax 1.39%." ;
    :usableBy :Role_Foundation ; :ircSection "4942(j)(3), 4940" ; :evidence :ReadHeadingOnly ;
    :householdMisses "A foundation that runs programs itself, rather than making grants, has different payout and donor rules." ;
    rdfs:comment "Only the table of contents and a summary were seen; verify before relying."@en .
:Pub526 a :Instrument ; rdfs:label "Publication 526, Charitable Contributions"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p526"^^xsd:anyURI ;
    :grants :Perm526_Giving .
:Perm526_Giving a :Permission ;
    :permits "Deduct gifts to qualified organizations when itemizing; a large noncash gift needs a qualified appraisal on Form 8283 Section B." ;
    :condition "The percentage limits for gifts to a private nonoperating foundation were not read." ;
    :usableBy :Role_FounderSelfEmployed , :Role_FounderAsEmployee , :Role_FamilyTrust ;
    :becomesCheck :Check_AL1a ; :ircSection "170" ; :evidence :ReadInPublication ;
    rdfs:comment "Gifts into the foundation also bear on substantial-contributor status (507(d)(2)), rehearsal/09."@en .
:Pub561 a :Instrument ; rdfs:label "Publication 561, Determining the Value of Donated Property"@en ;
    :edition "Rev. December 2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/publications/p561"^^xsd:anyURI ;
    :grants :Perm561_FMV .
:Perm561_FMV a :Permission ;
    :permits "Value property at fair market value." ;
    :condition "'FMV is the price that property would sell for on the open market.' 'It is the price that would be agreed on between a willing buyer and a willing seller'. Insured value is not FMV." ;
    :usableBy :Role_Foundation , :Role_FamilyTrust , :Role_BusinessTrust , :Role_OperatingCompany , :Role_ManagementCompany ;
    :becomesCheck :Check_AL1a , :Check_AL1b ; :evidence :ReadInPublication ;
    :householdMisses "The willing-buyer, willing-seller test is the same test arm's length uses between related entities. Write the range down before the deal." .
:Instr1041 a :Instrument ; rdfs:label "Instructions for Form 1041, U.S. Income Tax Return for Estates and Trusts"@en ;
    :edition "2025" ; :status :Current ; :sourceUrl "https://www.irs.gov/instructions/i1041"^^xsd:anyURI ;
    :grants :Perm1041_DNI .
:Perm1041_DNI a :Permission ;
    :permits "A trust deducts what it distributes, up to distributable net income; the beneficiary pays the tax on it." ;
    :condition "Distribution deduction 'limited to DNI' (Schedule B). 'The beneficiary, and not the trust or decedent's estate, pays income tax on their distributive share of income.' Filing threshold $600. 'Trusts can't be used to transform a taxpayer's personal, living, or educational expenses into deductible items.'" ;
    :usableBy :Role_FamilyTrust , :Role_BusinessTrust , :Role_FounderAsTrustee ;
    :becomesCheck :Check_BD2 ; :ircSection "651, 661, 643(a), 642(c)" ; :evidence :ReadInPublication ;
    :householdMisses "A trust passes income, and the tax on it, to its beneficiaries through distributions. It cannot turn personal costs into deductions." ;
    rdfs:comment "642(c) was seen as a heading only; 663(b) was not found. A distribution to a family beneficiary of income that came from the foundation's money is the 'for the benefit of' problem (rehearsal/09)."@en .
