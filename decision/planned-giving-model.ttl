    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=7&SS=2&SS2=3"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_7_2_4 a :SecondarySource ; rdfs:label "GiftLaw Pro 7.2.4 Excess Business Holdings"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=7&SS=2&SS2=4"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_4_8_3 a :SecondarySource ; rdfs:label "GiftLaw Pro 4.8.3 Partnerships and LLCs: Self-Dealing Issues"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=4&SS=8&SS2=3"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_4_14_2 a :SecondarySource ; rdfs:label "GiftLaw Pro 4.14.2 Charity as Sub S Shareholder"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=4&SS=14&SS2=2"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_4_2_3 a :SecondarySource ; rdfs:label "GiftLaw Pro 4.2.3 C Corporations: Stock Sale with Unitrust"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=4&SS=2&SS2=3"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_3_7_5 a :SecondarySource ; rdfs:label "GiftLaw Pro 3.7.5 Life Estate vs. Qualified Personal Residence Trust"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=3&SS=7&SS2=5"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_2_1 a :SecondarySource ; rdfs:label "GiftLaw Pro 2.1 Bargain Sale"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_section.jsp?WebID=GL1999-0001&CC=2&SS=1"^^xsd:anyURI ; :fetchResult "refused automated fetch" .
:GL_7_2_9 a :SecondarySource ; rdfs:label "GiftLaw Pro 7.2.9 Private Operating Foundations"@en ;
    :sourceUrl "https://giftlawpro.giftlegacy.com/glawpro_subsection.jsp?WebID=GL1999-0001&CC=7&SS=2&SS2=9"^^xsd:anyURI ; :fetchResult "refused automated fetch" .

# ---------------------------------------------------------------------
# Instruments: the Code and regulations behind each vehicle
# ---------------------------------------------------------------------
:IRC4947 a :Instrument ; rdfs:label "IRC 4947 and Reg. 1.170A-6: lead and other split-interest trusts"@en ;
    :edition "uscode.house.gov, current through P.L. 119-120; 1.170A-6 at law.cornell.edu" ; :status :Current ;
    :sourceUrl "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title26-section4947&num=0&edition=prelim"^^xsd:anyURI ;
    :grants :PermLead_FamilyRemainder , :PermLead_HoldBusinessAt60 .
:PermLead_FamilyRemainder a :Permission ;
    :permits "Pay the foundation a fixed annuity or unitrust amount for a term, then pass the remainder to family members, with a charitable deduction for the lead interest." ;
    :condition "The lead interest is a guaranteed annuity or a unitrust interest, paid at least annually (1.170A-6(c)). The trust is then treated as a private foundation for self-dealing (4947(a)(2)). A low 7520 rate makes the lead interest worth more (GiftLaw 3.5.1, secondary)." ;
    :usableBy :Role_FamilyTrust , :Role_FounderAsTrustee ;
    :becomesCheck :Check_PG1 , :Check_PG2 , :Check_PG9 ;
    :ircSection "170(f)(2)(B), 642(c), 2522(c)(2)(B), 4947(a)(2)" ; :evidence :ReadInStatute ;
    :secondarySource :GL_3_5_1 ;
    :householdMisses "The family keeps the remainder; the foundation gets a dependable stream; and the gift is valued after the charity's share is subtracted." .
:PermLead_HoldBusinessAt60 a :Permission ;
    :permits "Hold an interest in the family business inside a lead trust without the excess-business-holdings tax." ;
    :condition "4947(b)(3)(A): the charitable income interest is worth 'not more than 60 percent' of the trust's fair market value. That keeps more of the gift taxable when the trust is funded; whether that trade is worth it is a counsel and numbers question (inferred)." ;
    :usableBy :Role_FamilyTrust , :Role_BusinessTrust ;
    :becomesCheck :Check_PG3a , :Check_PG3b ;
    :ircSection "4943, 4947(b)(3)" ; :evidence :ReadInStatute ;
    :secondarySource :GL_5_3_3 .

:IRC4943 a :Instrument ; rdfs:label "IRC 4943: excess business holdings"@en ;
    :edition "uscode.house.gov, current through P.L. 119-120" ; :status :Current ;
    :sourceUrl "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title26-section4943&num=0&edition=prelim"^^xsd:anyURI ;
    :grants :Perm4943_GiftPeriod , :Perm4943_Passive .
:Perm4943_GiftPeriod a :Permission ;
    :permits "Receive a business interest by gift or bequest and hold it over the limit for five years, extendable by five more." ;
    :condition "4943(c)(6) and (c)(7); the extension is the Secretary's to grant. Holdings must be down to the limit when the period ends." ;
    :usableBy :Role_Foundation ; :becomesCheck :Check_PG3a , :Check_PG3b ;
    :ircSection "4943(c)(6), (c)(7)" ; :evidence :ReadInStatute ; :secondarySource :GL_7_2_4 .
:Perm4943_Passive a :Permission ;
    :permits "Hold any share of a company that earns at least 95 percent of its gross income from passive sources." ;
    :condition "4943(d)(3)(B). A holding company of rental property or securities qualifies; an operating company does not." ;
    :usableBy :Role_Foundation , :Role_FamilyTrust ; :becomesCheck :Check_PG3a ;
    :ircSection "4943(d)(3)(B)" ; :evidence :ReadInStatute ; :secondarySource :GL_7_2_4 .

:IRC4941Estate a :Instrument ; rdfs:label "Reg. 53.4941(d)-1(b)(3): the estate administration exception"@en ;
    :edition "law.cornell.edu, read 2026-11-21" ; :status :Current ;
    :sourceUrl "https://www.law.cornell.edu/cfr/text/26/53.4941(d)-1"^^xsd:anyURI ;
    :grants :Perm4941_EstateSale , :Perm4941_SameTermsRedemption .
:Perm4941_EstateSale a :Permission ;
    :permits "Let a family member or a family company buy, from the estate, property the foundation would otherwise receive, without self-dealing." ;
    :condition "All five: a power of sale (or to reallocate, or a required sale under an option); probate court approval; before the estate terminates for income tax; the foundation gets at least fair market value of its interest; and what it gets is at least as liquid as what it gave up." ;
    :usableBy :Role_FounderAsTrustee , :Role_Foundation ; :becomesCheck :Check_PG2 ;
    :ircSection "4941(d)" ; :evidence :ReadInStatute ; :secondarySource :GL_7_2_2 ;
    :householdMisses "A bequest of the operating company to the foundation can be converted to cash inside the estate, with the business staying in family hands, if the court approves a fair price." .
:Perm4941_SameTermsRedemption a :Permission ;
    :permits "Let a company that is a disqualified person redeem the shares a foundation or split-interest trust holds." ;
    :condition "4941(d)(2)(F): every holder of the class gets the same terms, and the foundation gets no less than fair market value. GiftLaw 3.10.1 (secondary) summarizes PLR 200720021: 'Redemption of stock from a CRT by a disqualified for-profit is not self-dealing.'" ;
    :usableBy :Role_OperatingCompany , :Role_Foundation ; :becomesCheck :Check_PG2 ;
    :ircSection "4941(d)(2)(F)" ; :evidence :ReadInStatute ; :secondarySource :GL_3_10_1 , :GL_4_2_3 .

:IRC664 a :Instrument ; rdfs:label "IRC 664: charitable remainder unitrusts"@en ;
    :edition "uscode.house.gov, current through P.L. 119-124" ; :status :Current ;
    :sourceUrl "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title26-section664&num=0&edition=prelim"^^xsd:anyURI ;
    :grants :Perm664_SellInsideTrust .
:Perm664_SellInsideTrust a :Permission ;
    :permits "Contribute appreciated property, let the trust sell it free of income tax, and take a fixed percentage of the trust each year." ;
    :condition "Payout 5 to 50 percent; remainder worth at least 10 percent (664(d)(2)). The trust pays an excise tax equal to any unrelated business taxable income (664(c)(2)). Not for S corporation stock (1361)." ;
    :usableBy :Role_FounderAsTrustee , :Role_FamilyTrust ;
    :becomesCheck :Check_PG4 , :Check_PG4b , :Check_PG5 ;
    :ircSection "664(c), 664(d)(2)" ; :evidence :ReadInStatute ; :secondarySource :GL_3_10_1 , :GL_4_2_3 .

:IRC1361 a :Instrument ; rdfs:label "IRC 1361: who may hold S corporation stock"@en ;
    :edition "law.cornell.edu, read 2026-11-21" ; :status :Current ;
    :sourceUrl "https://www.law.cornell.edu/uscode/text/26/1361"^^xsd:anyURI ;
    :grants :Perm1361_FoundationShareholder .
:Perm1361_FoundationShareholder a :Permission ;
    :permits "Give S corporation stock to the foundation itself; a 501(c)(3) organization 'may be a shareholder in an S corporation' (1361(c)(6))." ;
    :condition "The foundation's share of S income is likely unrelated business income (512(e), not read), and 4943 still applies to the foundation's holding." ;
    :usableBy :Role_Foundation ; :becomesCheck :Check_PG5 , :Check_PG3a ;
    :ircSection "1361(c)(6)" ; :evidence :ReadInStatute ; :secondarySource :GL_4_14_2 .

:IRC2702 a :Instrument ; rdfs:label "IRC 2702 and Reg. 25.2702-5: qualified personal residence trusts"@en ;
    :edition "law.cornell.edu, read 2026-11-21" ; :status :Current ;
    :sourceUrl "https://www.law.cornell.edu/cfr/text/26/25.2702-5"^^xsd:anyURI ;
    :grants :Perm2702_ResidenceTrust .
:Perm2702_ResidenceTrust a :Permission ;
    :permits "Move the home into a trust, keep living in it for a term, and value the gift as the remainder only." ;
    :condition "One residence (principal or one other); primary use as the term holder's residence; a home office is fine if secondary; no transient lodging with services; the instrument bars any sale back to the grantor." ;
    :usableBy :Role_FounderAsTrustee ; :becomesCheck :Check_PG6 ;
    :ircSection "2702(a)(3)(A)(ii)" ; :evidence :ReadInStatute ; :secondarySource :GL_3_7_5 .

:IRC1011b a :Instrument ; rdfs:label "IRC 1011(b) and Reg. 1.1011-2: bargain sales"@en ;
    :edition "uscode.house.gov, current through P.L. 119-142" ; :status :Current ;
    :sourceUrl "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title26-section1011&num=0&edition=prelim"^^xsd:anyURI ;
    :grants :Perm1011_BargainSale .
:Perm1011_BargainSale a :Permission ;
    :permits "Sell property to a public charity below its value; the discount is a gift." ;
    :condition "Basis is split in the 1011(b) ratio. A sale by a disqualified person to the private foundation is self-dealing at any price (inferred, PG7a)." ;
    :usableBy :Role_FounderAsTrustee , :Role_OperatingCompany ; :notUsableBy :Role_Foundation ;
    :becomesCheck :Check_PG7a , :Check_PG7b ;
    :ircSection "1011(b), 170" ; :evidence :ReadInStatute ; :secondarySource :GL_2_1 .

:IRC4942 a :Instrument ; rdfs:label "IRC 4942: minimum distributions"@en ;
    :edition "law.cornell.edu, read 2026-11-21" ; :status :Current ;
    :sourceUrl "https://www.law.cornell.edu/uscode/text/26/4942"^^xsd:anyURI ;
    :grants :Perm4942_Payout .
:Perm4942_Payout a :Permission ;
    :permits "Keep the foundation's investment assets, including family business interests, as long as qualifying distributions reach the distributable amount by the end of the following year." ;
    :condition "5 percent of noncharitable-use assets less acquisition debt, less the year's income and 4940 taxes. Operating foundation status ((j)(3)) has its own tests; the percentage that replaced 'substantially all' was not on the page read." ;
    :usableBy :Role_Foundation ; :becomesCheck :Check_PG8 ;
    :ircSection "4942(a), (d), (e)(1), (j)(3)" ; :evidence :ReadInStatute ; :secondarySource :GL_7_2_3 , :GL_7_2_9 .
