<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_blind_path" targetNamespace="http://example.org/trust-domain/rehearsal/blind-path">
  <!-- Blind-goal adversarial path (rehearsal/11-blind-goal-adversarial-path.md). SYNTHETIC. Design and education, not legal or tax advice. Generated; edit the generator, not by hand. -->
  <bpmn:collaboration id="Collab"><bpmn:participant id="P" name="Blind-goal adversarial path" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="L_D" name="Dalaun">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_heldout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_B" name="Builder">
        <bpmn:flowNodeRef>b_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_step</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_src</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_gw2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_A" name="Adversary checker">
        <bpmn:flowNodeRef>a_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_K" name="Keystone checker">
        <bpmn:flowNodeRef>k_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k_gw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_G" name="Grader (holds the key)">
        <bpmn:flowNodeRef>g_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_grade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_out</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_C" name="Counsel">
        <bpmn:flowNodeRef>c_packet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_advise</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Goal and keystone claim set"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="d_heldout" name="Held-out cases written outside the builder; hashes committed"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing><bpmn:dataOutputAssociation id="da_do_commit"><bpmn:targetRef>do_commit</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="b_read" name="Read goal, facts, adversary library, practice set"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:dataInputAssociation id="da_do_practice"><bpmn:sourceRef>do_practice</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
    <bpmn:task id="b_step" name="Propose next step with every fact stated"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="a_check" name="Score every pattern: closest, fact difference, contrary authority, no whole match (BG1-BG5)"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:dataInputAssociation id="da_do_lib"><bpmn:sourceRef>do_lib</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:task>
    <bpmn:exclusiveGateway id="a_gw" name="Step clears the adversary?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="k_check" name="Same claim held; supports, blocks, silent or unresolved; agrees with facts (BG6)"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="k_gw" name="Link blocks?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="b_src" name="Name the step's key source, or mark ASSUMPTION (BG7)"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="b_gw" name="Path complete?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="g_commit" name="Key matches its commitment (GR1); held-out budget left (GR3)"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:dataInputAssociation id="da_do_key"><bpmn:sourceRef>do_key</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="da_do_log"><bpmn:targetRef>do_log</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="g_grade" name="Right answer and every step traceable? (GR4)"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="g_out" name="Return pass or fail only (GR2)"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="b_gw2" name="Pass?"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="c_packet" name="Receive packet: every material fact, the path, the questions (CR2, private)"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:dataOutputAssociation id="da_do_rel"><bpmn:targetRef>do_rel</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
    <bpmn:task id="c_advise" name="Advise; sign off or not (CR1, CR3)"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:task>
    <bpmn:task id="d_act" name="Act only after the advice; reliance record kept (CR4)"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="end" name="Step taken on the up and up"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="start" targetRef="d_heldout"/>
    <bpmn:sequenceFlow id="f1" sourceRef="d_heldout" targetRef="b_read"/>
    <bpmn:sequenceFlow id="f2" sourceRef="b_read" targetRef="b_step"/>
    <bpmn:sequenceFlow id="f3" sourceRef="b_step" targetRef="a_check"/>
    <bpmn:sequenceFlow id="f4" sourceRef="a_check" targetRef="a_gw"/>
    <bpmn:sequenceFlow id="f5" sourceRef="a_gw" targetRef="b_step" name="No: revise the step"/>
    <bpmn:sequenceFlow id="f6" sourceRef="a_gw" targetRef="k_check" name="Yes"/>
    <bpmn:sequenceFlow id="f7" sourceRef="k_check" targetRef="k_gw"/>
    <bpmn:sequenceFlow id="f8" sourceRef="k_gw" targetRef="b_step" name="Yes: revise"/>
    <bpmn:sequenceFlow id="f9" sourceRef="k_gw" targetRef="b_src" name="No"/>
    <bpmn:sequenceFlow id="f10" sourceRef="b_src" targetRef="b_gw"/>
    <bpmn:sequenceFlow id="f11" sourceRef="b_gw" targetRef="b_step" name="No: next step"/>
    <bpmn:sequenceFlow id="f12" sourceRef="b_gw" targetRef="g_commit" name="Yes: submit path"/>
    <bpmn:sequenceFlow id="f13" sourceRef="g_commit" targetRef="g_grade"/>
    <bpmn:sequenceFlow id="f14" sourceRef="g_grade" targetRef="g_out"/>
    <bpmn:sequenceFlow id="f15" sourceRef="g_out" targetRef="b_gw2" name="one bit"/>
    <bpmn:sequenceFlow id="f16" sourceRef="b_gw2" targetRef="b_step" name="Fail: try a new route"/>
    <bpmn:sequenceFlow id="f17" sourceRef="b_gw2" targetRef="c_packet" name="Pass: hand to counsel"/>
    <bpmn:sequenceFlow id="f18" sourceRef="c_packet" targetRef="c_advise"/>
    <bpmn:sequenceFlow id="f19" sourceRef="c_advise" targetRef="d_act"/>
    <bpmn:sequenceFlow id="f20" sourceRef="d_act" targetRef="end"/>
    <bpmn:dataStoreReference id="do_practice" name="Practice set K1-K33, SK1-SK16 (public)"/>
    <bpmn:dataStoreReference id="do_key" name="Held-out key (secret, verifier environment)"/>
    <bpmn:dataStoreReference id="do_commit" name="Commitments: salted hashes (public)"/>
    <bpmn:dataStoreReference id="do_lib" name="Adversary library: sets A (97-24, sham, 7701(o)) and B (4941, 4943, 4945)"/>
    <bpmn:dataStoreReference id="do_log" name="Held-out use log"/>
    <bpmn:dataStoreReference id="do_rel" name="Reliance record and packet (private folder)"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
    <bpmndi:BPMNShape id="P_di" bpmnElement="P" isHorizontal="true"><dc:Bounds x="120" y="0" width="2925" height="900"/></bpmndi:BPMNShape>
