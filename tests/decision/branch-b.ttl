@prefix : <http://example.org/trust-domain/decision-cases#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Insider branch B: under the line.
# The founder's 4946(d) family hold 30 percent of the actuarial beneficial
# interest; siblings hold another 30 percent, which does not count (4946(d),
# 53.4946-1(h)); the trust has not yet become a substantial contributor.
# Synthetic settings, not the real trust's terms. Not legal advice.

dm:BranchUnderLine dm:selectedBy "tests/decision/branch-b.ttl" .

:FamilyTrust dm:dqFamilySharePercent "30"^^xsd:decimal ;
    dm:otherRelativeSharePercent "30"^^xsd:decimal ;
    dm:foundationSharePercent "40"^^xsd:decimal ;
    dm:foundationInterestKind dm:IncomeAndRemainder ;
    dm:substantialContributor false ;
    dm:charitableDeductionAllowed false ;
    dm:trusteePaid false .
