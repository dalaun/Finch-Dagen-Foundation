@prefix : <http://example.org/trust-domain/decision-cases#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Worked spend proposals for decide_spend.py. Synthetic: roles, never real
# names; every amount is illustrative. No verdict is stated here: the
# shapes grade each proposal and expected.ttl is the answer key.

# ---------------------------------------------------------------------
# Who is who (roles). td:Founder is in trust-domain-ontology.ttl.
# ---------------------------------------------------------------------
:FounderChild a td:DisqualifiedPerson ;
    rdfs:label "Founder's child" ;
    rdfs:comment "Member of the family under 26 USC 4946(d), so disqualified under 4946(a)(1)(D)." .
:FounderSibling rdfs:label "Founder's sibling" ;
    dm:siblingOf td:Founder ;
    rdfs:comment "Not a member of the family: 4946(d) covers only spouse, ancestors, descendants to great-grandchildren and their spouses." .
:ManagementCompany a td:DisqualifiedPerson ;
    rdfs:label "Founder's management company" ;
    rdfs:comment "A corporation in which disqualified persons own more than 35 percent of the voting power: 4946(a)(1)(E)." .
:FamilyTrust rdfs:label "Family trust: the foundation and family members are beneficiaries; the founder is trustee" ;
    dm:insiderStatusPending true ;
    rdfs:comment "Its insider status is derived from the facts in tests/decision/branch-*.ttl: the 4946(d) family's actuarial share (over 35 percent makes it an insider, 4946(a)(1)(G)) and whether it has become a substantial contributor (4946(a)(1)(A)). Being trustee is control, not beneficial interest." .
td:Founder dm:trusteeOf :FamilyTrust .
:BusinessTrust rdfs:label "Business trust that owns the operating company; the family trust holds its beneficial interest" ;
    dm:insiderStatusPending true ;
    dm:beneficialInterestHeldBy :FamilyTrust .
:OperatingCompany rdfs:label "Operating company owned by the business trust" ;
    dm:insiderStatusPending true ;
    dm:votingControlHeldBy :BusinessTrust ;
    dm:passesBenefitTo :ManagementCompany ;
    rdfs:comment "Pays the founder's management company a management fee." .
:AITrainer rdfs:label "AI trainer (unrelated)" .
:Contractor rdfs:label "Contractor who works two programs (unrelated)" .
:FriendsNonprofit a td:PublicCharity ;
    rdfs:label "Public charity run by the founder's friend" ;
    dm:friendOf td:Founder ;
    dm:passesBenefitTo :FounderChild ;
    rdfs:comment "Plans to hire the founder's child with the grant." .
:SocialEnterpriseLLC a td:NonExemptGrantee ; rdfs:label "Resident-run social enterprise (LLC, not a charity)" .
:ResidentCoop rdfs:label "Resident-owned cooperative business (not a charity)" .
:StudentApplicant rdfs:label "Individual student applicant" .
:AdvocacyFirm rdfs:label "Advocacy firm" .
:IndexFund rdfs:label "Broad market index fund" .
:ThirdPartySeller rdfs:label "Unrelated seller of operating-company shares" .
:VanDealer rdfs:label "Vehicle dealer" .
:EventCharity a td:PublicCharity ; rdfs:label "Public charity that hosts events" .
:FY2027 rdfs:label "Fiscal year 2027" .
:FY2028 rdfs:label "Fiscal year 2028" .

# ---------------------------------------------------------------------
# Cascade nodes the proposals assess (stage 1)
# ---------------------------------------------------------------------
# Founder as program director of AI agent training, paid for services
:Role_ProgramDirector a td:OperatorInRole ;
    td:servesActivity td:Program_AIAgentTraining ;
    td:necessitates :CompDomain_ProgramDirector ;
    rdfs:label "Program director, AI agent training" .
td:Program_AIAgentTraining td:requires :Role_ProgramDirector .
:CompDomain_ProgramDirector a td:CompensationDomain ;
    td:sustains :Role_ProgramDirector ;
    td:manifestsAs :Pay_Director_Feb2027 , :Pay_Director_Feb2028 ;
    td:enablesPrivately :Enable_DirectorPay .
:Pay_Director_Feb2027 a td:ActualSpend ;
    td:tracesBackTo td:FoundationOpportunityMission ;
    gist:hasMagnitude [ a gist:Magnitude ; gist:numericValue "5000.00"^^xsd:decimal ;
        gist:hasUnitOfMeasure <http://qudt.org/vocab/currency/USD> ; td:hasPaymentPeriod td:PerMonth ] ;
    rdfs:label "Program director pay, Feb 2027" .
:Pay_Director_Feb2028 a td:ActualSpend ;
    td:tracesBackTo td:FoundationOpportunityMission ;
    gist:hasMagnitude [ a gist:Magnitude ; gist:numericValue "5000.00"^^xsd:decimal ;
        gist:hasUnitOfMeasure <http://qudt.org/vocab/currency/USD> ; td:hasPaymentPeriod td:PerMonth ] ;
    rdfs:label "Program director pay, Feb 2028" .
:Enable_DirectorPay a td:EmployeeCompensationEnablement ;
    td:isIncidentalTo td:FoundationOpportunityMission ;
    td:isInseparableFrom td:Program_AIAgentTraining ;
    td:hasMarketBenchmark :Benchmark_ProgramDirector .
:Benchmark_ProgramDirector a gist:Magnitude ;
    gist:numericValue "72000.00"^^xsd:decimal ;
    gist:hasUnitOfMeasure <http://qudt.org/vocab/currency/USD> ;
    td:hasPaymentPeriod td:PerYear ;
    dcterms:source "Illustrative value, not a market survey" .

# Founder's personal travel, claimed under Opportunity
:Spend_FounderTravel a td:ActualSpend ;
    td:tracesBackTo td:FoundationOpportunityMission ;
    td:benefitsPerson td:Founder ;
    rdfs:label "Founder's personal travel" .

# Lobbying contract
:Spend_Lobbying a td:ActualSpend ;
    td:tracesBackTo td:FoundationEducationMission ;
    rdfs:label "Contract to lobby the state legislature for a curriculum bill" .

# Grants under the existing grantmaking program
:Grant_FriendsNonprofit a td:Grant ; td:grantedUnder td:Program_HempCurriculumGrants ;
    td:tracesBackTo td:FoundationEducationMission ; td:grantAmount "15000.00"^^xsd:decimal .
:Grant_Scholarships a td:Grant ; td:grantedUnder td:Program_HempCurriculumGrants ;
    td:tracesBackTo td:FoundationEducationMission ; td:grantAmount "3000.00"^^xsd:decimal .
:Grant_SocialEnterprise a td:Grant ; td:grantedUnder td:Program_HempCurriculumGrants ;
    td:tracesBackTo td:FoundationEducationMission ; td:grantAmount "10000.00"^^xsd:decimal .
:Grant_ResortSeries a td:Grant ; td:grantedUnder td:Program_HempCurriculumGrants ;
    td:tracesBackTo td:FoundationEducationMission ; td:grantAmount "20000.00"^^xsd:decimal .

# Program van
:Asset_ProgramVan a td:TangibleAsset ;
    td:deployedIn td:Program_AIAgentTraining ;
    rdfs:label "Van that takes trainers to neighborhood sessions" .
td:ExampleFoundationTrust td:controls :Asset_ProgramVan .

# ---------------------------------------------------------------------
# Proposals
# ---------------------------------------------------------------------
# P01 Unrelated trainer at market for a real program.
:P01_TrainerPay a dm:SpendProposal ; dm:assesses td:Pay_AITrainer_Feb2027 ;
    dm:payee :AITrainer ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:purposeKind dm:CharitablePurpose ; dm:beneficiarySelection dm:OpenSelection ;
    dm:scorerVerdict dm:IntentClean .

# P02 Curriculum grant to a public charity.
:P02_CollegeGrant a dm:SpendProposal ; dm:assesses td:Grant_HempCurriculum ;
    dm:payee td:Grantee_CommunityCollege ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    dm:purposeKind dm:CharitablePurpose ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P03 Founder's personal travel, reimbursed to him.
:P03_FounderTravel a dm:SpendProposal ; dm:assesses :Spend_FounderTravel ;
    dm:payee td:Founder ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:assetAlsoUsedBy dm:NoOneElse ; dm:scorerVerdict dm:IntentClean .

# P04 Founder pays himself to direct a program, at market, no comparability record.
:P04_FounderPayNoRecord a dm:SpendProposal ; dm:assesses :Pay_Director_Feb2027 ;
    dm:payee td:Founder ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "60000.00"^^xsd:decimal ; dm:benchmarkAnnual "72000.00"^^xsd:decimal ; dm:fiscalYear :FY2027 ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P05 Same role and pay the next year, with a written comparability record.
:P05_FounderPayWithRecord a dm:SpendProposal ; dm:assesses :Pay_Director_Feb2028 ;
    dm:payee td:Founder ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:comparabilityRecord true ;
    dm:annualAmount "60000.00"^^xsd:decimal ; dm:benchmarkAnnual "72000.00"^^xsd:decimal ; dm:fiscalYear :FY2028 ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P06 The founder's management company paid a market fee to steward the ontology.
:P06_ManagementFee a dm:SpendProposal ; dm:assesses td:Pay_OntologySteward_Jan2027 ;
    dm:payee :ManagementCompany ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P07 The founder's sibling hired as the street-grid workshop instructor, at market.
:P07_SiblingInstructor a dm:SpendProposal ; dm:assesses td:Pay_WorkshopInstructor_Mar2027 ;
    dm:payee :FounderSibling ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P08 Grant to a friend's public charity that will hire the founder's child.
:P08_FriendGrant a dm:SpendProposal ; dm:assesses :Grant_FriendsNonprofit ;
    dm:payee :FriendsNonprofit ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P09 Scholarships picked by the founder, no IRS-approved procedure.
:P09_Scholarships a dm:SpendProposal ; dm:assesses :Grant_Scholarships ;
    dm:payee :StudentApplicant ; dm:dqScreened true ; dm:spendKind dm:GrantToIndividual ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P10 Grant to a resident social enterprise LLC, no expenditure responsibility.
:P10_LLCGrantNoER a dm:SpendProposal ; dm:assesses :Grant_SocialEnterprise ;
    dm:payee :SocialEnterpriseLLC ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P11 The same grant with expenditure responsibility in place.
:P11_LLCGrantWithER a dm:SpendProposal ; dm:assesses :Grant_SocialEnterprise ;
    dm:payee :SocialEnterpriseLLC ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    dm:expenditureResponsibility true ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P12 Low-interest loan to a resident-owned cooperative (program-related investment).
:P12_CoopLoan a dm:SpendProposal ;
    dm:payee :ResidentCoop ; dm:dqScreened true ; dm:spendKind dm:Investment ;
    dm:primaryPurposeCharitable true ; dm:significantIncomePurpose false ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P13 Endowment money into a broad index fund.
:P13_IndexFund a dm:SpendProposal ;
    dm:payee :IndexFund ; dm:dqScreened true ; dm:spendKind dm:Investment ;
    dm:primaryPurposeCharitable false ; dm:significantIncomePurpose true ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P14 Buy 15 percent of the operating company's voting stock from an unrelated
#     seller; the business trust holds 30 percent. Bought from the business
#     trust itself, it would also be R1 in branch A.
:P14_OperatingCoShares a dm:SpendProposal ;
    dm:payee :ThirdPartySeller ; dm:dqScreened true ; dm:spendKind dm:Investment ;
    dm:primaryPurposeCharitable false ; dm:significantIncomePurpose true ;
    dm:boughtVotingPercent "15"^^xsd:decimal ; dm:chainHeldVotingPercent "30"^^xsd:decimal ;
    dm:chainTrust :FamilyTrust ; dm:chainHolder :BusinessTrust ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .
#     The foundation's total and the insiders' total are derived by rule IR9 (4943(d)(1)).

# P15 Lobbying contract for a curriculum bill.
:P15_Lobbying a dm:SpendProposal ; dm:assesses :Spend_Lobbying ;
    dm:payee :AdvocacyFirm ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    dm:purposeKind dm:InfluenceLegislation ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:assetAlsoUsedBy dm:NoOneElse ; dm:scorerVerdict dm:IntentClean .

# P16 Program van the founder also drives on weekends.
:P16_VanPersonalUse a dm:SpendProposal ; dm:assesses :Asset_ProgramVan ;
    dm:payee :VanDealer ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    dm:assetAlsoUsedBy td:Founder ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P17 Training cohort open only to the management company's consulting clients.
:P17_ClientCohort a dm:SpendProposal ; dm:assesses td:Pay_AITrainer_Feb2027 ;
    dm:payee :AITrainer ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:beneficiarySelection dm:InsiderDrawnSelection ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P18 One contractor paid by two programs; each under its benchmark, the sum over.
:P18a_ContractorWorkshops a dm:SpendProposal ; dm:assesses td:Pay_WorkshopInstructor_Mar2027 ;
    dm:payee :Contractor ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "20000.00"^^xsd:decimal ; dm:benchmarkAnnual "24000.00"^^xsd:decimal ; dm:fiscalYear :FY2027 ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .
:P18b_ContractorSteward a dm:SpendProposal ; dm:assesses td:Pay_OntologySteward_Jan2027 ;
    dm:payee :Contractor ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "60000.00"^^xsd:decimal ; dm:benchmarkAnnual "78000.00"^^xsd:decimal ; dm:fiscalYear :FY2027 ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P26 One consultant, one year, three proposals: P26a and P26b are two ways to
#     make the same payment (alternatives), P26c is a second payment. Counted once
#     per payment, at the larger alternative, the year is 35,000 + 30,000 = 65,000,
#     under the 70,000 benchmark: no split. Counting both alternatives would
#     wrongly reach 95,000 for P26c.
:P26a_ConsultantPlanA a dm:SpendProposal ; dm:assesses td:Pay_AITrainer_Feb2027 ;
    dm:payee :Consultant ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "30000.00"^^xsd:decimal ; dm:benchmarkAnnual "40000.00"^^xsd:decimal ; dm:fiscalYear :FY2029 ;
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .
:P26b_ConsultantPlanB a dm:SpendProposal ; dm:assesses td:Pay_AITrainer_Feb2027 ;
    dm:payee :Consultant ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "35000.00"^^xsd:decimal ; dm:benchmarkAnnual "40000.00"^^xsd:decimal ; dm:fiscalYear :FY2029 ;
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .
:P26c_ConsultantSecondJob a dm:SpendProposal ; dm:assesses td:Pay_OntologySteward_Jan2027 ;
    dm:payee :Consultant ; dm:dqScreened true ; dm:spendKind dm:PersonalServicesPay ;
    dm:annualAmount "30000.00"^^xsd:decimal ; dm:benchmarkAnnual "70000.00"^^xsd:decimal ; dm:fiscalYear :FY2029 ;
    dm:fringeBenefitAnnual "0"^^xsd:decimal ;
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .
:Consultant a dm:Party .
:FY2029 a dm:FiscalYear .

# P19 Payee never screened against 4946.
:P19_Unscreened a dm:SpendProposal ; dm:assesses td:Pay_WorkshopInstructor_Mar2027 ;
    dm:payee :Contractor ; dm:dqScreened false ; dm:spendKind dm:PersonalServicesPay ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P20 Grant to a public charity for a workshop series at a resort the founder
#     favors; every letter check passes, the scorer answers "yes".
:P20_ResortSeries a dm:SpendProposal ; dm:assesses :Grant_ResortSeries ;
    dm:payee :EventCharity ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    dm:scorerVerdict dm:IntentBent ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection .

# P21 The same grant; the scorer answers "cannot tell".
:P21_ResortSeriesUnclear a dm:SpendProposal ; dm:assesses :Grant_ResortSeries ;
    dm:payee :EventCharity ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    dm:scorerVerdict dm:IntentCannotTell ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection .

# P22 Rent paid to the family trust for program space, at market.
:P22_RentFromFamilyTrust a dm:SpendProposal ; dm:assesses td:Pay_WorkshopInstructor_Mar2027 ;
    dm:payee :FamilyTrust ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    rdfs:comment "Leasing between a foundation and a disqualified person is self-dealing at any price (4941(d)(1)(A)). Assesses the workshop program spend only to carry stage 1." ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:assetAlsoUsedBy dm:NoOneElse ; dm:scorerVerdict dm:IntentClean .

# P23 Program T-shirts bought from the operating company, at its outside price.
:P23_OperatingCoPurchase a dm:SpendProposal ; dm:assesses td:Pay_WorkshopInstructor_Mar2027 ;
    dm:payee :OperatingCompany ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    rdfs:comment "A sale of goods between a foundation and a disqualified person is self-dealing at any price (4941(d)(1)(A)). Assesses the workshop program spend only to carry stage 1." ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:assetAlsoUsedBy dm:NoOneElse ; dm:scorerVerdict dm:IntentClean .

# P24 A grant to the family trust to run a program, no expenditure responsibility.
:P24_GrantToFamilyTrust a dm:SpendProposal ; dm:assesses :Grant_SocialEnterprise ;
    dm:payee :FamilyTrust ; dm:dqScreened true ; dm:spendKind dm:GrantToOrganization ;
    rdfs:comment "Assesses an existing grant node only to carry stage 1." ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:beneficiarySelection dm:OpenSelection ; dm:scorerVerdict dm:IntentClean .

# P27-P29 Program supplies bought at market from vendors that also gave. Whether
# each vendor is a substantial contributor (507(d)(2)) is derived from the gift
# ledger (tests/decision/gift-ledger.ttl) by rule IR10, not typed on the case.
# Found by the keystone model: with status typed by hand, P27 graded Allow.
:Asset_TrainingLaptops a td:TangibleAsset ;
    td:deployedIn td:Program_AIAgentTraining ;
    rdfs:label "Laptops for neighborhood training sessions" .
td:ExampleFoundationTrust td:controls :Asset_TrainingLaptops .

# P27 The supply vendor gave 20,000 of 484,000 (4.1 percent): a substantial contributor.
:P27_SuppliesFromBigDonor a dm:SpendProposal ; dm:assesses :Asset_TrainingLaptops ;
    dm:payee :SupplyVendor ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    dm:assetAlsoUsedBy dm:NoOneElse ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P28 The printer gave 6,000 of 484,000 (1.2 percent): over 5,000 but under 2 percent.
:P28_PrintingFromSmallDonor a dm:SpendProposal ; dm:assesses :Asset_TrainingLaptops ;
    dm:payee :PrinterVendor ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    dm:assetAlsoUsedBy dm:NoOneElse ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# P29 The early donor gave 8,000 in the foundation's first year, all it received
# that year. Later gifts bring its share under 2 percent, but the status stays.
:P29_SuppliesFromEarlyDonor a dm:SpendProposal ; dm:assesses :Asset_TrainingLaptops ;
    dm:payee :EarlyDonor ; dm:dqScreened true ; dm:spendKind dm:Purchase ;
    dm:assetAlsoUsedBy dm:NoOneElse ;
    # Stated for the fail-closed check (FC0): assumed, consistent with the scenario.
    dm:scorerVerdict dm:IntentClean .

# ---------------------------------------------------------------------
# P1 probe: a check enforced only by conscience
# ---------------------------------------------------------------------
:Probe_HonorCheck a dm:DecisionCheck ;
    dm:inStage dm:Stage3_Hack ; dm:onFail dm:NeedsCounsel ;
    dm:enforcedBy dm:MoralPressure ;
    dm:authority "The founder attests the spend serves the mission." .

# ---------------------------------------------------------------------
# Declared for the known-term check (FC0): every party and fiscal year a case
# names. A name not declared here, or misspelled, makes the case Insufficient.
# ---------------------------------------------------------------------
td:Grantee_CommunityCollege a dm:Party .
:AITrainer a dm:Party .
:AdvocacyFirm a dm:Party .
:BusinessTrust a dm:Party .
:Contractor a dm:Party .
:EventCharity a dm:Party .
:FamilyTrust a dm:Party .
:FounderSibling a dm:Party .
:FriendsNonprofit a dm:Party .
:IndexFund a dm:Party .
:ManagementCompany a dm:Party .
:OperatingCompany a dm:Party .
:ResidentCoop a dm:Party .
:SocialEnterpriseLLC a dm:Party .
:StudentApplicant a dm:Party .
:ThirdPartySeller a dm:Party .
:VanDealer a dm:Party .
:FY2027 a dm:FiscalYear .
:FY2028 a dm:FiscalYear .
