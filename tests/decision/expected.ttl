:P18b_ContractorSteward  t:expectOutcome dm:NeedsCounsel ; t:expectChecks "H4" .
:P19_Unscreened          t:expectOutcome dm:Insufficient ; t:expectChecks "E1" .
:P20_ResortSeries        t:expectOutcome dm:NeedsCounsel ; t:expectChecks "J1" .
:P21_ResortSeriesUnclear t:expectOutcome dm:Insufficient ; t:expectChecks "J2" .
:P22_RentFromFamilyTrust t:expectOutcome dm:Block ;        t:expectChecks "R1" .
