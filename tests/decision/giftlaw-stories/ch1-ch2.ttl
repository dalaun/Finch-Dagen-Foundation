@prefix : <http://example.org/trust-domain/giftlaw-stories#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GiftLaw Pro chapters 1 (Taxation and Giving, S1-1 to S1-79) and 2 (Major-Current
# Gifts, S2-1 to S2-15) as graded story cases. Source: the shelf extracts of the
# chapter notes. GiftLaw is a secondary source; each pageOutcome is what the page
# says, not the law. Roles only (roles.ttl); dollar figures left out; rulings and
# cases are named only in dm:citesAuthority. Not legal or tax advice.

:S1_1 a dm:StoryCase ;
    dm:storyId "S1-1" ;
    dm:storySection "1.1.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A gift conditioned on an event whose failure is so unlikely as to be negligible stays deductible; other contingent gifts are not deductible." ;
    dm:citesAuthority "Reg. 1.170A-1(e)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "contingent outright gift" .

:S1_2 a dm:StoryCase ;
    dm:storyId "S1-2" ;
    dm:storySection "1.1.1" ;
    dm:storyKind "court case" ;
    dm:pageSays "Tuition paid for one's own child buys a personal benefit and is not a deductible gift; the IRS has pressed civil and even criminal positions." ;
    dm:citesAuthority "Sklar (T.C. 2000; CA9 2002 and 2008)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "payment that buys a personal benefit" .

:S1_3 a dm:StoryCase ;
    dm:storyId "S1-3" ;
    dm:storySection "1.1.1" ;
    dm:storyKind "court case" ;
    dm:pageSays "Fixed fees paid to a church for religious sessions are payments for services, not deductible gifts." ;
    dm:citesAuthority "Hernandez (Scientology auditing fees)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "quid pro quo payment for services" .

:S1_4 a dm:StoryCase ;
    dm:storyId "S1-4" ;
    dm:storySection "1.1.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A payment above the value of seats received is deductible only for the excess, and a payment over the threshold needs the charity's disclosure." ;
    dm:citesAuthority "Sec. 6115" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "quid pro quo deduction and disclosure" .

:S1_5 a dm:StoryCase ;
    dm:storyId "S1-5" ;
    dm:storySection "1.1.2" ;
    dm:storyKind "court case" ;
    dm:pageSays "A donor's own note is deductible only when paid; a third party's note is deductible when given, and giving it accelerates deferred installment gain." ;
    dm:citesAuthority "Petty; Woodward; Sec. 453B" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "timing of a deduction for a note" .

:S1_6 a dm:StoryCase ;
    dm:storyId "S1-6" ;
    dm:storySection "1.1.2" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Stock options given to charity are deductible when the charity exercises them, for their value less the exercise price." ;
    dm:citesAuthority "PLR 200141018; PLR 200202034; Rev. Rul. 82-197" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "timing of a deduction for options" .

:S1_7 a dm:StoryCase ;
    dm:storyId "S1-7" ;
    dm:storySection "1.1.2" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Trusts that missed the deadline for a charitable deduction election were granted extensions." ;
    dm:citesAuthority "PLR 200444003; PLR 201202019" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ;
    dm:outsideReason "late election relief for a trust" .

:S1_8 a dm:StoryCase ;
    dm:storyId "S1-8" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Under the new floor, the first half percent of AGI given is not deductible, and the floored part carries forward only with an existing carryforward." ;
    dm:citesAuthority "OBBBA (from 2026)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "itemizer floor" .

:S1_9 a dm:StoryCase ;
    dm:storyId "S1-9" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "In the top bracket, itemized deductions are cut by two thirty-sevenths of the lesser of the deductions or the income above the threshold." ;
    dm:citesAuthority "OBBBA" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "top-bracket cap on itemized deductions" .

:S1_10 a dm:StoryCase ;
    dm:storyId "S1-10" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Cash gifts are deductible up to 60 percent of AGI after the floor; the excess, floored part included, carries forward only when a carryforward exists." ;
    dm:citesAuthority "Reg. 1.170A-10(b); OBBBA" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "60 percent limit and carryforward" .

:S1_11 a dm:StoryCase ;
    dm:storyId "S1-11" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Electing to deduct basis lets the donor use the 50 percent limit and deduct the whole basis now, instead of value spread under the 30 percent limit." ;
    dm:citesAuthority "170(b)(1)(C)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "basis election and percentage limits" .

:S1_12 a dm:StoryCase ;
    dm:storyId "S1-12" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Books given to an art museum that sells them within three years are an unrelated use, so the deduction is limited to basis." ;
    dm:citesAuthority "Reg. 1.170A-4(b); 170(e)(1)(B)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "related-use rule for tangible property" .

:S1_13 a dm:StoryCase ;
    dm:storyId "S1-13" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "The page deducts part of a rancher's easement this year and carries the rest, but its arithmetic overstates the room left after the cash gift." ;
    dm:citesAuthority "170(b)(1)(E)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "conservation easement limits" ;
    dm:pageAccuracyNote "The notes say the page's arithmetic is wrong: after the cash gift only 40 percent of the base remains, as the later example (S1-24) gets right." .

:S1_14 a dm:StoryCase ;
    dm:storyId "S1-14" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Mixed gifts are deducted in a fixed order: cash to public charities, basis gifts, appreciated property, then cash and property to private foundations, then carryforwards." ;
    dm:citesAuthority "170(b)(1)(D)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "ordering of percentage limits" .

:S1_15 a dm:StoryCase ;
    dm:storyId "S1-15" ;
    dm:storySection "1.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "A C corporation's gift is reduced first by the 1 percent floor and then capped at 10 percent of taxable income, with a five-year carryforward." ;
    dm:citesAuthority "170(b)(2); OBBBA" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "corporate giving limits" .

:S1_16 a dm:StoryCase ;
    dm:storyId "S1-16" ;
    dm:storySection "1.1.4" ;
    dm:storyKind "example" ;
    dm:pageSays "A company's gift of a depreciated airplane used for the museum's exempt purpose is deductible at value less the gain that would be ordinary recapture." ;
    dm:citesAuthority "170(e)(1)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "ordinary income property reduction" .

:S1_17 a dm:StoryCase ;
    dm:storyId "S1-17" ;
    dm:storySection "1.1.4" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Thinly traded stock quoted daily on an established market was qualified appreciated stock, deductible at fair value when given to a private foundation, up to 10 percent of the company." ;
    dm:citesAuthority "PLR 200702031; 170(e)(1)(B)(ii); 170(e)(5)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S1_17_gift ;
    dm:gapNote "No check has the 170(e)(5) rule that limits a gift of appreciated property to a private foundation to basis unless it is qualified appreciated stock within the 10 percent cap." .
:S1_17_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    dm:acquiredByGiftOrBequest true .

:S1_18 a dm:StoryCase ;
    dm:storyId "S1-18" ;
    dm:storySection "1.1.4" ;
    dm:storyKind "example" ;
    dm:pageSays "A building with accelerated depreciation is deductible at value less potential recapture, outright or, through a remainder trust, multiplied by the remainder factor." ;
    dm:citesAuthority "1245; 1250" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S1_18_gift ;
    dm:gapNote "No check computes the deduction reduction for depreciation recapture (170(e)(1), 1245, 1250) on property that funds a remainder trust." .
:S1_18_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ;
    dm:deductionFor dm:RemainderInterest ;
    # assumed: the page gives no payout rate; a lawful 5 percent rate is used
    dm:unitrustPercent "5"^^xsd:decimal ;
    dm:remainderValuePercent "50"^^xsd:decimal .

:S1_19 a dm:StoryCase ;
    dm:storyId "S1-19" ;
    dm:storySection "1.1.4" ;
    dm:storyKind "other (technical advice memorandum)" ;
    dm:pageSays "The IRS cut the deduction for a donated film library to zero." ;
    dm:citesAuthority "TAM 200119005" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "ordinary income property valued at zero" .

:S1_20 a dm:StoryCase ;
    dm:storyId "S1-20" ;
    dm:storySection "1.1.4" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A gifted life insurance policy was deductible up to the premiums paid." ;
    dm:citesAuthority "PLR 200209020" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:LifeInsurance ;
    dm:outsideReason "gift of a life insurance policy" .

:S1_21 a dm:StoryCase ;
    dm:storyId "S1-21" ;
    dm:storySection "1.1.5" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Giving a home while keeping its use two summer months a year was deductible for ten-twelfths of its value as an undivided interest." ;
    dm:citesAuthority "PLR 9303007; Reg. 1.170A-7(b)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "partial interest in a home" .

:S1_22 a dm:StoryCase ;
    dm:storyId "S1-22" ;
    dm:storySection "1.1.5" ;
    dm:storyKind "example" ;
    dm:pageSays "An undivided interest in art shared between museum and donor is deductible; the museum should actually take and display the art." ;
    dm:citesAuthority "Reg. 1.170A-7(d); Winokur" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "fractional interest in art" .

:S1_23 a dm:StoryCase ;
    dm:storyId "S1-23" ;
    dm:storySection "1.1.5" ;
    dm:storyKind "example" ;
    dm:pageSays "Cash is deducted up to the limit with the excess carried five years; the whole easement carries fifteen years because the cash used the room." ;
    dm:citesAuthority "170(b)(1)(E)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "conservation easement limits" .

:S1_24 a dm:StoryCase ;
    dm:storyId "S1-24" ;
    dm:storySection "1.1.5" ;
    dm:storyKind "example" ;
    dm:pageSays "For a qualified rancher, cash and part of the easement are deducted this year and the rest carried; the notes confirm this arithmetic." ;
    dm:citesAuthority "170(b)(1)(E)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "conservation easement limits" .

:S1_25 a dm:StoryCase ;
    dm:storyId "S1-25" ;
    dm:storySection "1.1.6" ;
    dm:storyKind "example" ;
    dm:pageSays "A state credit capped at a fixed amount is fully available when the gift is large enough to reach the cap." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:StateLaw ;
    dm:outsideReason "state tax credit" .

:S1_26 a dm:StoryCase ;
    dm:storyId "S1-26" ;
    dm:storySection "1.1.6" ;
    dm:storyKind "example" ;
    dm:pageSays "A 50 percent state conservation credit wipes out the year's state tax, and the unused credit carries forward up to twenty years." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:StateLaw ;
    dm:outsideReason "state conservation credit" .

:S1_27 a dm:StoryCase ;
    dm:storyId "S1-27" ;
    dm:storySection "1.1.6" ;
    dm:storyKind "example" ;
    dm:pageSays "A 40 percent state credit on a remainder trust's gift portion cuts state tax, and the federal deduction falls by the amount of the credit." ;
    dm:citesAuthority "REG-112176-18; Reg. 1.170A-1(h)(3)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S1_27_gift ;
    dm:gapNote "No check has the rule that a state credit above 15 percent of the gift reduces the federal deduction (1.170A-1(h)(3)); the plan still works." .
:S1_27_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ;
    dm:deductionFor dm:RemainderInterest ;
    # assumed: the notes give neither the trust type nor its rate; a unitrust at a lawful 5 percent is used, as the extract classifies it
    dm:unitrustPercent "5"^^xsd:decimal ;
    dm:remainderValuePercent "20"^^xsd:decimal .

:S1_28 a dm:StoryCase ;
    dm:storyId "S1-28" ;
    dm:storySection "1.2.1" ;
    dm:storyKind "other (technical advice memorandum)" ;
    dm:pageSays "Bonds placed in a limited partnership before gifts of partnership interests were an indirect gift of the bonds, with no valuation discount." ;
    dm:citesAuthority "TAM 200212006" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "family partnership valuation discount" .

:S1_29 a dm:StoryCase ;
    dm:storyId "S1-29" ;
    dm:storySection "1.2.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A gift to a foreign private foundation was deductible for gift tax." ;
    dm:citesAuthority "PLR 200226012" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "gift tax deduction for a foreign foundation" .

:S1_30 a dm:StoryCase ;
    dm:storyId "S1-30" ;
    dm:storySection "1.2.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A parent's gift to the children of a remainder interest in the parent's home was an incomplete gift." ;
    dm:citesAuthority "PLR 200308046" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "remainder interest in a home with a retained life estate" .

:S1_31 a dm:StoryCase ;
    dm:storyId "S1-31" ;
    dm:storySection "1.2.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Creating the trust and exercising the power of appointment made no taxable gift." ;
    dm:citesAuthority "PLR 200637025; PLR 200647001" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "incomplete gifts" .

:S1_32 a dm:StoryCase ;
    dm:storyId "S1-32" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A current income interest in a net-income remainder unitrust, given to another person, qualifies for the gift tax annual exclusion at its present value." ;
    dm:citesAuthority "PLR 8637084; Reg. 25.2503-3" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S1_32_gift ;
    dm:gapNote "No check has the gift tax annual exclusion for a present income interest in a remainder unitrust (25.2503-3)." .
:S1_32_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ;
    dm:deductionFor dm:RemainderInterest ;
    # assumed: the notes give no payout rate; a lawful 5 percent rate is used
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: the notes give no remainder value; one above the 10 percent floor is used
    dm:remainderValuePercent "40"^^xsd:decimal .

:S1_33 a dm:StoryCase ;
    dm:storyId "S1-33" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "other (technical advice memorandum)" ;
    dm:pageSays "Interests in a partnership that distributes all current income were present interests that qualify for the annual exclusion." ;
    dm:citesAuthority "TAM 199944003" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "annual exclusion for partnership interests" .

:S1_34 a dm:StoryCase ;
    dm:storyId "S1-34" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "court case" ;
    dm:pageSays "Withdrawal powers held by contingent beneficiaries count for the annual exclusion, but a person with no interest at all cannot hold one." ;
    dm:citesAuthority "Cristofani; Rev. Rul. 80-261" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "annual exclusion and withdrawal powers" .

:S1_35 a dm:StoryCase ;
    dm:storyId "S1-35" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "example" ;
    dm:pageSays "An elderly couple's gift annuity for a niece is presented as an annual-exclusion gift; the notes give only the title." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ;
    dm:outsideReason "gift annuity for a relative" .

:S1_36 a dm:StoryCase ;
    dm:storyId "S1-36" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "The state college savings plan qualified under section 529." ;
    dm:citesAuthority "PLR 200123065" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ;
    dm:outsideReason "college savings plan" .

:S1_37 a dm:StoryCase ;
    dm:storyId "S1-37" ;
    dm:storySection "1.2.2" ;
    dm:storyKind "court case" ;
    dm:pageSays "Interests in a family LLC or partnership may not be present interests, so they may get no annual exclusion." ;
    dm:citesAuthority "Hackl" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "annual exclusion for entity interests" .

:S1_38 a dm:StoryCase ;
    dm:storyId "S1-38" ;
    dm:storySection "1.2.3" ;
    dm:storyKind "example" ;
    dm:pageSays "A split stock gift to three children owes no gift tax but uses exemption; the page miscomputes each spouse's taxable gift." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "gift splitting and exemption" ;
    dm:pageAccuracyNote "The notes say the page halves the gift wrongly: each spouse's share is half the total, so the taxable gift per spouse is lower than the page states." .

:S1_39 a dm:StoryCase ;
    dm:storyId "S1-39" ;
    dm:storySection "1.2.3" ;
    dm:storyKind "court case" ;
    dm:pageSays "Liquid assets put into a family partnership with no business plan, whose distributions went mostly to the decedent, were not a bona fide sale and stayed in the estate." ;
    dm:citesAuthority "Rector (T.C. 2007); 2036(a)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "2036 inclusion of partnership assets" .

:S1_40 a dm:StoryCase ;
    dm:storyId "S1-40" ;
    dm:storySection "1.2.3" ;
    dm:storyKind "court case" ;
    dm:pageSays "Partnership interests given at a discount were pulled back into the parents' estates because an implied agreement kept their lifetime access." ;
    dm:citesAuthority "Korby (8th Cir. 2006); 2036(a)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "2036 inclusion of partnership assets" .

:S1_41 a dm:StoryCase ;
    dm:storyId "S1-41" ;
    dm:storySection "1.2.3" ;
    dm:storyKind "court case" ;
    dm:pageSays "Stock contributed to a partnership at or after the gifts of interests was an indirect gift at full value under the step-transaction doctrine." ;
    dm:citesAuthority "Senda (8th Cir. 2006)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "step transaction and discounts" .

:S1_42 a dm:StoryCase ;
    dm:storyId "S1-42" ;
    dm:storySection "1.2.6" ;
    dm:storyKind "example" ;
    dm:pageSays "Cumulative taxable gifts after the charitable deduction give a tentative tax below the credit, so no gift tax is due." ;
    dm:citesAuthority "1015(d); 6651(a)(2); Reg. 25.2504-2" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "cumulative gift tax" ;
    dm:pageAccuracyNote "The notes say the narrative's figure for the current gifts does not match the page's own worksheet." .

:S1_43 a dm:StoryCase ;
    dm:storyId "S1-43" ;
    dm:storySection "1.2.6" ;
    dm:storyKind "other (IRS legal memorandum, ILM)" ;
    dm:pageSays "A gift reported without adequate disclosure never started the limitations period, so the IRS revalued it far higher years later." ;
    dm:citesAuthority "ILM 200221010; Reg. 25.2504-2" ;
    dm:pageOutcome dm:Insufficient ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:SubstantiationAndAppraisal ;
    dm:outsideReason "adequate disclosure on the gift tax return" .

:S1_44 a dm:StoryCase ;
    dm:storyId "S1-44" ;
    dm:storySection "1.3.1" ;
    dm:storyKind "other (technical advice memorandum)" ;
    dm:pageSays "An estate got no valuation discount for the IRAs it held." ;
    dm:citesAuthority "TAM 200247001" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
