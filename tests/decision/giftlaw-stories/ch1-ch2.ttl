    dm:storyKind "example" ;
    dm:pageSays "A mortgaged duplex given to charity is half gift, half sale; the donor nets a benefit after the gain, and the charity sells it free of UBIT." ;
    dm:citesAuthority "514(c)(2)(B), 514(b)(1) (acquisition indebtedness); Reg. 1.1011-2(a)(3)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S2_7_gift ;
    dm:gapNote "No check has the debt-financed property rules (514(c)(2)(B), the 5-and-5 test) that decide whether the charity owes unrelated business tax on mortgaged property." ;
    dm:pageAccuracyNote "The notes say the page's flat capital-gains rate ignores unrecaptured 1250 gain taxed up to 25 percent, so its tax figure is slightly low." .
:S2_7_gift a dm:PlannedGift ;
    dm:giftVehicle dm:BargainSaleVehicle ;
    dm:seller td:Founder ;
    dm:buyer :PublicCharity ;
    dm:basisAllocated true .

:S2_8 a dm:StoryCase ;
    dm:storyId "S2-8" ;
    dm:storySection "2.2.1" ;
    dm:storyKind "court case" ;
    dm:pageSays "Deeding property while buyers are only interested is fine, but a prearranged binding sale taxes the gift part's gain to the donor." ;
    dm:citesAuthority "Ferguson" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "gift of property before a sale" .

:S2_9 a dm:StoryCase ;
    dm:storyId "S2-9" ;
    dm:storySection "2.2.1" ;
    dm:storyKind "example" ;
    dm:pageSays "Deeding part of a land tract to a public charity before a joint sale gives a deduction for that part and gain on the donor's share." ;
    dm:citesAuthority "Reg. 1.1011-2(a); 170(e)(1); Rev. Rul. 87-37 (minority discount on undivided interests)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "partial gift before a joint sale" ;
    dm:pageAccuracyNote "The notes say the page never shows whether the donor's stated tax-cut goal was met." .

:S2_10 a dm:StoryCase ;
    dm:storyId "S2-10" ;
    dm:storySection "2.2.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A large bequest to a public charity was treated as an unusual grant." ;
    dm:citesAuthority "PLR 201342011" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ;
    dm:outsideReason "public support test" .

