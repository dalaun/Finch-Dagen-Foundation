:S4_30 a dm:StoryCase ;
    dm:storyId "S4-30" ;
    dm:storySection "4.3.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A seven-month yearly share of the music boxes is deductible if the museum actually takes possession." ;
    dm:citesAuthority "PLR 9303007; Winokur, 90 T.C. 733 (1988)" ;
