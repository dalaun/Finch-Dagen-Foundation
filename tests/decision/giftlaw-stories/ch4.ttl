:S4_66 a dm:StoryCase ;
    dm:storyId "S4-66" ;
    dm:storySection "4.6.4" ;
    dm:storyKind "example" ;
    dm:pageSays "An IRA to a unitrust paying the spouse for life, then the children for 20 years, is the page's lowest-tax design." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_66_gift ;
    dm:pageAccuracyNote "The notes warn the design may fail the 10 percent remainder test for a younger spouse." ;
    dm:authorityOutcome dm:Block ;
    dm:authorityBasis "26 CFR 1.664-3(a)(5)(i), read 2026-11-21: a unitrust may not pay 'to A for his life and then to B for a term of years'; it may pay A for life, then B for life or a term of up to 20 years, whichever is shorter. The page's design does not qualify, so there is no remainder deduction." ;
    dm:authorityRead true .
:S4_66_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout; the page does not give the rate
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "10"^^xsd:decimal ;
    # regraded on primary law: the spouse for life, then the children for a term of years
    dm:unitrustPeriodForm dm:LifeThenTerm .

