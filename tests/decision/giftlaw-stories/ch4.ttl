:S4_127 a dm:StoryCase ;
    dm:storyId "S4-127" ;
    dm:storySection "4.12.2" ;
    dm:storyKind "example" ;
    dm:pageSays "Giving 10 percent of company stock under only a non-binding letter of intent bypasses gain on it and gives a full deduction." ;
