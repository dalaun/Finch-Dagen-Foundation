    dm:storySection "4.3.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "The page says legal-tender bullion coins can be given like cash." ;
    dm:citesAuthority "PLR 9225036; Rev. Rul. 69-63" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
