:S4_129 a dm:StoryCase ;
    dm:storyId "S4-129" ;
    dm:storySection "4.12.2" ;
    dm:storyKind "example" ;
    dm:pageSays "A unitrust bailout: the independent trustee sells the trust's shares to the family corporation after a few weeks, with a deduction and income for the couple." ;
    dm:citesAuthority "none on this page (notes add 4941(d)(2)(F), 318, 302(b))" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_129_gift ;
    dm:pageAccuracyNote "The notes say the page omits that the family corporation is a disqualified person, so the redemption is self-dealing unless 4941(d)(2)(F) is met." ;
    dm:authorityOutcome dm:Block ;
    dm:authorityBasis "26 USC 4941(d)(2)(F) and 4947(a)(2), read: a redemption by a family corporation that is a disqualified person is self-dealing for a remainder trust unless every holder of the class gets the same offer and the trust gets at least fair market value. The page states neither." ;
    dm:authorityRead true .
:S4_129_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
