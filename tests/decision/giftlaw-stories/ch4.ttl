:S4_112 a dm:StoryCase ;
    dm:storyId "S4-112" ;
    dm:storySection "4.10.2" ;
    dm:storyKind "example" ;
    dm:pageSays "A business leased to an unrelated key employee, deeded to a unitrust and sold two weeks later, gives fixed rent and near-zero excise tax." ;
    dm:citesAuthority "513(a); 664(c)(2)(A); 512(c) (flagged; should be 512(b)(3)); 501(a) and 508(e) (flagged; should be 664(c)); 4947(b)(3)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_112_gift ;
    dm:gapNote "Covered since the audit pass by PG13 (personal-property rent) and PG12 (a sale fixed before the gift)." ;
    dm:pageAccuracyNote "The page wrongly says the excess business holdings and jeopardy rules apply to remainder trusts; under 4947(b)(3)(B) they generally do not, and two of its citations are wrong." ;
    dm:authorityOutcome dm:NeedsCounsel ;
    dm:authorityBasis "26 USC 512(b)(3) and 26 CFR 1.512(b)-1(c)(2), read 2026-11-21: rent for equipment and goodwill is excluded only if incidental (generally 10 percent or less) to a real property lease; otherwise it is unrelated business taxable income, which 664(c)(2)(A), read, takes in full as excise tax. The lined-up buyer adds a prearranged-sale question (PG12; Ferguson read, Hoensheid read in part)." ;
    dm:authorityRead true .
:S4_112_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout; the page does not give the rate
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal ;
    # regraded on primary law: the lease covers plant, equipment and goodwill; the page gives no
    # split of the rent between the land and building and the rest, so PG13 fails closed
    dm:vehicleAct dm:LeaseAct ; dm:lessee :KeyEmployee ; dm:counterparty :KeyEmployee ;
    dm:rentDependsOnProfits false ;
    # from the page as the audit reads it (F169): the buyer was lined up before the deed
    dm:saleArrangedBeforeGift true .

