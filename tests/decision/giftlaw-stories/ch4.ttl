:S4_56 a dm:StoryCase ;
    dm:storyId "S4-56" ;
    dm:storySection "4.5.5" ;
    dm:storyKind "example" ;
    dm:pageSays "A subdivider's lots in a 5 percent remainder trust earn only a dealer's smaller deduction, but the trust's sale is not the donor's income." ;
    dm:citesAuthority "none" ;
