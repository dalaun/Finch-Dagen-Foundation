@prefix : <http://example.org/trust-domain/giftlaw-stories#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GiftLaw Pro chapter 4 (specific property gifts): 151 stories, S4-1 to S4-151,
# from the shelf extract of the operator's notes on the pages. Each story is a
# dm:StoryCase; a story whose vehicle the planned-giving checks model carries a
# dm:PlannedGift. The page's outcome is what the page says, not the law. Roles
# only; percentages only; no dollar figures in the RDF. Not legal or tax advice.

# Story-local roles (not disqualified persons).
:S4_19_company rdfs:label "A timber company owned in thirds by the donor and two siblings; the donor's share is under 35 percent and siblings are not disqualified persons" .
:S4_146_lessee rdfs:label "A lessee unrelated to the donor and the S corporation" .

:S4_1 a dm:StoryCase ;
    dm:storyId "S4-1" ;
    dm:storySection "4.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A bequest of paintings with display duties was not materially restricted, so the estate tax charitable deduction was allowed." ;
    dm:citesAuthority "PLR 200202032" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "restricted bequest of art to a museum" .

:S4_2 a dm:StoryCase ;
    dm:storyId "S4-2" ;
    dm:storySection "4.1.1" ;
    dm:storyKind "revenue ruling" ;
    dm:pageSays "Art books bought in bulk and given after just over a year were dealer inventory, so the deduction was limited to cost." ;
    dm:citesAuthority "Rev. Rul. 79-419" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "dealer versus investor deduction limit" .

:S4_3 a dm:StoryCase ;
    dm:storyId "S4-3" ;
    dm:storySection "4.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Conditions on a bequeathed art collection did not defeat the gift; the full fair market value deduction stood." ;
    dm:citesAuthority "PLR 200418002" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "conditional bequest of art" .

:S4_4 a dm:StoryCase ;
    dm:storyId "S4-4" ;
    dm:storySection "4.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A deed of transfer to museums made the art gift complete." ;
    dm:citesAuthority "PLR 201825003" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "completed gift of art" .

:S4_5 a dm:StoryCase ;
    dm:storyId "S4-5" ;
    dm:storySection "4.1.2" ;
    dm:storyKind "case" ;
    dm:pageSays "Staged fractional gifts of artworks were each deductible as undivided interests." ;
    dm:citesAuthority "Winokur, 90 T.C. 733; Reg. 1.170A-7(b)(1); 170(o)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "fractional interest in art (170(o))" ;
    dm:pageAccuracyNote "The page dates the case 1998 rather than 1988, and does not reflect 170(o)'s 10-year completion, lesser-value and recapture rules." .

:S4_6 a dm:StoryCase ;
    dm:storyId "S4-6" ;
    dm:storySection "4.1.2" ;
    dm:storyKind "example" ;
    dm:pageSays "Lending art to a museum without transferring ownership gives no deduction." ;
    dm:citesAuthority "170(a)(3); Reg. 1.170A-5(a)(1)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "partial interest: a loan of art" .

:S4_7 a dm:StoryCase ;
    dm:storyId "S4-7" ;
    dm:storySection "4.1.2" ;
    dm:storyKind "example" ;
    dm:pageSays "A half undivided interest in a painting is deductible at half its value, likely without a minority discount." ;
    dm:citesAuthority "Reg. 1.170A-7(b)(1)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "fractional interest in art" .

:S4_8 a dm:StoryCase ;
    dm:storyId "S4-8" ;
    dm:storySection "4.1.2" ;
    dm:storyKind "example" ;
    dm:pageSays "Giving a museum seven months of each year's ownership yields a seven-twelfths deduction if the museum actually takes possession." ;
    dm:citesAuthority "Reg. 1.170A-7(b)(1)(i); PLR 9218067" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "time-division interest in art" .

:S4_9 a dm:StoryCase ;
    dm:storyId "S4-9" ;
    dm:storySection "4.1.2" ;
    dm:storyKind "example" ;
    dm:pageSays "A painting deeded in full but kept at home is deductible if the museum could take it anytime and chose to wait." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "completed gift with delayed delivery" ;
    dm:pageAccuracyNote "The notes say this reading sits uneasily with the substantial physical possession idea in 170(o)." .

:S4_10 a dm:StoryCase ;
    dm:storyId "S4-10" ;
    dm:storySection "4.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Furniture given for an unrelated use is deductible only at the lesser of basis or value." ;
    dm:citesAuthority "170(e)(1)(B)(i)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "related-use limit on tangible property" .

:S4_11 a dm:StoryCase ;
    dm:storyId "S4-11" ;
    dm:storySection "4.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "A painting displayed by an art institute is deductible at full value under the 30 percent limit, with the appraisal attached to Form 8283." ;
    dm:citesAuthority "170(e)(1)(B)(i); Reg. 1.170A-4(b)(3)(i)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "related-use tangible property deduction" .

:S4_12 a dm:StoryCase ;
    dm:storyId "S4-12" ;
    dm:storySection "4.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "A painting given to a food bank that sells it is deductible only at basis, and a quick resale of related-use property triggers recapture." ;
    dm:citesAuthority "170(e)(1)(B)(i); 170(e)(7)(D); 6720B" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "unrelated-use limit and recapture" .

:S4_13 a dm:StoryCase ;
    dm:storyId "S4-13" ;
    dm:storySection "4.1.4" ;
    dm:storyKind "example" ;
    dm:pageSays "A remainder unitrust funded with porcelain sold in three lots has a separate funding date, 7520 rate and basis-based deduction for each sale." ;
    dm:citesAuthority "170(a)(3); Reg. 1.170A-5(a)(1); Reg. 1.170A-5(b)(7); 7520(a)(2)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_13_gift ;
    dm:gapNote "No check models the 170(a)(3) future-interest rule that delays the deduction for tangible personal property until the trust sells it." .
:S4_13_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout; the page does not give the rate
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal .

:S4_14 a dm:StoryCase ;
    dm:storyId "S4-14" ;
    dm:storySection "4.1.4" ;
    dm:storyKind "example" ;
    dm:pageSays "An artist's own painting in a two-life 5 percent unitrust gets no deduction, though the page claims a large tax saving." ;
    dm:citesAuthority "170(e)(3) (cited by the page; flagged as wrong)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_14_gift ;
    dm:pageAccuracyNote "The notes say the tax is only deferred because payouts are tier-1 ordinary income, and the page's 170(e)(3) citation is wrong." .
:S4_14_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal .

:S4_15 a dm:StoryCase ;
    dm:storyId "S4-15" ;
    dm:storySection "4.1.4" ;
    dm:storyKind "example" ;
    dm:pageSays "A painting in a FLIP unitrust earns a deduction in the year of sale; the donor must not keep use or restrict the sale, or the trust fails." ;
    dm:citesAuthority "Reg. 1.170A-5(b)(7); Rev. Rul. 73-610" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_15_gift ;
    dm:gapNote "No check tests that the donor keeps no use of contributed art or control over its sale, which the page says would disqualify the trust." .
:S4_15_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal ;
    # assumed: the donor keeps no use of the art and puts no restriction on its sale
    dm:producesUBTI false .

:S4_16 a dm:StoryCase ;
    dm:storyId "S4-16" ;
    dm:storySection "4.2.1" ;
    dm:storyKind "example" ;
    dm:pageSays "Land contributed to a C corporation goes in tax-free with carryover basis, but its later sale is taxed twice, possibly over 50 percent combined." ;
    dm:citesAuthority "351(a); 358(a)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ;
    dm:outsideReason "C corporation formation and double tax" .

:S4_17 a dm:StoryCase ;
    dm:storyId "S4-17" ;
    dm:storySection "4.2.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A gift of company stock later redeemed reduces excess retained earnings enough to avoid the accumulated earnings tax." ;
    dm:citesAuthority "537(a); 302(b)(3)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "gift and redemption to avoid accumulated earnings tax" ;
    dm:pageAccuracyNote "The notes say the page's 15 percent accumulated earnings tax rate is outdated; it is 20 percent." .

:S4_18 a dm:StoryCase ;
    dm:storyId "S4-18" ;
    dm:storySection "4.2.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A corporation's gift is deductible only above the new 1 percent of taxable income floor, within the 10 percent cap." ;
    dm:citesAuthority "170(b)(2); OBBBA" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ;
    dm:outsideReason "corporate deduction floor and cap" .

:S4_19 a dm:StoryCase ;
    dm:storyId "S4-19" ;
    dm:storySection "4.2.2" ;
    dm:storyKind "example" ;
    dm:pageSays "A sibling's two-life unitrust sells the sibling's timber company shares back to the company, avoiding shareholder gain with a sizable deduction." ;
    dm:citesAuthority "none (page relies on 4.2.3 rules)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_19_gift ;
    dm:gapNote "No check tests prearranged sales, and the grade rests on siblings not being disqualified persons, so a company the donor owns a third of is not one either." ;
    dm:pageAccuracyNote "The notes say the page ignores prearrangement risk and never analyzes self-dealing in the redemption." ;
    dm:authorityOutcome dm:Allow ;
    dm:authorityBasis "26 USC 4946(a)(1)(E) and (d), read 2026-11-21: brothers and sisters are not family, and a company is disqualified only when disqualified persons own more than 35 percent of its vote. The donor's third does not reach that, so the redemption is not self-dealing. The prearranged-sale question is separate (PG12)." ;
    dm:authorityRead true .
:S4_19_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout; the page does not give the rate
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal ;
    dm:counterparty :S4_19_company ; dm:vehicleAct dm:RedemptionAct .

:S4_20 a dm:StoryCase ;
    dm:storyId "S4-20" ;
    dm:storySection "4.2.3" ;
    dm:storyKind "case" ;
    dm:pageSays "Shares given after a tender offer had effectively succeeded carried ripened gain, so the gain was taxed to the donors." ;
    dm:citesAuthority "Ferguson, 108 T.C. 244 (1997); Rev. Rul. 78-197" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "anticipatory assignment of income" ;
    dm:pageAccuracyNote "The notes say the page's 51 percent rule oversimplifies; the case turned on shares already tendered, not a vote." .

:S4_21 a dm:StoryCase ;
    dm:storyId "S4-21" ;
    dm:storySection "4.2.3" ;
    dm:storyKind "case" ;
    dm:pageSays "The page cites a 2023 Tax Court case as support for having the donor's advisor serve as trustee." ;
    dm:citesAuthority "Estate of Hoensheid (2023)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ;
    dm:outsideReason "prearranged sale and qualified appraisal" ;
    dm:pageAccuracyNote "The notes say the court actually ruled against the donor: the gain had ripened before the gift and the appraisal was not qualified." ;
    dm:citedForOpposite "Estate of Hoensheid, T.C. Memo. 2023-34, read in part 2026-11-21: the government won on assignment of income, because the donors' right to the sale proceeds was fixed by the day of the gift, so the gain was theirs. The appraisal holding (deduction denied for an unqualified appraisal) was read only in a secondary summary." ;
    dm:citedAuthorityRead true .

:S4_22 a dm:StoryCase ;
    dm:storyId "S4-22" ;
    dm:storySection "4.2.3" ;
    dm:storyKind "example" ;
    dm:pageSays "Founders' stock put in a two-life 5 percent unitrust before negotiations end avoids capital gain and yields a deduction; independent trustee advised." ;
    dm:citesAuthority "Rev. Rul. 78-197; Ferguson, 108 T.C. 244 (1997)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_22_gift ;
    dm:gapNote "No check tests a prearranged sale or anticipatory assignment of income, where a gift made after a sale is effectively agreed taxes the gain to the donor." .
:S4_22_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder share worked out from the page's deduction and funding figures
    dm:remainderValuePercent "31"^^xsd:decimal ;
    # assumed: no binding sale agreement existed at the gift, as the page advises
    dm:giftTrustee :IndependentTrustee .

:S4_23 a dm:StoryCase ;
    dm:storyId "S4-23" ;
    dm:storySection "4.2.4" ;
    dm:storyKind "example" ;
    dm:pageSays "A family company funds a 20-year 5 percent unitrust with surplus land for itself, avoiding gain at sale and taking a deduction." ;
    dm:citesAuthority "542(a)(1); 545(b)(2); Reg. 1.337(d)-4" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_23_gift ;
    dm:pageAccuracyNote "The notes say the gain is deferred rather than avoided, the 10 percent limit and 1 percent floor apply, and the page's personal holding company description is garbled." ;
    dm:authorityUnread "26 USC 541 and 545 not read. The flag is about the company's personal holding company tax, not the trust's validity, so the grade stands until 541 is read." .
:S4_23_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder share worked out from the page's deduction and funding figures
    dm:remainderValuePercent "22"^^xsd:decimal ;
    dm:counterparty :DonorCompany ; dm:vehicleAct dm:PayoutUnderTermsAct .

:S4_24 a dm:StoryCase ;
    dm:storyId "S4-24" ;
    dm:storySection "4.2.4" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A corporation's lease of property to a foundation produced no recognized gain." ;
    dm:citesAuthority "PLR 200909029" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ;
    dm:outsideReason "corporate gain on a transfer to an exempt entity" .

:S4_25 a dm:StoryCase ;
    dm:storyId "S4-25" ;
    dm:storySection "4.2.5" ;
    dm:storyKind "example" ;
    dm:pageSays "The family company's redemption of nonvoting stock from a two-life unitrust is not self-dealing: fair value, same terms to all holders, no binding prior agreement." ;
    dm:citesAuthority "4941(d)(1)(A); 4946; 4941(d)(2)(F); Rev. Rul. 78-197; 368(a)(1)(E)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_25_gift ;
    dm:gapNote "No check tests that no binding redemption agreement existed when the stock went into the trust." ;
    dm:pageAccuracyNote "The notes say the page's figures do not add up and its 30 to 40 percent partnership discounts are aggressive today." .
:S4_25_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal ;
    dm:counterparty :DonorCompany ; dm:vehicleAct dm:RedemptionAct ;
    dm:sameTermsAllHolders true ; dm:atLeastFairMarketValue true .

:S4_26 a dm:StoryCase ;
    dm:storyId "S4-26" ;
    dm:storySection "4.2.5" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A ruling approved the donor's own corporation redeeming stock the donor had put in a remainder unitrust." ;
    dm:citesAuthority "PLR 200230004" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S4_26_gift .
:S4_26_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout; the page does not give the rate
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder at least 10 percent; the page treats the trust as qualifying
    dm:remainderValuePercent "30"^^xsd:decimal ;
    dm:counterparty :DonorCompany ; dm:vehicleAct dm:RedemptionAct ;
    # assumed: the redemption was on the same terms for every holder of the class
    dm:sameTermsAllHolders true ;
    # assumed: the trust received at least fair market value
    dm:atLeastFairMarketValue true .

:S4_27 a dm:StoryCase ;
    dm:storyId "S4-27" ;
    dm:storySection "4.2.6" ;
    dm:storyKind "example" ;
    dm:pageSays "Founders trade their building for a gift annuity, and the charity's resale to the family company yields income, a tax-free transfer and double depreciation." ;
    dm:citesAuthority "514(c)(5) (cited for CGA rules)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ;
    dm:outsideReason "gift annuity bailout" ;
    dm:pageAccuracyNote "The notes say the page values the company inconsistently, omits bargain-sale gain, ignores prearrangement risk in the resale, and uses a dated rate." .

