    dm:remainderValuePercent "41"^^xsd:decimal ;
    dm:giftTrustee :IndependentTrustee ;
    dm:counterparty :DonorCompany ; dm:vehicleAct dm:RedemptionAct ;
    # regraded on primary law: the page states neither a same-terms offer to every holder of the
    # class nor fair market value, so the 4941(d)(2)(F) exception is not shown
    dm:sameTermsAllHolders false .

