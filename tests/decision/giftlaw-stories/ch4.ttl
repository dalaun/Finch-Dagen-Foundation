:S4_31 a dm:StoryCase ;
    dm:storyId "S4-31" ;
    dm:storySection "4.3.1" ;
    dm:storyKind "example" ;
    dm:pageSays "A reversion to heirs if the museum stops display does not defeat the deduction, because it is so remote as to be negligible." ;
