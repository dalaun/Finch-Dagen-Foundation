@prefix : <http://example.org/trust-domain/giftlaw-stories#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GiftLaw Pro chapter 9 (Tax References) as story cases. Chapter 9 is an index:
# each story rests on one index line (a citation and a one-line gist); the
# rulings and opinions themselves were not read. A line is graded only where it
# plainly maps onto a modeled vehicle and check; every fact the line does not
# give is marked "# assumed:". Roles only, from roles.ttl. Not legal or tax advice.

# S9-1 Reformation and Termination
:S9_1 a dm:StoryCase ;
    dm:storyId "S9-1" ; dm:storySection "9.3" ; dm:storyKind "IRS notice" ;
    dm:pageSays "Charities that serve as trustee of, or hold the remainder in, a remainder trust that sells assets must report certain such sales to the IRS." ;
    dm:citesAuthority "Notice 2008-99" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ; dm:outsideCategory dm:CharityOperations ;
    dm:outsideReason "charity reporting of CRT asset sales" .

# S9-2 Reformation and Termination
:S9_2 a dm:StoryCase ;
    dm:storyId "S9-2" ; dm:storySection "9.3" ; dm:storyKind "IRS notice" ;
    dm:pageSays "The IRS gave net-income unitrust trustees until mid-2000 to reform their trusts to add a flip to a standard payout." ;
    dm:citesAuthority "Notice 99-31" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ; dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "FLIP conversion deadline" .

# S9-3 Testamentary Unitrusts
:S9_3 a dm:StoryCase ;
    dm:storyId "S9-3" ; dm:storySection "9.3" ; dm:storyKind "revenue ruling" ;
    dm:pageSays "An estate funds a testamentary unitrust and owes federal and state estate taxes: the estate taxes may not be paid out of the charitable remainder trust." ;
    dm:citesAuthority "Rev. Rul. 82-128" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ; dm:outsideCategory dm:OtherOutside ;
    dm:outsideReason "estate tax apportionment to a remainder trust not checked" .

