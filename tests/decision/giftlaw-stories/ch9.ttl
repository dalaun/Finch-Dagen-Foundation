:S9_126_gift a dm:PlannedGift ;
    dm:giftVehicle dm:EstateAdministration ; dm:foundationHasExpectancy true ;
    # assumed: the estate sells to the donor's child; the line names neither the buyer nor the act
    dm:counterparty :DonorChild ; dm:vehicleAct dm:SaleOrExchangeAct ;
    # assumed: all five estate-exception facts hold, since the page says the exception applies
    dm:fiduciaryPowerOfSale true ; dm:probateCourtApproved true ; dm:beforeEstateTerminates true ;
    dm:atLeastFairMarketValue true ; dm:atLeastAsLiquid true .

