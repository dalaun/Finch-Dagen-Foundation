# S9-365 UNITRUSTS
:S9_365 a dm:StoryCase ;
    dm:storyId "S9-365" ; dm:storySection "9.9" ; dm:storyKind "case" ;
    dm:pageSays "An estate created two NIMCRUTs with high payout rates: they failed the 10% minimum remainder test; estate deduction denied." ;
    dm:citesAuthority "Schaefer v. Commissioner (2015)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_365_gift .
:S9_365_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    # the court denied the estate deduction (PG4 does not read this fact)
    dm:deductionAllowed false ; dm:deductionFor dm:RemainderInterest ;
    # the page says the remainder failed the 10 percent test; 9 stands for any figure below 10. The high payout rate is not given.
    dm:remainderValuePercent "9"^^xsd:decimal .

