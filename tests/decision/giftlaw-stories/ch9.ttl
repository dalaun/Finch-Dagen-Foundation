# S9-20 Unrelated Business Income Tax
:S9_20 a dm:StoryCase ;
    dm:storyId "S9-20" ; dm:storySection "9.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A CRUT sets up a for-profit corporation to hold an active business: the corporation shields the trust from unrelated business taxable income." ;
    dm:citesAuthority "PLR 200252096" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_20_gift .
:S9_20_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a 5 percent payout and a 40 percent remainder value; the line gives neither
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "40"^^xsd:decimal ;
    # the for-profit subsidiary holds the active business, so the trust itself has no unrelated business income
    dm:producesUBTI false .

