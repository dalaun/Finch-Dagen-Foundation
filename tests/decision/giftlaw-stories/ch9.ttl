# S9-45 Self-Dealing in Lead Annuity Trusts
:S9_45 a dm:StoryCase ;
    dm:storyId "S9-45" ; dm:storySection "9.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A CLAT sells assets on an installment basis to an LLC that is a disqualified person: not self-dealing." ;
    dm:citesAuthority "PLR 200124029" ;
    dm:pageOutcome dm:Allow ;
    dm:gapNote "No exception lets a lead trust sell to a disqualified LLC on installment terms; the ruling's ground (perhaps an estate administration exception for a testamentary trust) is not in the line." ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_45_gift .
:S9_45_gift a dm:PlannedGift ;
    # assumed: a non-grantor (family) lead trust; the line does not say which type
    dm:giftVehicle dm:FamilyLeadTrust ;
    dm:deductionAllowed true ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:GuaranteedAnnuity ;
    # assumed: an independent trustee; the line names none
    dm:giftTrustee :IndependentTrustee ;
    # assumed: an unrelated public charity takes the lead payments; the line names none
    dm:leadBeneficiary :PublicCharity ;
    dm:counterparty :DonorPartnership ; dm:vehicleAct dm:SaleOrExchangeAct ;
    # assumed: the installment price is at least fair market value
    dm:atLeastFairMarketValue true .

