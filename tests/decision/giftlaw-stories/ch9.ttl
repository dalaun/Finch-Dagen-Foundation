    dm:outsideReason "lead trust payments; counterparty and act not stated" .

# S9-42 Self-Dealing in Lead Annuity Trusts
:S9_42 a dm:StoryCase ;
    dm:storyId "S9-42" ; dm:storySection "9.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A lead trust sells a limited partnership interest: not self-dealing." ;
    dm:citesAuthority "PLR 201145026" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_42_gift .
:S9_42_gift a dm:PlannedGift ;
    # assumed: a non-grantor (family) lead trust; the line does not say which type
    dm:giftVehicle dm:FamilyLeadTrust ;
    dm:deductionAllowed true ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:GuaranteedAnnuity ;
    # assumed: an independent trustee; the line names none
    dm:giftTrustee :IndependentTrustee ;
    # assumed: an unrelated public charity takes the lead payments; the line names none
    dm:leadBeneficiary :PublicCharity ;
    # assumed: the buyer is unrelated and pays fair value; the line does not name the buyer
    dm:counterparty :UnrelatedBuyer ; dm:vehicleAct dm:SaleOrExchangeAct ; dm:atLeastFairMarketValue true .

