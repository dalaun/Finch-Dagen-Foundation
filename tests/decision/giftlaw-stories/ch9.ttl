    dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # the payout after the change is stated; assumed: a 40 percent remainder value
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "40"^^xsd:decimal .

