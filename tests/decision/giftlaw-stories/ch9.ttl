    dm:storyId "S9-50" ; dm:storySection "9.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "The donor of a lead unitrust keeps the power to change the charitable beneficiary: no CLUT deduction." ;
    dm:citesAuthority "PLR 200328030" ;
    dm:pageOutcome dm:Block ;
    dm:gapNote "No check for a donor's retained power to change the charitable lead beneficiary, which leaves the gift incomplete and loses the deduction." ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_50_gift .
:S9_50_gift a dm:PlannedGift ;
    # assumed: a non-grantor (family) lead trust; the line does not say which type
    dm:giftVehicle dm:FamilyLeadTrust ;
    # the ruling denies the deduction
    dm:deductionAllowed false ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:UnitrustInterest ;
    # assumed: an independent trustee; the donor's retained power is the issue, not the trusteeship
    dm:giftTrustee :IndependentTrustee ;
    # assumed: an unrelated public charity takes the lead payments
    dm:leadBeneficiary :PublicCharity .

