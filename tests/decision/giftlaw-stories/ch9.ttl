    dm:outsideReason "lead trust distributions; counterparty not stated" .

# S9-40 Self-Dealing in Lead Annuity Trusts
:S9_40 a dm:StoryCase ;
    dm:storyId "S9-40" ; dm:storySection "9.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "Nonvoting LLC interests are transferred to a CLAT: not self-dealing." ;
    dm:citesAuthority "PLR 201907004" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_40_gift .
:S9_40_gift a dm:PlannedGift ;
    # assumed: a non-grantor (family) lead trust; the line does not say which type
    dm:giftVehicle dm:FamilyLeadTrust ;
    dm:deductionAllowed true ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:GuaranteedAnnuity ;
    # assumed: an independent trustee; the line names none
    dm:giftTrustee :IndependentTrustee ;
    # assumed: an unrelated public charity takes the lead payments; the line names none
    dm:leadBeneficiary :PublicCharity ;
    # the nonvoting interests come in by gift, which is not a deal between the trust and a disqualified person, so no vehicleAct
    dm:holderVotingPercent "0"^^xsd:decimal .

