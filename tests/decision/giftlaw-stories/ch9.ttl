    dm:citesAuthority "Musgrave, et ux. v. Commissioner (2000)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_355_gift .
:S9_355_gift a dm:PlannedGift ;
    dm:giftVehicle dm:BargainSaleVehicle ; dm:seller td:Founder ;
    # assumed: the buyer is an unrelated public charity (or other qualified donee); the line does not name it
    dm:buyer :PublicCharity ;
    # assumed: the basis was split between the sale and gift parts under 1011(b)
    dm:basisAllocated true .

