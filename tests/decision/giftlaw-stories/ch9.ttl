    dm:citesAuthority "Tehan v. Commissioner (2005); Sec. 2036(a)(1)" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ; dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "retained life estate" .

# S9-352 ESTATE PLANNING/TAXES
:S9_352 a dm:StoryCase ;
    dm:storyId "S9-352" ; dm:storySection "9.9" ; dm:storyKind "case" ;
    dm:pageSays "The decedent had funded an annuity trust and a residence trust: the fair market value of both trusts' assets is included in the taxable estate." ;
    dm:citesAuthority "Trombetta v. Commissioner (2013)" ;
    dm:pageOutcome dm:Block ;
    dm:gapNote "No check for estate inclusion of a residence or annuity trust when the grantor dies during the retained term or keeps the use (2036, 2702)." ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_352_gift .
:S9_352_gift a dm:PlannedGift ;
    dm:giftVehicle dm:PersonalResidenceTrust ;
    # assumed: one residence, used mainly as a residence, no lodging services, sale back to the grantor barred; the line gives none of these
    dm:onlyOneResidence true ; dm:primaryUseAsResidence true ;
    dm:transientLodgingWithServices false ; dm:barsSaleToGrantor true .

