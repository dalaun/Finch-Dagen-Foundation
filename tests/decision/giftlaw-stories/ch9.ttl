    dm:holderVotingPercent "40"^^xsd:decimal ; dm:holderValuePercent "40"^^xsd:decimal ; dm:disqualifiedVotingPercent "30"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:yearsSinceAcquired "3"^^xsd:decimal ; dm:writtenDispositionPlan true .

