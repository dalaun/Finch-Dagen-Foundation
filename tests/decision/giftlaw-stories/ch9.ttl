    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ; dm:storyGift :S9_69_gift .
:S9_69_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    # assumed: illustrative holdings over the 20 percent limit; the line says only that they are excess
    dm:holderVotingPercent "40"^^xsd:decimal ; dm:holderValuePercent "40"^^xsd:decimal ; dm:disqualifiedVotingPercent "30"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    # assumed: acquired by gift or bequest and now in year 7, inside the extra five years 4943(c)(7) allows
    dm:acquiredByGiftOrBequest true ; dm:yearsSinceAcquired "7"^^xsd:decimal ;
    dm:extensionGranted true ;
    # assumed: a written plan to dispose of the excess, which an extension request carries
    dm:writtenDispositionPlan true .

