:S9_326_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    # assumed: illustrative figures as percentages of the asset base after the land is left out; the payout is met
    dm:investmentAssetsFMV "100"^^xsd:decimal ; dm:acquisitionIndebtedness "0"^^xsd:decimal ; dm:taxesForYear "0"^^xsd:decimal ; dm:qualifyingDistributionsByDeadline "5"^^xsd:decimal .

