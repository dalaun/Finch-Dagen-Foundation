@prefix : <http://example.org/trust-domain/giftlaw-stories#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GiftLaw Pro chapters 5 to 8 (Difficult Property Gifts, Charitable Deduction
# Methods, Charitable Organizations, Gift Administration) as graded story cases.
# Source: the shelf extracts ch5-difficult-property.md (S5-1 to S5-23),
# ch6-deduction-methods.md (S6-1 to S6-42), ch7-charitable-organizations.md
# (S7-1 to S7-24) and ch8-gift-administration.md (S8-1 to S8-11). The appendix
# ruling lines (R5-, R7-) are not stories and are not encoded. GiftLaw is a
# secondary source: pageOutcome is what the page says, not the law. Roles only
# (see roles.ttl); dollar figures are left out and percentages used instead.
# Rulings are cited by number only. Not legal or tax advice.

# =====================================================================
# Chapter 5: Difficult Property Gifts
# =====================================================================

:S5_1 a dm:StoryCase ;
    dm:storyId "S5-1" ; dm:storySection "5.1.1" ; dm:storyKind "example" ;
    dm:pageSays "Giving mortgaged land outright is part gift, part sale: the equity is deductible and the debt relief is a sale with prorated basis, producing long-term gain." ;
    dm:citesAuthority "Reg. 1.1011-2(a)(3); Rev. Rul. 81-163; 514(c)(2)(A) and (B) (5-and-5 exception)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_1_gift .
:S5_1_gift a dm:PlannedGift ;
    dm:giftVehicle dm:BargainSaleVehicle ; dm:seller td:Founder ; dm:buyer :PublicCharity ;
    dm:basisAllocated true .

:S5_2 a dm:StoryCase ;
    dm:storyId "S5-2" ; dm:storySection "5.1.1" ; dm:storyKind "example" ;
    dm:pageSays "At 80 percent debt, the bargain-sale gain on the debt relief far exceeds the small deduction; no zero-tax result is possible, though the gift still works." ;
    dm:citesAuthority "Reg. 1.1011-2(a)(3); Rev. Rul. 81-163 (carried from the section)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_2_gift .
:S5_2_gift a dm:PlannedGift ;
    dm:giftVehicle dm:BargainSaleVehicle ; dm:seller td:Founder ; dm:buyer :PublicCharity ;
    # assumed: basis is split in the 1011(b) ratio; the page computes the gain that way
    dm:basisAllocated true .

:S5_3 a dm:StoryCase ;
    dm:storyId "S5-3" ; dm:storySection "5.1.1" ; dm:storyKind "example" ;
    dm:pageSays "Mortgaged land exchanged for a gift annuity is a double bargain sale: gain on the debt relief, a reduced deduction, and part of the gain bypassed." ;
    dm:citesAuthority "Reg. 1.1011-2(a)(3); Rev. Rul. 81-163 (carried from the section)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "gift annuity funded with mortgaged land" ;
    dm:pageAccuracyNote "The notes say the page's tax-free share of each payment cannot come from the small prorated basis, and one sentence is left unfinished." .

:S5_4 a dm:StoryCase ;
    dm:storyId "S5-4" ; dm:storySection "5.1.2" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "The IRS treats a remainder trust funded with donor-guaranteed debt as a grantor trust, so it fails to qualify; commentators doubt this but donors avoid testing it." ;
    dm:citesAuthority "PLR 9015049; Reg. 1.677(a)-1(d); Reg. 1.664-1(a)(4)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_4_gift ;
    dm:gapNote "Covered since this pass by PG10 (lien) and PG11 (donor liable on the debt)." .
:S5_4_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: payout and remainder inside the 664(d)(2) limits; the story turns only on the debt
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal ;
    # assumed: the donor placed the lien; its age is not given ;
    dm:transferor td:Founder ; dm:transferredSubjectToLien true ;
    dm:donorLiableOnDebt true .

:S5_5 a dm:StoryCase ;
    dm:storyId "S5-5" ; dm:storySection "5.1.2" ; dm:storyKind "example" ;
    dm:pageSays "Land with an old non-recourse loan meeting the 5-and-5 rule can fund a FLIP unitrust; the debt part is a bargain sale and the equity gain is bypassed." ;
    dm:citesAuthority "514(c)(2)(B) (5-and-5, from 5.1.1); no separate cite on the example" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_5_gift ;
    dm:gapNote "Covered since this pass by PG10; the 5-and-5 debt-financed income rule is still not modeled." .
# Remainder value: the page's deduction as a share of the equity, about 40.8 percent.
# The loan is 6 years old, inside 4941(d)(2)(A)'s 10-year window, which reaches the
# trust through 4947(a)(2). The page does not address it; PG10 now does.
:S5_5_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "6"^^xsd:decimal ; dm:remainderValuePercent "40.8"^^xsd:decimal ;
    # assumed: the 5-and-5 exception keeps the debt from being acquisition indebtedness, so no UBTI
    dm:producesUBTI false ;
    dm:transferor td:Founder ; dm:transferredSubjectToLien true ;
    dm:lienPlacedYearsBefore "6"^^xsd:decimal ; dm:trustAssumesLien false .

:S5_6 a dm:StoryCase ;
    dm:storyId "S5-6" ; dm:storySection "5.1.3" ; dm:storyKind "example" ;
    dm:pageSays "Paying off a small mortgage and recording the release before deeding property to a FLIP unitrust funds the trust with clean property." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_6_gift .
:S5_6_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: payout and remainder inside the 664(d)(2) limits; the page treats the trust as qualified
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .

:S5_7 a dm:StoryCase ;
    dm:storyId "S5-7" ; dm:storySection "5.1.3" ; dm:storyKind "example" ;
    dm:pageSays "Having the lender move all debt onto one retained building lets two others fund a FLIP unitrust debt-free; the retained building's sale retires the debt." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_7_gift .
:S5_7_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: payout and remainder inside the 664(d)(2) limits; the page treats the trust as qualified
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .

:S5_8 a dm:StoryCase ;
    dm:storyId "S5-8" ; dm:storySection "5.1.3" ; dm:storyKind "example" ;
    dm:pageSays "A bridge loan on other land clears the buildings' debt before they fund the unitrust; the charity itself may lend it on commercially reasonable terms." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_8_gift .
:S5_8_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: payout and remainder inside the 664(d)(2) limits; the page treats the trust as qualified
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .

:S5_9 a dm:StoryCase ;
    dm:storyId "S5-9" ; dm:storySection "5.1.3" ; dm:storyKind "example" ;
    dm:pageSays "Giving the charity ten percent of a building and selling it the rest clears debt so other buildings fund a unitrust; the gift portion cushions the charity's risk." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_9_gift .
:S5_9_gift a dm:PlannedGift ;
    dm:giftVehicle dm:BargainSaleVehicle ; dm:seller td:Founder ; dm:buyer :PublicCharity ;
    # assumed: basis is split in the 1011(b) ratio; the page treats the sale as a valid bargain sale
    dm:basisAllocated true .

:S5_10 a dm:StoryCase ;
    dm:storyId "S5-10" ; dm:storySection "5.1.3" ; dm:storyKind "example" ;
    dm:pageSays "Funding a FLIP unitrust with sixty percent of a mortgaged building, the donors guaranteeing payment from their share, works with an independent trustee but carries modest, untested risk." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:NeedsCounsel ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_10_gift ;
    dm:gapNote "No check models the prearranged-sale doctrine, a donor's guarantee of debt on trust property, co-ownership and joint sale with the donor, or what makes a trustee independent." .
# Remainder value: the page's deduction as a share of the property put in the trust, about 42 percent.
:S5_10_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "6"^^xsd:decimal ; dm:remainderValuePercent "42"^^xsd:decimal ;
    dm:giftTrustee :IndependentTrustee .

:S5_11 a dm:StoryCase ;
    dm:storyId "S5-11" ; dm:storySection "5.3.2" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A ruling gave a private foundation five more years to dispose of gifted technology shares after an unforeseeable collapse in their value." ;
    dm:citesAuthority "PLR 200323045; 4943(c)(5) as the page cites it" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_11_gift ;
    dm:pageAccuracyNote "The page cites 4943(c)(5); the notes say the gift disposition rule is 4943(c)(6), with the five-year extension in (c)(7)." .
:S5_11_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    # assumed: the holding was over the limit (the foundation had to dispose of it); percentages illustrative
    dm:holderVotingPercent "30"^^xsd:decimal ; dm:holderValuePercent "30"^^xsd:decimal ;
    dm:disqualifiedVotingPercent "0"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:extensionGranted true ;
    # assumed: in the extended second five years, with the disposal plan a 4943(c)(7) extension requires
    dm:yearsSinceAcquired "7"^^xsd:decimal ; dm:writtenDispositionPlan true .

:S5_12 a dm:StoryCase ;
    dm:storyId "S5-12" ; dm:storySection "5.3.2" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A ruling gave a private foundation more time to dispose of a gifted fitness club whose property needed upgrades before a fair sale." ;
    dm:citesAuthority "PLR 200332020" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_12_gift .
:S5_12_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    # assumed: the business was over the limit (the foundation had to dispose of it); percentages illustrative
    dm:holderVotingPercent "100"^^xsd:decimal ; dm:holderValuePercent "100"^^xsd:decimal ;
    dm:disqualifiedVotingPercent "0"^^xsd:decimal ; dm:passiveIncomePercent "5"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:extensionGranted true ;
    # assumed: in the extended period, with the disposal plan a 4943(c)(7) extension requires
    dm:yearsSinceAcquired "7"^^xsd:decimal ; dm:writtenDispositionPlan true .

:S5_13 a dm:StoryCase ;
    dm:storyId "S5-13" ; dm:storySection "5.3.3" ; dm:storyKind "example" ;
    dm:pageSays "A 14-year lead annuity trust holding family C-corporation stock keeps the charitable interest under 60 percent of value, so the excess business holdings rules do not apply." ;
    dm:citesAuthority "4947(b)(3) (60% test); 4943; 642(c) (CLT's unlimited deduction); Sec. 681" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_13_gift ;
    dm:gapNote "No check models why the trust must hold C-corporation stock rather than a pass-through interest (unrelated business income in a lead trust under 681)." .
# Charitable value: the page's deduction over the funding, about 58.6 percent.
:S5_13_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FamilyLeadTrust ; dm:deductionAllowed true ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:GuaranteedAnnuity ; dm:charitableIncomeValuePercent "58.6"^^xsd:decimal ;
    dm:leadBeneficiary :PublicCharity ;
    # assumed: the family controls the company and the trust's block is large; the 60 percent test is what saves it
    dm:holderVotingPercent "40"^^xsd:decimal ; dm:holderValuePercent "40"^^xsd:decimal ;
    dm:disqualifiedVotingPercent "60"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:yearsSinceAcquired "14"^^xsd:decimal .

:S5_14 a dm:StoryCase ;
    dm:storyId "S5-14" ; dm:storySection "5.3.3" ; dm:storyKind "example" ;
    dm:pageSays "Discounted family partnership units in a lead annuity trust lasting just under five years fit the gift holding window and cut the taxable gift to within exemption." ;
    dm:citesAuthority "4947(b)(3); 4943 (5-year window)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_14_gift ;
    dm:gapNote "No check models the partnership valuation discount or its scrutiny." ;
    dm:pageAccuracyNote "The notes say the page's five-year payment total is slightly misstated." .
# Charitable value: one minus the page's taxable gift over the funding, about 38.6 percent.
:S5_14_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FamilyLeadTrust ; dm:deductionAllowed true ; dm:deductionFor dm:IncomeInterest ;
    dm:incomeInterestForm dm:GuaranteedAnnuity ; dm:charitableIncomeValuePercent "38.6"^^xsd:decimal ;
    dm:leadBeneficiary :PublicCharity ;
    # assumed: the partnership holds the operating company, family controlled; the trust ends inside the 5-year window
    dm:holderVotingPercent "40"^^xsd:decimal ; dm:holderValuePercent "40"^^xsd:decimal ;
    dm:disqualifiedVotingPercent "60"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:yearsSinceAcquired "4.999"^^xsd:decimal .

:S5_15 a dm:StoryCase ;
    dm:storyId "S5-15" ; dm:storySection "5.4.2" ; dm:storyKind "example" ;
    dm:pageSays "A foundation's below-market, higher-risk loan to a community small-business lender is a program-related investment, not a jeopardizing investment." ;
    dm:citesAuthority "Reg. 53.4944-1(a)(1); Sec. 4944" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:FoundationGrantmaking ; dm:outsideReason "program-related investment under 4944" .

:S5_16 a dm:StoryCase ;
    dm:storyId "S5-16" ; dm:storySection "5.5.1" ; dm:storyKind "court case" ;
    dm:pageSays "A mere expectation that shares given to the donor's own foundation would be redeemed did not make it a redemption taxed to the donor; the gift stood." ;
    dm:citesAuthority "Palmer, 62 T.C. 684 (1974), aff'd on other grounds (8th Cir. 1975)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ; dm:outsideReason "assignment of income on a gift to a private foundation" .

:S5_17 a dm:StoryCase ;
    dm:storyId "S5-17" ; dm:storySection "5.5.1" ; dm:storyKind "revenue ruling" ;
    dm:pageSays "Proceeds of a gift then redemption are taxed to the donor only if the charity is legally bound, or can be compelled, to redeem or sell." ;
    dm:citesAuthority "Rev. Rul. 78-197" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "assignment of income test" .

:S5_18 a dm:StoryCase ;
    dm:storyId "S5-18" ; dm:storySection "5.5.1" ; dm:storyKind "court case" ;
    dm:pageSays "Shares given after over half had been tendered, when the buyer could compel the merger, carried ripened gain taxed to the donors as a sale." ;
    dm:citesAuthority "Ferguson (no reporter cite in the notes); Rev. Rul. 78-197" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "anticipatory assignment of income" .

:S5_19 a dm:StoryCase ;
    dm:storyId "S5-19" ; dm:storySection "5.5.1" ; dm:storyKind "court case" ;
    dm:pageSays "Warrants given after a non-binding letter of intent but before a binding agreement avoided the gain; the IRS had to follow its own revenue ruling." ;
    dm:citesAuthority "Rauenhorst, 119 T.C. No. 9 (2002); Rev. Rul. 78-197" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "assignment of income timing" .

:S5_20 a dm:StoryCase ;
    dm:storyId "S5-20" ; dm:storySection "5.5.1" ; dm:storyKind "court case" ;
    dm:pageSays "Closely held shares given to a donor-advised fund that controlled the redemption decision were not an assignment of income; gain bypassed and penalty removed." ;
    dm:citesAuthority "Dickinson, T.C. Memo. 2020-128; Palmer; §6662" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "donor-advised fund; assignment of income" .

:S5_21 a dm:StoryCase ;
    dm:storyId "S5-21" ; dm:storySection "5.5.2" ; dm:storyKind "example" ;
    dm:pageSays "For real estate, a charity can discount the value or the annuity rate to cover sale risk; both give the same payment, and deferral helps." ;
    dm:citesAuthority "Reg. 1.1011-2(a)(4)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "real estate gift annuity" .

:S5_22 a dm:StoryCase ;
    dm:storyId "S5-22" ; dm:storySection "5.5.3" ; dm:storyKind "court case" ;
    dm:pageSays "Family company stock given to a donor-advised fund days before a near-certain sale carried ripened gain taxed to the donor; the deduction also failed on the appraisal." ;
    dm:citesAuthority "Hoensheid (no reporter cite in the notes); Rev. Rul. 78-197 framework" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "assignment of income; failed appraisal" .

:S5_23 a dm:StoryCase ;
    dm:storyId "S5-23" ; dm:storySection "5.5.3" ; dm:storyKind "example" ;
    dm:pageSays "Stock put in a two-life unitrust with an advisor as trustee well before a sale, then a later gift of the income interest, yields two deductions." ;
    dm:citesAuthority "Reg. 1.170A-7(a)(2)(i); Reg. 25.2522(c)-3(c); 170(f)(11)(E)(ii); Notice 2006-96; 664(e); 4943(c)(6), (c)(7)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S5_23_gift ;
    dm:gapNote "No check models the step-transaction or prearranged-sale timing, trustee independence, or the later gift of the income interest." ;
    dm:pageAccuracyNote "The notes say the page words the assignment-of-income point backwards and wrongly says remainder trusts are generally subject to 4943; 4947(b)(3)(B) generally exempts them." .
:S5_23_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: payout and remainder inside the 664(d)(2) limits; the page treats the trust as qualified
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal ;
    dm:holdsSCorpStock false ; dm:giftTrustee :IndependentTrustee .

# =====================================================================
# Chapter 6: Charitable Deduction Methods
# =====================================================================

:S6_1 a dm:StoryCase ;
    dm:storyId "S6-1" ; dm:storySection "6.1.1" ; dm:storyKind "example" ;
    dm:pageSays "A revocable bequest pledge cannot be booked, but its present value at the charity's chosen rate can be computed for donor recognition." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ; dm:outsideReason "fundraising credit valuation" .

:S6_2 a dm:StoryCase ;
    dm:storyId "S6-2" ; dm:storySection "6.1.1" ; dm:storyKind "example" ;
    dm:pageSays "A charity computes its liability on issued gift annuities with current mortality and a low rate; long deferrals may need a minimum-deduction override." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "gift annuity liability accounting" .

:S6_3 a dm:StoryCase ;
    dm:storyId "S6-3" ; dm:storySection "6.1.2" ; dm:storyKind "example" ;
    dm:pageSays "Survivor counts in a mortality table give the odds of reaching a later age, used in valuing life interests." ;
    dm:citesAuthority "§7520" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ; dm:outsideReason "mortality table reading" ;
    dm:pageAccuracyNote "The notes say the IRS has since moved to Table 2010CM, effective June 1, 2023." .

:S6_4 a dm:StoryCase ;
    dm:storyId "S6-4" ; dm:storySection "6.1.4" ; dm:storyKind "example" ;
    dm:pageSays "A stock-funded gift annuity is a bargain sale: the gift share of the gain is bypassed and the rest is reported over the donor's life." ;
    dm:citesAuthority "Sec. 72; Reg. 1.72 tables; 72(b)(3)(A); 67(b)(10)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "gift annuity bargain sale" ;
    dm:pageAccuracyNote "The notes say the page's mortality table reference is out of date." .

:S6_5 a dm:StoryCase ;
    dm:storyId "S6-5" ; dm:storySection "6.1.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A ruling excluded a decedent's life insurance proceeds from the gross estate." ;
    dm:citesAuthority "PLR 200147039" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:LifeInsurance ; dm:outsideReason "estate inclusion of insurance" .

:S6_6 a dm:StoryCase ;
    dm:storyId "S6-6" ; dm:storySection "6.1.5" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "A ruling held that an IRA payable to the decedent's estate is income in respect of a decedent." ;
    dm:citesAuthority "PLR 200221011" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ; dm:outsideReason "income in respect of a decedent" .

:S6_7 a dm:StoryCase ;
    dm:storyId "S6-7" ; dm:storySection "6.2.1" ; dm:storyKind "example" ;
    dm:pageSays "A five percent life annuity trust for a donor aged 72 gives a deduction near 48 percent of funding and passes the exhaustion-probability test." ;
    dm:citesAuthority "664(d)(1); Rev. Rul. 77-374; Reg. 25.7520-3(b)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ; dm:outsideReason "annuity remainder trust" ;
    dm:pageAccuracyNote "The notes say the printed table excerpt shows a different quarterly adjustment factor than the one the page uses." .

:S6_8 a dm:StoryCase ;
    dm:storyId "S6-8" ; dm:storySection "6.2.1" ; dm:storyKind "example" ;
    dm:pageSays "Adding a ten-year guaranteed term to the annuity trust lowers the deduction and can block the estate marital deduction in a spousal trust." ;
    dm:citesAuthority "Reg. 1.664-2(a)(5)(ii)(b); 2056(b)(8)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ; dm:outsideReason "annuity remainder trust" .

:S6_9 a dm:StoryCase ;
    dm:storyId "S6-9" ; dm:storySection "6.2.2" ; dm:storyKind "example" ;
    dm:pageSays "A twenty-year five percent annuity trust gives a deduction of about 22 percent of funding; the donor's age does not matter for a term trust." ;
    dm:citesAuthority "Reg. 1.664-2(a)(5)(i)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
