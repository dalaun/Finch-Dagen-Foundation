    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "public benefit; charitable class" .

:S7_4 a dm:StoryCase ;
    dm:storyId "S7-4" ; dm:storySection "7.1.1" ; dm:storyKind "example" ;
    dm:pageSays "Scholarships given to the charity's own trustees' children are questionable under the public-benefit rule." ;
    dm:citesAuthority "Reg. 1.501(c)(3)-1(c)" ;
    dm:pageOutcome dm:NeedsCounsel ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "public benefit; insiders' families" .

:S7_5 a dm:StoryCase ;
    dm:storyId "S7-5" ; dm:storySection "7.1.1" ; dm:storyKind "court case" ;
    dm:pageSays "A charter school with no working board that paid its executive for personal use lost exemption under the operational test." ;
    dm:citesAuthority "Rameses School of San Antonio v. Commissioner, T.C. Memo 2007-85; Reg. 1.501(c)(3)-1(c)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "private inurement; governance" .

:S7_6 a dm:StoryCase ;
    dm:storyId "S7-6" ; dm:storySection "7.1.1" ; dm:storyKind "example" ;
    dm:pageSays "A large political ad campaign could cost the charity its exemption and bring a 10 percent, then 100 percent, excise tax." ;
    dm:citesAuthority "none (Rev. Rul. 2007-41 cited nearby for what is permitted)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "political campaign activity" ;
    dm:pageAccuracyNote "The notes say the example's manager penalties do not match the percentages the page gives." .

:S7_7 a dm:StoryCase ;
    dm:storyId "S7-7" ; dm:storySection "7.1.2" ; dm:storyKind "example" ;
    dm:pageSays "A museum showing only local artists, who keep most sale proceeds, operates for private benefit and is not exempt." ;
    dm:citesAuthority "REG-111257-05 (Oct 2005 proposed regs)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "private benefit" .

:S7_8 a dm:StoryCase ;
    dm:storyId "S7-8" ; dm:storySection "7.1.2" ; dm:storyKind "example" ;
    dm:pageSays "An organization researching one family's genealogy serves private benefit and is not exempt." ;
    dm:citesAuthority "REG-111257-05" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "private benefit" .

:S7_9 a dm:StoryCase ;
    dm:storyId "S7-9" ; dm:storySection "7.1.2" ; dm:storyKind "example" ;
    dm:pageSays "A public charity's below-value sale of a donated building to its president's sibling is an excess benefit taxed under 4958." ;
    dm:citesAuthority "Sec. 4958; Reg. 53.4958-3; Reg. 53.4958-1" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "public charity excess benefit (4958)" .

:S7_10 a dm:StoryCase ;
    dm:storyId "S7-10" ; dm:storySection "7.1.2" ; dm:storyKind "example" ;
    dm:pageSays "Giving a major donor expensive opera tickets can bring revocation, intermediate sanctions, or both." ;
    dm:citesAuthority "Sec. 4958" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "public charity excess benefit (4958)" .

:S7_11 a dm:StoryCase ;
    dm:storyId "S7-11" ; dm:storySection "7.1.3" ; dm:storyKind "example" ;
    dm:pageSays "In a mixed lease, the 23 percent personal-property share of rent is taxable unrelated business income and the real-property share is excluded." ;
    dm:citesAuthority "Secs. 512 to 514" ;
    dm:pageOutcome dm:NeedsCounsel ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "UBIT on a mixed lease" .

:S7_12 a dm:StoryCase ;
    dm:storyId "S7-12" ; dm:storySection "7.1.6" ; dm:storyKind "example" ;
    dm:pageSays "A donor's trust controlled by the supported charity, which appoints its trustees, qualifies as a Type I supporting organization." ;
    dm:citesAuthority "Sec. 509(a)(3); Reg. 1.509(a)-4" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "supporting organization type" .

:S7_13 a dm:StoryCase ;
    dm:storyId "S7-13" ; dm:storySection "7.1.6" ; dm:storyKind "example" ;
    dm:pageSays "A donor's trust run by the supported charity's own board members qualifies as a Type II supporting organization." ;
    dm:citesAuthority "Sec. 509(a)(3); Reg. 1.509(a)-4" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "supporting organization type" .

:S7_14 a dm:StoryCase ;
    dm:storyId "S7-14" ; dm:storySection "7.2.2" ; dm:storyKind "example" ;
    dm:pageSays "A private foundation paying its founder's personal pledge would be self-dealing, so the trustee rightly refused." ;
    dm:citesAuthority "Reg. 53.4941(d)-2(f)(1); Sec. 4941; Reg. 53.4941(b)-1" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:FoundationGrantmaking ; dm:outsideReason "foundation paying a disqualified person's pledge" .

:S7_15 a dm:StoryCase ;
    dm:storyId "S7-15" ; dm:storySection "7.2.2" ; dm:storyKind "example" ;
    dm:pageSays "A foundation trustee's child winning a scholarship under an objective rule is not self-dealing; the benefit is incidental." ;
    dm:citesAuthority "Sec. 4941 (incidental benefit exception)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:FoundationGrantmaking ; dm:outsideReason "scholarship to an insider's child" .

:S7_16 a dm:StoryCase ;
    dm:storyId "S7-16" ; dm:storySection "7.2.3" ; dm:storyKind "example" ;
    dm:pageSays "A foundation's minimum distribution is five percent of its average investment assets after subtracting a cash reserve." ;
    dm:citesAuthority "Sec. 4942" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S7_16_gift .
# Scaled so the foundation's average assets are 100; the cash reserve is 1.5.
:S7_16_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    dm:investmentAssetsFMV "98.5"^^xsd:decimal ; dm:acquisitionIndebtedness "0"^^xsd:decimal ;
    dm:taxesForYear "0"^^xsd:decimal ;
    # assumed: the foundation distributes at least the minimum; the page only computes it
    dm:qualifyingDistributionsByDeadline "5"^^xsd:decimal .

:S7_17 a dm:StoryCase ;
    dm:storyId "S7-17" ; dm:storySection "7.2.3" ; dm:storyKind "example" ;
    dm:pageSays "Reasonable administration, grants to public charities and approved grants to individuals together exceed the foundation's minimum distribution." ;
    dm:citesAuthority "Sec. 4942; 4945(g) (grants to individuals)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S7_17_gift .
# Same scale as S7-16: assets 100, reserve 1.5; the page's distributions are 5.25 on that scale.
:S7_17_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    dm:investmentAssetsFMV "98.5"^^xsd:decimal ; dm:acquisitionIndebtedness "0"^^xsd:decimal ;
    dm:taxesForYear "0"^^xsd:decimal ; dm:qualifyingDistributionsByDeadline "5.25"^^xsd:decimal .

:S7_18 a dm:StoryCase ;
    dm:storyId "S7-18" ; dm:storySection "7.2.3" ; dm:storyKind "example" ;
    dm:pageSays "The distributable amount is five percent of assets net of acquisition debt and cash reserve, less the prior year's excise and income taxes." ;
    dm:citesAuthority "Sec. 4942" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S7_18_gift .
# Scaled so total assets are 100: reserve 1.485, acquisition debt 1, taxes 0.145;
# the distributable amount is then 4.73075, matching the page.
:S7_18_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    dm:investmentAssetsFMV "98.515"^^xsd:decimal ; dm:acquisitionIndebtedness "1"^^xsd:decimal ;
    dm:taxesForYear "0.145"^^xsd:decimal ;
    # assumed: the foundation distributes at least the distributable amount; the page only computes it
    dm:qualifyingDistributionsByDeadline "5"^^xsd:decimal .

:S7_19 a dm:StoryCase ;
    dm:storyId "S7-19" ; dm:storySection "7.2.4" ; dm:storyKind "example" ;
    dm:pageSays "A foundation given 15 percent of a company where a substantial contributor holds 7 percent has excess holdings and must sell 2 percent within five years." ;
    dm:citesAuthority "Sec. 4943; 4943(c)(2); 4943(c)(6), (c)(7); 4943(a)" ;
    dm:pageOutcome dm:NeedsCounsel ; dm:storyScope dm:GradedByModel ; dm:storyGift :S7_19_gift ;
    dm:pageAccuracyNote "The notes say the page's statement that the company must sell apparently means the foundation must sell." .
:S7_19_gift a dm:PlannedGift ;
    dm:giftVehicle dm:FoundationHolding ;
    dm:holderVotingPercent "15"^^xsd:decimal ; dm:disqualifiedVotingPercent "7"^^xsd:decimal ;
    # assumed: voting and value shares are the same, and the company is an operating business (not 95 percent passive)
    dm:holderValuePercent "15"^^xsd:decimal ; dm:passiveIncomePercent "10"^^xsd:decimal ;
    dm:acquiredByGiftOrBequest true ; dm:yearsSinceAcquired "0"^^xsd:decimal .

:S7_20 a dm:StoryCase ;
    dm:storyId "S7-20" ; dm:storySection "7.2.8" ; dm:storyKind "revenue ruling" ;
    dm:pageSays "A foundation that transfers all its assets to another and then gives termination notice on a zero-asset day owes no termination tax." ;
    dm:citesAuthority "Rev. Rul. 2002-28; Sec. 507(a), 507(c)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OtherOutside ; dm:outsideReason "foundation termination tax (507)" .

:S7_21 a dm:StoryCase ;
    dm:storyId "S7-21" ; dm:storySection "7.2.9" ; dm:storyKind "example" ;
    dm:pageSays "Appreciated public stock given to a non-operating private foundation is deductible up to 20 percent of income, but to an operating foundation up to 30 percent." ;
    dm:citesAuthority "Sec. 170(e) and the PF vs. public-charity limits (no section cited on the example)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:DeductionArithmetic ; dm:outsideReason "percentage limits by recipient" .

:S7_22 a dm:StoryCase ;
    dm:storyId "S7-22" ; dm:storySection "7.2.9" ; dm:storyKind "example" ;
    dm:pageSays "A museum foundation spending 90 percent of its income directly on the museum passes the operating foundation income test." ;
    dm:citesAuthority "4942(j)(3)(A); Reg. 53.4942(b)-1(c)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "operating foundation income test" .

:S7_23 a dm:StoryCase ;
    dm:storyId "S7-23" ; dm:storySection "7.2.9" ; dm:storyKind "example" ;
    dm:pageSays "A foundation holding 70 percent of its assets in program vehicles meets the 65 percent operating foundation asset test." ;
    dm:citesAuthority "Reg. 53.4942(b)-2" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:CharityOperations ; dm:outsideReason "operating foundation asset test" ;
    dm:pageAccuracyNote "The notes say the example then puts the income test at 65 percent, contradicting the 85 percent stated earlier." .

:S7_24 a dm:StoryCase ;
    dm:storyId "S7-24" ; dm:storySection "7.3.3" ; dm:storyKind "court case" ;
    dm:pageSays "Tuition paid to a school for one's own child or grandchild is not deductible, because the benefit received equals the payment." ;
    dm:citesAuthority "Sklar v. Commissioner (no reporter cite in the notes)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:OutrightGiftToPublicCharity ; dm:outsideReason "quid pro quo; tuition" .

# =====================================================================
# Chapter 8: Gift Administration
# =====================================================================

:S8_1 a dm:StoryCase ;
    dm:storyId "S8-1" ; dm:storySection "8.1.1" ; dm:storyKind "example" ;
    dm:pageSays "A charity tracks each gift annuity's share of a pooled reserve monthly, adding earnings and subtracting payments." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "gift annuity reserve accounting" ;
    dm:pageAccuracyNote "The notes say the method credits earnings on the opening balance rather than the month-end balance it describes, and the annuity rate is dated." .

:S8_2 a dm:StoryCase ;
    dm:storyId "S8-2" ; dm:storySection "8.1.2" ; dm:storyKind "example" ;
    dm:pageSays "When charity, donor and annuitant share a state, its law governs; when donor and annuitant live elsewhere, consensus favors their state; other combinations are unsettled." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:NeedsCounsel ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:StateLaw ; dm:outsideReason "state gift annuity regulation" .

:S8_3 a dm:StoryCase ;
    dm:storyId "S8-3" ; dm:storySection "8.1.4" ; dm:storyKind "example" ;
    dm:pageSays "When an annuitant dies before recovering basis, the unrecovered basis is an itemized, not charitable, deduction on the final return." ;
    dm:citesAuthority "72(b)(3)(A); 72(b)(3)(B)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:GiftAnnuityOrPooledFund ; dm:outsideReason "unrecovered annuity basis" ;
    dm:pageAccuracyNote "The notes recompute the basis recovered and the final deduction, finding the page's figures wrong, and say its form line reference is dated." .

:S8_4 a dm:StoryCase ;
    dm:storyId "S8-4" ; dm:storySection "8.2.1" ; dm:storyKind "court case" ;
    dm:pageSays "A case is cited for the point that running a remainder trust contrary to its terms risks disqualifying it." ;
    dm:citesAuthority "Estate of Atkinson, 115 T.C. No. 3 (2000); Reg. 1.664-1(a)(4)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ; dm:outsideReason "annuity remainder trust administration" .

:S8_5 a dm:StoryCase ;
    dm:storyId "S8-5" ; dm:storySection "8.2.1" ; dm:storyKind "example" ;
    dm:pageSays "A unitrust payout made in stock is treated as a sale by the trust, characterized through the four tiers, with the recipient's basis at value." ;
    dm:citesAuthority "Reg. 1.664-1(d)(5); 1.664-1(e)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_5_gift .
:S8_5_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "15"^^xsd:decimal ;
    # assumed: the remainder of a 5-year 15 percent unitrust is over 10 percent (roughly 44 percent); the page treats it as qualified
    dm:remainderValuePercent "44"^^xsd:decimal .

:S8_6 a dm:StoryCase ;
    dm:storyId "S8-6" ; dm:storySection "8.2.1" ; dm:storyKind "example" ;
    dm:pageSays "A unitrust's short first-year payout is prorated by days; the final short year may be prorated too, or waived by the instrument." ;
    dm:citesAuthority "none on the example (the section cites Regs. 1.664-2(a)(1), -3(a)(1))" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_6_gift .
:S8_6_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder over 10 percent; the page treats the trust as qualified
    dm:remainderValuePercent "10"^^xsd:decimal .

:S8_7 a dm:StoryCase ;
    dm:storyId "S8-7" ; dm:storySection "8.2.2" ; dm:storyKind "example" ;
    dm:pageSays "A unitrust payout is characterized through the four tiers, here as interest first and then long-term gain from equity sales." ;
    dm:citesAuthority "proposed Reg. 1.1411-3(c)(2) as cited" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_7_gift ;
    dm:pageAccuracyNote "The notes say the page cites a proposed regulation; the final net investment income rule is in Reg. 1.1411-3(d)." .
:S8_7_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    dm:unitrustPercent "6"^^xsd:decimal ;
    # assumed: remainder over 10 percent; the page treats the trust as qualified
    dm:remainderValuePercent "10"^^xsd:decimal .

:S8_8 a dm:StoryCase ;
    dm:storyId "S8-8" ; dm:storySection "8.2.3" ; dm:storyKind "example" ;
    dm:pageSays "The page says a remainder trust running a gas station has unrelated business income, becomes fully taxable, and files Form 1041." ;
    dm:citesAuthority "664(c)(2) (per the notes' correction); 4941-4945 (Form 4720)" ;
    dm:pageOutcome dm:Block ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_8_gift ;
    dm:pageAccuracyNote "Out of date: since 2007 the trust keeps its exemption and owes a 100 percent excise tax on the unrelated business taxable income (Form 4720); the notes also correct the first-tier self-dealing rate to 10 percent." .
:S8_8_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a unitrust (type not stated) with payout and remainder inside the 664(d)(2) limits
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal ;
    dm:producesUBTI true .

:S8_9 a dm:StoryCase ;
    dm:storyId "S8-9" ; dm:storySection "8.2.3" ; dm:storyKind "example" ;
    dm:pageSays "A remainder trust's Schedule K-1 shows the character of the year's payout, here dividends and long-term gain." ;
    dm:citesAuthority "none" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_9_gift ;
    dm:pageAccuracyNote "The notes say it is the K-1 issued with Form 5227 (a Form 1041 K-1), not a Form 1040 K-1." .
:S8_9_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a unitrust (type not stated) with payout and remainder inside the 664(d)(2) limits
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .

:S8_10 a dm:StoryCase ;
    dm:storyId "S8-10" ; dm:storySection "8.2.4" ; dm:storyKind "example" ;
    dm:pageSays "Trustee and manager fees noticeably cut a remainder trust's net return, and keeping costs down matters more when returns are low." ;
    dm:citesAuthority "Uniform Prudent Investor Act (state law); 4947(b)(3)(B) per the notes" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_10_gift ;
    dm:gapNote "No check models trustee and manager costs or state prudent-investor duties." ;
    dm:pageAccuracyNote "The notes say the page omits that 4944's jeopardy limits generally do not apply to remainder trusts (4947(b)(3)(B))." .
:S8_10_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a unitrust (type not stated) with payout and remainder inside the 664(d)(2) limits
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .

:S8_11 a dm:StoryCase ;
    dm:storyId "S8-11" ; dm:storySection "8.2.4" ; dm:storyKind "private letter ruling" ;
    dm:pageSays "Two rulings allowed life insurance to be held in a charitable remainder trust." ;
    dm:citesAuthority "PLR 7928014; PLR 8745013; PLR 200017051 (mentioned in passing); Rev. Rul. 84-179 (doubtful fit)" ;
    dm:pageOutcome dm:Allow ; dm:storyScope dm:GradedByModel ; dm:storyGift :S8_11_gift ;
    dm:pageAccuracyNote "The notes doubt that Rev. Rul. 84-179 concerns remainder trust investments; they read it as a 2042 estate inclusion ruling." .
:S8_11_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ; dm:deductionAllowed true ; dm:deductionFor dm:RemainderInterest ;
    # assumed: a unitrust (type not stated) with payout and remainder inside the 664(d)(2) limits
    dm:unitrustPercent "5"^^xsd:decimal ; dm:remainderValuePercent "10"^^xsd:decimal .
