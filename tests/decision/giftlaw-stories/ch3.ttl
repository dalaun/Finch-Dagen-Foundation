:S3_8 a dm:StoryCase ;
    dm:storyId "S3-8" ;
    dm:storySection "3.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "The author argues the 10 percent test may use the best of three allowed rates for same-day land and cash, with reformation as the fallback." ;
    dm:citesAuthority "Sec. 7520; Sec. 664(d)(1); Sec. 2055(e)" ;
    dm:pageOutcome dm:NeedsCounsel ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_9 a dm:StoryCase ;
    dm:storyId "S3-9" ;
    dm:storySection "3.1.5" ;
    dm:storyKind "court case" ;
    dm:pageSays "The estate deduction was denied because the annuity trust never paid its annuity and was used to pay estate tax; the appeals court affirmed." ;
    dm:citesAuthority "Atkinson, 115 T.C. No. 3 (2000), aff'd 11th Cir.; Rev. Rul. 82-128; S. Rept. 91-552; Reg. 1.664-3(a); Reg. 1.664-3(a)(1)(i)(g); Reg. 1.664-3(a)(2)" ;
