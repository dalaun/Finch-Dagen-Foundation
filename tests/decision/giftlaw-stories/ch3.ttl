:S3_14 a dm:StoryCase ;
    dm:storyId "S3-14" ;
    dm:storySection "3.1.7" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "An independent trustee may choose the remainder charities while the grantor keeps the power to replace the trustee, without breaking the unitrust." ;
    dm:citesAuthority "PLR 9202033; Rev. Rul. 77-285" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S3_14_gift ;
    dm:gapNote "No check tests trustee independence or a grantor’s retained power to replace the trustee." .
:S3_14_gift a dm:PlannedGift ;
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ;
    dm:deductionFor dm:RemainderInterest ;
    # assumed: payout not stated; the 5 percent minimum is filled as the compliant value
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder value not stated; the 10 percent minimum is filled as the compliant value
    dm:remainderValuePercent "10"^^xsd:decimal ;
    dm:giftTrustee :IndependentTrustee .

:S3_15 a dm:StoryCase ;
