    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_10 a dm:StoryCase ;
    dm:storyId "S3-10" ;
    dm:storySection "3.1.6" ;
    dm:storyKind "example" ;
    dm:pageSays "Giving 20 percent of an annuity-trust income interest to the remainder charity is deductible, but as a capital-gain gift under the 30 percent limit." ;
    dm:citesAuthority "PLR 9550026; Reg. 1.170A-7(a)(2)(i); Sec. 170(f)(3)(A)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_11 a dm:StoryCase ;
    dm:storyId "S3-11" ;
    dm:storySection "3.1.6" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "An annuity trust may pay part of its principal to charity each year if amounts and timing are set well after creation." ;
    dm:citesAuthority "PLR 199929033" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_12 a dm:StoryCase ;
    dm:storyId "S3-12" ;
    dm:storySection "3.1.7" ;
    dm:storyKind "revenue ruling" ;
    dm:pageSays "A remainder trust may not be invaded to pay estate or gift tax; with a retained revocation power the child’s interest is taxed in the estate." ;
    dm:citesAuthority "Rev. Rul. 82-128" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_13 a dm:StoryCase ;
    dm:storyId "S3-13" ;
    dm:storySection "3.1.7" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A misdrafted annuity trust was saved because the mistake was shown to be the drafter’s." ;
    dm:citesAuthority "PLR 200422005; PLR 200425027" ;
