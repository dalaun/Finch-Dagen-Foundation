@prefix : <http://example.org/trust-domain/giftlaw-stories#> .
@prefix dm: <http://example.org/trust-domain/decision#> .
@prefix td: <http://example.org/trust-domain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GiftLaw Pro chapter 3 (deferred gifts): 190 stories, S3-1 to S3-190, from the
# shelf extract of the operator's notes on the pages. Each story is a dm:StoryCase;
# a story whose vehicle the planned-giving checks model (remainder unitrusts,
# family lead trusts, residence trusts) carries a dm:PlannedGift. Annuity remainder
# trusts, grantor lead trusts, life estates, gift annuities and pooled funds are
# outside for now. The page's outcome is what the page says, not the law. Roles
# only; percentages only; no dollar figures. Not legal or tax advice.

:S3_1 a dm:StoryCase ;
    dm:storyId "S3-1" ;
    dm:storySection "3.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A remainder annuity trust may pay a special-needs trust for one disabled beneficiary for life, in one of three approved formats." ;
    dm:citesAuthority "PLR 199903001; Rev. Rul. 2002-20; Sec. 6511(b)(2)(A)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_2 a dm:StoryCase ;
    dm:storyId "S3-2" ;
    dm:storySection "3.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "An annuity remainder trust may make current payments to charity and name the donors’ private foundation as remainder beneficiary." ;
    dm:citesAuthority "PLR 200010035" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_3 a dm:StoryCase ;
    dm:storyId "S3-3" ;
    dm:storySection "3.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "An annuity remainder trust may end when the recipient remarries, as a qualified contingency, though that does not raise the deduction." ;
    dm:citesAuthority "PLR 200430012; Sec. 664(f)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_4 a dm:StoryCase ;
    dm:storyId "S3-4" ;
    dm:storySection "3.1.1" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A term remainder trust may pay another trust freely; a one-life trust may do so only for a single incompetent beneficiary." ;
    dm:citesAuthority "PLR 9718030; PLR 9839024" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_5 a dm:StoryCase ;
    dm:storyId "S3-5" ;
    dm:storySection "3.1.2" ;
    dm:storyKind "court case" ;
    dm:pageSays "The Tax Court rejected the annuity-trust and commercial-annuity scheme: carryover basis, recapture as ordinary income, every payout taxable, and a penalty for one couple." ;
    dm:citesAuthority "Gerhardt v. Commissioner, 160 T.C. No. 9; Secs. 1015, 72, 664(b), 1245, 6662" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
    dm:outsideReason "annuity remainder trust" .

:S3_6 a dm:StoryCase ;
    dm:storyId "S3-6" ;
    dm:storySection "3.1.2" ;
    dm:storyKind "court case" ;
    dm:pageSays "The district court upheld an estate’s charitable deduction for a bequest to a testamentary trust." ;
    dm:citesAuthority "Palumbo (D.C., 2011)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:TransferTaxArithmetic ;
    dm:outsideReason "estate deduction for a testamentary trust" .

:S3_7 a dm:StoryCase ;
    dm:storyId "S3-7" ;
    dm:storySection "3.1.3" ;
    dm:storyKind "example" ;
    dm:pageSays "An annuity trust funded with undervalued stock stays valid if the deduction is figured on twenty times the stated annuity amount." ;
    dm:citesAuthority "Reg. 1.664-2(a)(2)(iii); Sec. 664(d)(1)" ;
    dm:pageOutcome dm:Allow ;
    dm:storyScope dm:OutsideModel ;
    dm:outsideCategory dm:VehicleNotYetModeled ;
