:S3_32 a dm:StoryCase ;
    dm:storyId "S3-32" ;
    dm:storySection "3.1.10" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "Debt-encumbered property does not belong in a remainder trust, and the ruling did not allow it." ;
    dm:citesAuthority "PLR 9015049" ;
    dm:pageOutcome dm:Block ;
    dm:storyScope dm:GradedByModel ;
    dm:storyGift :S3_32_gift ;
    dm:gapNote "Covered since this pass by PG10; the grantor-trust rule is PG11, which needs the donor's liability, not given here." .
:S3_32_gift a dm:PlannedGift ;
    # assumed: the notes say only remainder trust; unitrust form is filled
    dm:giftVehicle dm:CharitableRemainderUnitrust ;
    dm:deductionAllowed true ;
    dm:deductionFor dm:RemainderInterest ;
    # assumed: payout not stated; the 5 percent minimum is filled as the compliant value
    dm:unitrustPercent "5"^^xsd:decimal ;
    # assumed: remainder value not stated; the 10 percent minimum is filled as the compliant value
    dm:remainderValuePercent "10"^^xsd:decimal ;
    # assumed: the debt makes the property debt-financed, producing unrelated business income (the notes tag UBTI)
    dm:producesUBTI true ;
    # assumed: the donor placed the lien; its age is not given ;
    dm:transferor td:Founder ; dm:transferredSubjectToLien true .

