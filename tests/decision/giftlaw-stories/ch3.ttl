    dm:storySection "3.1.9" ;
    dm:storyKind "example" ;
    dm:pageSays "In a short-term education trust the first students’ vested interests get annual exclusions; the rest uses exemption, and the kiddie tax limits income shifting." ;
    dm:citesAuthority "PLR 8637084; Reg. 25.2503-3(b); Reg. 25.2503-3(c) Ex. 3; Sec. 1(g)" ;
