:S3_22 a dm:StoryCase ;
    dm:storyId "S3-22" ;
    dm:storySection "3.1.9" ;
    dm:storyKind "private letter ruling" ;
    dm:pageSays "A retained power to revoke students’ interests makes each year’s payment a completed gift under that year’s exclusion; death during the term brings estate inclusion." ;
    dm:citesAuthority "PLR 8949061; Reg. 25.2511-2(f); Reg. 1.664-3(a)(5); Sec. 2036(a)(2)" ;
    dm:pageOutcome dm:Allow ;
