{
 "about": "Known-bad cases for every check in this repo. See README.md. Each mutant must turn its check red.",
 "workflows": ".github/workflows",
 "discover": [
  {
   "glob": [
    "*.py",
    "*.sh",
    "*.mjs"
   ],
   "not": [
    ".github/mutation/*"
   ]
  }
 ],
 "exempt": [
  {
   "path": "extract_authority.py",
   "why": "generator: writes the compliance layer; validate_separated checks its output"
  },
  {
   "path": "extract_semantic.py",
   "why": "generator: writes the vocabulary layer; validate_separated checks its output"
  },
  {
   "path": "fast_sparql.py",
   "why": "helper imported by the checks; no verdict of its own"
  },
  {
   "path": "sync-wiki.sh",
   "why": "publisher: copies pages to the wiki; no verdict"
  },
  {
   "path": "formal/keystone/chart/view.mjs",
   "why": "viewer for the keystone chart; no verdict"
  },
  {
   "path": "validate_ontology.py",
   "why": "prints syntax and counts for one file; its parse is also done by owl-lint and separated"
  }
 ],
 "checks": [
  {
   "id": "owl-lint",
   "source": [
    "validate_owl_lint.py"
   ],
   "run": "python3 validate_owl_lint.py",
   "mutants": [
    {
     "id": "L1-hasValue-class",
     "why": "a restriction whose hasValue points at a class must be flagged (L1)",
     "file": "zz-mutant.ttl",
     "write": "@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix ex: <urn:mutant#> .\nex:C a owl:Class .\nex:R a owl:Restriction ; owl:onProperty ex:p ; owl:hasValue ex:C .\n",
     "expect": "L1"
    },
    {
     "id": "L2-on-rdf-type",
     "why": "a restriction on rdf:type must be flagged (L2)",
     "file": "zz-mutant.ttl",
     "write": "@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix ex: <urn:mutant#> .\nex:C a owl:Class .\nex:R a owl:Restriction ; owl:onProperty rdf:type ; owl:someValuesFrom ex:C .\n",
     "expect": "L2"
    },
    {
     "id": "L3-two-properties",
     "why": "one restriction with two onProperty values must be flagged (L3)",
     "file": "zz-mutant.ttl",
     "write": "@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix ex: <urn:mutant#> .\nex:R a owl:Restriction ; owl:onProperty ex:p , ex:q ; owl:someValuesFrom ex:C .\n",
     "expect": "L3"
    }
   ]
  },
  {
   "id": "owl-lint-decision",
   "source": [],
   "run": "python3 validate_owl_lint.py decision/*.ttl tests/decision/*.ttl tests/decision/giftlaw-stories/*.ttl",
   "mutants": [
    {
     "id": "L3-in-decision-model",
     "why": "a malformed restriction added to a decision file must be flagged",
     "file": "decision/spend-decision-model.ttl",
     "append": "\n[] a <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <urn:mutant#p> , <urn:mutant#q> .\n",
     "expect": "L3"
    }
   ]
  },
  {
   "id": "keystone-shapes",
   "source": [
    "validate_keystone.py",
    "trust-domain-keystone-shapes.ttl"
   ],
   "run": "python3 validate_keystone.py",
   "mutants": [
    {
     "id": "pay-over-market-x100",
     "why": "pay 100 times the market benchmark must still fail the reasonable-pay check (4941(d)(2)(E))",
     "file": "trust-domain-keystone-shapes.ttl",
     "find": "FILTER ( ?value > ?limit )",
     "replace": "FILTER ( ?value > ?limit * 100 )",
     "expect": "expected"
    }
   ]
  },
  {
   "id": "decide-spend-A",
   "source": [
    "decide_spend.py",
    "decision/spend-decision-shapes.ttl"
   ],
   "run": "python3 decide_spend.py",
   "mutants": [
    {
     "id": "limit-plus-1000",
     "why": "a holding over the 4943 line must still be flagged when the line is moved up 1000 points (a multiplier tightens a negative limit, so add)",
     "file": "decision/spend-decision-shapes.ttl",
     "find": "FILTER ( ?value > 0 && ?value > ?limit )",
     "replace": "FILTER ( ?value > 0 && ?value > ?limit + 1000 )",
     "expect": "mismatch"
    }
   ]
  },
  {
   "id": "decide-spend-B",
   "source": [],
   "run": "python3 decide_spend.py --branch B",
   "mutants": [
    {
     "id": "limit-plus-1000",
     "why": "the same loosened limit must fail the branch B answer key too",
     "file": "decision/spend-decision-shapes.ttl",
     "find": "FILTER ( ?value > 0 && ?value > ?limit )",
     "replace": "FILTER ( ?value > 0 && ?value > ?limit + 1000 )",
     "expect": "mismatch"
    }
   ]
  },
  {
