:IRC_671_679 rdf:type owl:Class ;
    rdfs:subClassOf :IRCSection ;
    rdfs:label "IRC §§671-679"@en ;
    rdfs:comment "Control-of-income boundary - determines who is the economic operator, the gateway to non-grantor status"@en .

###  http://example.org/trust-domain#IRC_641_685
:IRC_641_685 rdf:type owl:Class ;
    rdfs:subClassOf :IRCSection ;
    rdfs:label "IRC §§641-685"@en ;
    rdfs:comment "Trust as autonomous accounting system - enables trust to retain income, deploy expenses, distribute outputs"@en .

###  http://example.org/trust-domain#IRC_7701
:IRC_7701 rdf:type owl:Class ;
    rdfs:subClassOf :IRCSection ;
    rdfs:label "IRC §7701"@en ;
    rdfs:comment "Jurisdictional identity - assigns which sovereign's rules apply via court and control tests"@en .

