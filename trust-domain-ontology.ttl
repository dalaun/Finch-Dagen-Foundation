:IRC_67e rdf:type owl:Class ;
    rdfs:subClassOf :IRCSection ;
    rdfs:label "IRC §67(e)"@en ;
    rdfs:comment "Trust-specific expenses that would not exist but for fiduciary status"@en .

###  http://example.org/trust-domain#Pub_15
:Pub_15 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 15"@en ;
    rdfs:comment "Control-plane for human engagement - how labor attaches to systems of authority"@en .

###  http://example.org/trust-domain#Pub_15B
:Pub_15B rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 15-B"@en ;
    rdfs:comment "Taxonomy of fringe benefits as compensation modality"@en .

###  http://example.org/trust-domain#Pub_463
:Pub_463 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 463"@en ;
    rdfs:comment "Mobility as execution primitive - movement as infrastructure"@en .

###  http://example.org/trust-domain#Pub_535
:Pub_535 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 535"@en ;
    rdfs:comment "Cost of producing capability - what systems consume to exist"@en .

###  http://example.org/trust-domain#Pub_557
:Pub_557 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 557"@en ;
    rdfs:comment "Legitimacy of exempt authority - why power is allowed to exist"@en .

###  http://example.org/trust-domain#Pub_583
:Pub_583 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 583"@en ;
    rdfs:comment "System genesis - bringing economic system into lawful existence"@en .

###  http://example.org/trust-domain#Pub_946
:Pub_946 rdf:type owl:Class ;
    rdfs:subClassOf :IRSPublication ;
    rdfs:label "Publication 946"@en ;
    rdfs:comment "Time-binding of assets - how long-lived assets are consumed over time"@en .

###  http://example.org/trust-domain#OperationalActivity
:OperationalActivity rdf:type owl:Class ;
    rdfs:label "Operational Activity"@en ;
    rdfs:comment "Activity conducted by the trust entity"@en .

###  http://example.org/trust-domain#TradeOrBusiness
:TradeOrBusiness rdf:type owl:Class ;
    rdfs:subClassOf :OperationalActivity ;
    rdfs:label "Trade or Business"@en ;
    rdfs:comment "Activity conducted for profit or mission"@en .

###  http://example.org/trust-domain#OperatingBoundary
:OperatingBoundary rdf:type owl:Class ;
    rdfs:label "Operating Boundary"@en ;
    rdfs:comment "The perimeter defining what belongs inside the system"@en .

###  http://example.org/trust-domain#Expenditure
:Expenditure rdf:type owl:Class ;
    rdfs:label "Expenditure"@en ;
    rdfs:comment "Cost incurred by the trust entity"@en .

###  http://example.org/trust-domain#OrdinaryAndNecessaryExpense
:OrdinaryAndNecessaryExpense rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :isOrdinaryAndNecessary ;
          owl:hasValue "true"^^xsd:boolean
        ] ;
    rdfs:label "Ordinary and Necessary Expense"@en ;
    rdfs:comment "Expense within the operating boundary (IRC §162)"@en .

###  http://example.org/trust-domain#CapitalExpenditure
:CapitalExpenditure rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :isCapitalExpense ;
          owl:hasValue "true"^^xsd:boolean
        ] ;
    rdfs:label "Capital Expenditure"@en ;
    rdfs:comment "Expenditure creating long-lived asset (IRC §263)"@en .

###  http://example.org/trust-domain#Asset
:Asset rdf:type owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "Resource controlled by trust entity"@en .

###  http://example.org/trust-domain#TangibleAsset
:TangibleAsset rdf:type owl:Class ;
    rdfs:subClassOf :Asset ;
    rdfs:label "Tangible Asset"@en .

###  http://example.org/trust-domain#IntangibleAsset
:IntangibleAsset rdf:type owl:Class ;
    rdfs:subClassOf :Asset ;
    rdfs:label "Intangible Asset"@en .

###  http://example.org/trust-domain#DepreciableAsset
:DepreciableAsset rdf:type owl:Class ;
    rdfs:subClassOf :Asset ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :hasUsefulLife ;
          owl:someValuesFrom xsd:integer
        ] ;
    rdfs:label "Depreciable Asset"@en ;
    rdfs:comment "Asset consumed over time (Pub 946)"@en .

###  http://example.org/trust-domain#HumanCapability
:HumanCapability rdf:type owl:Class ;
    rdfs:label "Human Capability"@en ;
    rdfs:comment "Human labor and skill engaged by trust"@en .

###  http://example.org/trust-domain#Employee
:Employee rdf:type owl:Class ;
    rdfs:subClassOf :HumanCapability ;
    rdfs:label "Employee"@en ;
    rdfs:comment "Human capability under employer authority and control"@en .

###  http://example.org/trust-domain#IndependentContractor
:IndependentContractor rdf:type owl:Class ;
    rdfs:subClassOf :HumanCapability ;
    rdfs:label "Independent Contractor"@en .

###  http://example.org/trust-domain#Beneficiary
:Beneficiary rdf:type owl:Class ;
    rdfs:label "Beneficiary"@en ;
    rdfs:comment "Person or entity with beneficial interest in trust"@en .

###  http://example.org/trust-domain#Trustee
:Trustee rdf:type owl:Class ;
    rdfs:label "Trustee"@en ;
    rdfs:comment "Fiduciary holding legal title and authority"@en .

###  http://example.org/trust-domain#Protector
:Protector rdf:type owl:Class ;
    rdfs:label "Protector"@en ;
    rdfs:comment "Person or entity overseeing trustee actions"@en .

###  http://example.org/trust-domain#Grantor
:Grantor rdf:type owl:Class ;
    rdfs:label "Grantor"@en ;
    rdfs:comment "Person or entity establishing the trust"@en .

###  http://example.org/trust-domain#SafeguardMechanism
:SafeguardMechanism rdf:type owl:Class ;
    rdfs:label "Safeguard Mechanism"@en ;
    rdfs:comment "Structural constraint preventing fiduciary power collapse"@en .

###  http://example.org/trust-domain#SelfDealingProhibition
:SelfDealingProhibition rdf:type owl:Class ;
    rdfs:subClassOf :SafeguardMechanism ;
    rdfs:label "Self-Dealing Prohibition"@en ;
    rdfs:comment "Prevents transactions between fiduciary and trust (IRC §4941)"@en .

###  http://example.org/trust-domain#ExcessBenefitTest
:ExcessBenefitTest rdf:type owl:Class ;
    rdfs:subClassOf :SafeguardMechanism ;
    rdfs:label "Excess Benefit Test"@en ;
    rdfs:comment "Prevents excessive compensation or benefits"@en .

###  http://example.org/trust-domain#JeopardizingInvestmentRule
:JeopardizingInvestmentRule rdf:type owl:Class ;
    rdfs:subClassOf :SafeguardMechanism ;
    rdfs:label "Jeopardizing Investment Rule"@en ;
    rdfs:comment "Prevents reckless investment endangering mission (IRC §4944)"@en .

###  http://example.org/trust-domain#AuthorityCollapse
:AuthorityCollapse rdf:type owl:Class ;
    rdfs:label "Authority Collapse"@en ;
    rdfs:comment "Misuse or abuse of fiduciary authority"@en .

###  http://example.org/trust-domain#PrivateInurement
:PrivateInurement rdf:type owl:Class ;
    rdfs:subClassOf :AuthorityCollapse ;
    rdfs:label "Private Inurement"@en ;
    rdfs:comment "Improper private benefit from exempt organization"@en .

###  http://example.org/trust-domain#PrivateBenefit
:PrivateBenefit rdf:type owl:Class ;
    rdfs:subClassOf :AuthorityCollapse ;
    rdfs:label "Private Benefit"@en ;
    rdfs:comment "Excessive benefit to private interests"@en .

###  http://example.org/trust-domain#NonGrantorTrustSystem
:NonGrantorTrustSystem rdf:type owl:Class ;
    rdfs:subClassOf :TrustEntity ;
    rdfs:label "Non-Grantor Trust System"@en ;
    rdfs:comment "Trust that has crossed the IRC §§671-679 gateway - no retained control powers, operates as autonomous system"@en .

###  http://example.org/trust-domain#ControlPower
:ControlPower rdf:type owl:Class ;
    rdfs:label "Control Power"@en ;
    rdfs:comment "Enumerated power under IRC §§671-679 that triggers grantor trust attribution if retained"@en .

###  http://example.org/trust-domain#ReversionaryInterest
:ReversionaryInterest rdf:type owl:Class ;
    rdfs:subClassOf :ControlPower ;
    rdfs:label "Reversionary Interest"@en ;
    rdfs:comment "Power causing trust assets to revert to grantor (IRC §673)"@en .

###  http://example.org/trust-domain#PowerToControlBeneficialEnjoyment
:PowerToControlBeneficialEnjoyment rdf:type owl:Class ;
    rdfs:subClassOf :ControlPower ;
    rdfs:label "Power to Control Beneficial Enjoyment"@en ;
    rdfs:comment "Power over beneficial enjoyment without trustee approval (IRC §674)"@en .

###  http://example.org/trust-domain#AdministrativePower
:AdministrativePower rdf:type owl:Class ;
    rdfs:subClassOf :ControlPower ;
    rdfs:label "Administrative Power"@en ;
    rdfs:comment "Administrative powers exercisable for grantor benefit (IRC §675)"@en .

###  http://example.org/trust-domain#PowerToRevoke
:PowerToRevoke rdf:type owl:Class ;
    rdfs:subClassOf :ControlPower ;
    rdfs:label "Power to Revoke"@en ;
    rdfs:comment "Power to revoke trust and revest corpus in grantor (IRC §676)"@en .

###  http://example.org/trust-domain#IncomeForGrantorBenefit
:IncomeForGrantorBenefit rdf:type owl:Class ;
    rdfs:subClassOf :ControlPower ;
    rdfs:label "Income for Grantor Benefit"@en ;
    rdfs:comment "Trust income held for grantor or spouse benefit (IRC §677)"@en .

###  http://example.org/trust-domain#DistributableNetIncome
:DistributableNetIncome rdf:type owl:Class ;
    rdfs:label "Distributable Net Income (DNI)"@en ;
    rdfs:comment "Trust accounting concept limiting deductible distributions and carrying income character (IRC §§643, 661-663)"@en .

###  http://example.org/trust-domain#Distribution
:Distribution rdf:type owl:Class ;
    rdfs:label "Distribution"@en ;
    rdfs:comment "Transfer of income or corpus from trust to beneficiary"@en .

###  http://example.org/trust-domain#IncomeDistribution
:IncomeDistribution rdf:type owl:Class ;
    rdfs:subClassOf :Distribution ;
    rdfs:label "Income Distribution"@en ;
    rdfs:comment "Distribution of current income"@en .

###  http://example.org/trust-domain#CorpusDistribution
:CorpusDistribution rdf:type owl:Class ;
    rdfs:subClassOf :Distribution ;
    rdfs:label "Corpus Distribution"@en ;
    rdfs:comment "Distribution of principal/corpus"@en .

###  http://example.org/trust-domain#CharacterFlowThrough
:CharacterFlowThrough rdf:type owl:Class ;
    rdfs:label "Character Flow-Through"@en ;
    rdfs:comment "Income character (ordinary, capital gain, etc.) that flows through distribution to beneficiary"@en .

###  http://example.org/trust-domain#FiduciaryReturn
:FiduciaryReturn rdf:type owl:Class ;
    rdfs:subClassOf :Evidence ;
    rdfs:label "Fiduciary Return (Form 1041)"@en ;
    rdfs:comment "Annual income tax return filed by trust (Form 1041 for domestic, 1040-NR for foreign)"@en .

###  http://example.org/trust-domain#ScheduleK1
:ScheduleK1 rdf:type owl:Class ;
    rdfs:subClassOf :Evidence ;
    rdfs:label "Schedule K-1"@en ;
    rdfs:comment "Beneficiary statement showing distributed income and character"@en .

###  http://example.org/trust-domain#TrustAccounting
:TrustAccounting rdf:type owl:Class ;
    rdfs:subClassOf :Evidence ;
    rdfs:label "Trust Accounting"@en ;
    rdfs:comment "Fiduciary accounting records distinguishing income from principal"@en .

###  http://example.org/trust-domain#JurisdictionalTest
:JurisdictionalTest rdf:type owl:Class ;
    rdfs:label "Jurisdictional Test"@en ;
    rdfs:comment "Test under IRC §7701(a)(30)-(31) determining domestic vs foreign status"@en .

###  http://example.org/trust-domain#CourtTest
:CourtTest rdf:type owl:Class ;
    rdfs:subClassOf :JurisdictionalTest ;
    rdfs:label "Court Test"@en ;
    rdfs:comment "Test whether US court can exercise primary supervision over trust administration"@en .

###  http://example.org/trust-domain#ControlTest
:ControlTest rdf:type owl:Class ;
    rdfs:subClassOf :JurisdictionalTest ;
    rdfs:label "Control Test"@en ;
    rdfs:comment "Test whether one or more US persons control all substantial trust decisions"@en .

###  http://example.org/trust-domain#DomesticTrust
:DomesticTrust rdf:type owl:Class ;
    rdfs:subClassOf :TrustStructure ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :isDomestic ;
          owl:hasValue "true"^^xsd:boolean
        ] ;
    rdfs:label "Domestic Trust"@en ;
    rdfs:comment "Trust satisfying both court and control tests under IRC §7701(a)(30)"@en .

###  http://example.org/trust-domain#SystemIdentifier
:SystemIdentifier rdf:type owl:Class ;
    rdfs:label "System Identifier"@en ;
    rdfs:comment "Identifier enabling trust interaction with authorities - NOT an instrument, analogous to MAC address not protocol"@en .

###  http://example.org/trust-domain#EIN
:EIN rdf:type owl:Class ;
    rdfs:subClassOf :SystemIdentifier ;
    rdfs:label "EIN (Employer Identification Number)"@en ;
    rdfs:comment "Tax identifier for trust entity - required for interaction, meaningless without doctrinal stack"@en .

###  http://example.org/trust-domain#IncomeProductionExpense
:IncomeProductionExpense rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ;
    rdfs:label "Income Production Expense"@en ;
    rdfs:comment "Expense for income production without trade or business (IRC §212)"@en .

###  http://example.org/trust-domain#FiduciarySpecificExpense
:FiduciarySpecificExpense rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ;
    rdfs:label "Fiduciary-Specific Expense"@en ;
    rdfs:comment "Expense that would not exist but for fiduciary status (IRC §67(e))"@en .

###  http://example.org/trust-domain#PrivateEnablement
:PrivateEnablement rdf:type owl:Class ;
    rdfs:label "Private Enablement"@en ;
    rdfs:comment "Any benefit, compensation, or resource provided to private individuals (employees, contractors, beneficiaries, etc.) by the trust entity"@en .

###  http://example.org/trust-domain#PermissiblePrivateEnablement
:PermissiblePrivateEnablement rdf:type owl:Class ;
    rdfs:subClassOf :PrivateEnablement ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :isIncidentalTo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ] ,
        [ rdf:type owl:Restriction ;
          owl:onProperty :isInseparableFrom ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ] ;
    rdfs:label "Permissible Private Enablement"@en ;
    rdfs:comment "Private enablement that is BOTH incidental to AND inseparable from purpose-driven execution - the ONLY permissible form per the keystone constraint"@en .

###  http://example.org/trust-domain#ImproperPrivateEnablement
:ImproperPrivateEnablement rdf:type owl:Class ;
    rdfs:subClassOf :PrivateEnablement ;
    owl:disjointWith :PermissiblePrivateEnablement ;
    rdfs:label "Improper Private Enablement"@en ;
    rdfs:comment "Private enablement that fails the keystone constraint - either not incidental to purpose OR separable from execution. This constitutes private inurement or excessive private benefit."@en .

###  http://example.org/trust-domain#KeystoneConstraint
:KeystoneConstraint rdf:type owl:Class ;
    rdfs:label "Keystone Constraint"@en ;
    rdfs:comment "The fundamental constraint governing all private enablement: Private enablement is permissible when and only when it is BOTH incidental to AND inseparable from purpose-driven execution. This is the boundary between legitimate operations and private inurement."@en .

###  http://example.org/trust-domain#IncidentalityTest
:IncidentalityTest rdf:type owl:Class ;
    rdfs:subClassOf :KeystoneConstraint ;
    rdfs:label "Incidentality Test"@en ;
    rdfs:comment "Tests whether private enablement is incidental to (not the primary purpose of) the operational activity"@en .

###  http://example.org/trust-domain#InseparabilityTest
:InseparabilityTest rdf:type owl:Class ;
    rdfs:subClassOf :KeystoneConstraint ;
    rdfs:label "Inseparability Test"@en ;
    rdfs:comment "Tests whether private enablement is inseparable from (necessarily coupled with) purpose-driven execution"@en .

###  http://example.org/trust-domain#EmployeeCompensationEnablement
:EmployeeCompensationEnablement rdf:type owl:Class ;
    rdfs:subClassOf :PrivateEnablement ;
    rdfs:label "Employee Compensation Enablement"@en ;
    rdfs:comment "Compensation to employees. Being compensation does NOT make it permissible: the keystone check (trust-domain-keystone-shapes.ttl) decides that from linked evidence and amount."@en .

###  http://example.org/trust-domain#OperationalBenefitEnablement
:OperationalBenefitEnablement rdf:type owl:Class ;
    rdfs:subClassOf :PrivateEnablement ;
    rdfs:label "Operational Benefit Enablement"@en ;
    rdfs:comment "Benefits (health insurance, retirement, etc.) to staff. Being a benefit does NOT make it permissible: the keystone check (trust-domain-keystone-shapes.ttl) decides that from linked evidence and amount."@en .

###  http://example.org/trust-domain#BeneficiaryDistributionEnablement
:BeneficiaryDistributionEnablement rdf:type owl:Class ;
    rdfs:subClassOf :PrivateEnablement ;
    rdfs:label "Beneficiary Distribution Enablement"@en ;
    rdfs:comment "Distributions to trust beneficiaries - may be permissible or improper depending on keystone constraint satisfaction"@en .

###  http://example.org/trust-domain#AuthorizedActivity
:AuthorizedActivity rdf:type owl:Class ;
    rdfs:subClassOf :OperationalActivity ;
    rdfs:label "Authorized Activity"@en ;
    rdfs:comment "Operational activity explicitly authorized by a purpose domain in the mission - this is what the trust is allowed to do"@en .

###  http://example.org/trust-domain#OperatorInRole
:OperatorInRole rdf:type owl:Class ;
    rdfs:label "Operator In Role"@en ;
    rdfs:comment "A human capability (employee, contractor, etc.) operating in a specific role to execute authorized activities"@en .

###  http://example.org/trust-domain#Role
:Role rdf:type owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A defined function or position within the trust's operational structure"@en .

###  http://example.org/trust-domain#ResearchScientistRole
:ResearchScientistRole rdf:type owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Research Scientist Role"@en ;
    rdfs:comment "Role of research scientist conducting studies and experiments"@en .

###  http://example.org/trust-domain#ProgramDirectorRole
:ProgramDirectorRole rdf:type owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Program Director Role"@en ;
    rdfs:comment "Role of program director managing charitable programs"@en .

###  http://example.org/trust-domain#EducatorRole
:EducatorRole rdf:type owl:Class ;
    rdfs:subClassOf :Role ;
    rdfs:label "Educator Role"@en ;
    rdfs:comment "Role of educator providing education services"@en .

###  http://example.org/trust-domain#ExpenseDomain
:ExpenseDomain rdf:type owl:Class ;
    rdfs:label "Expense Domain"@en ;
    rdfs:comment "A category of expense/enablement necessary to sustain operators - this is WHERE private enablement occurs (compensation domain, benefits domain, etc.)"@en .

###  http://example.org/trust-domain#CompensationDomain
:CompensationDomain rdf:type owl:Class ;
    rdfs:subClassOf :ExpenseDomain ;
    rdfs:label "Compensation Domain"@en ;
    rdfs:comment "Domain of wages, salaries, and direct compensation"@en .

###  http://example.org/trust-domain#BenefitsDomain
:BenefitsDomain rdf:type owl:Class ;
    rdfs:subClassOf :ExpenseDomain ;
    rdfs:label "Benefits Domain"@en ;
    rdfs:comment "Domain of employee benefits (health, retirement, etc.)"@en .

###  http://example.org/trust-domain#ProfessionalDevelopmentDomain
:ProfessionalDevelopmentDomain rdf:type owl:Class ;
    rdfs:subClassOf :ExpenseDomain ;
    rdfs:label "Professional Development Domain"@en ;
    rdfs:comment "Domain of training, education, and capability enhancement"@en .

###  http://example.org/trust-domain#OperationalSupportDomain
:OperationalSupportDomain rdf:type owl:Class ;
    rdfs:subClassOf :ExpenseDomain ;
    rdfs:label "Operational Support Domain"@en ;
    rdfs:comment "Domain of tools, equipment, workspace, and operational support"@en .

###  http://example.org/trust-domain#ActualSpend
:ActualSpend rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ;
    rdfs:label "Actual Spend"@en ;
    rdfs:comment "Concrete expenditure - the actual dollars spent, traceable back through the authority cascade to mission"@en .

###  http://example.org/trust-domain#AuthorityCascade
:AuthorityCascade rdf:type owl:Class ;
    rdfs:label "Authority Cascade"@en ;
    rdfs:comment "The complete traceable chain: Mission → Purpose Domains → Authorized Activities → Operators in Role → Expense Domains → Actual Spend. This cascade PROVES keystone constraint satisfaction."@en .

###  http://example.org/trust-domain#TemporalPeriod
:TemporalPeriod rdf:type owl:Class ;
    rdfs:label "Temporal Period"@en ;
    rdfs:comment "A time interval during which activities occur and expenditures are made"@en .

###  http://example.org/trust-domain#FiscalYear
:FiscalYear rdf:type owl:Class ;
    rdfs:subClassOf :TemporalPeriod ;
    rdfs:label "Fiscal Year"@en ;
    rdfs:comment "12-month accounting period for trust operations, DNI computation, and distribution requirements"@en .

###  http://example.org/trust-domain#Quarter
:Quarter rdf:type owl:Class ;
    rdfs:subClassOf :TemporalPeriod ;
    rdfs:label "Quarter"@en ;
    rdfs:comment "3-month period within fiscal year"@en .

###  http://example.org/trust-domain#Month
:Month rdf:type owl:Class ;
    rdfs:subClassOf :TemporalPeriod ;
    rdfs:label "Month"@en ;
    rdfs:comment "Monthly period for operational tracking"@en .

###  http://example.org/trust-domain#GrantmakingActivity
:GrantmakingActivity rdf:type owl:Class ;
    rdfs:subClassOf :AuthorizedActivity ;
    rdfs:label "Grantmaking Activity"@en ;
    rdfs:comment "Activity of making charitable grants to advance mission - DISTINCT from operations"@en .

###  http://example.org/trust-domain#Grant
:Grant rdf:type owl:Class ;
    rdfs:label "Grant"@en ;
    rdfs:comment "Charitable grant made to grantee to advance exempt purpose"@en .

###  http://example.org/trust-domain#ProgramRelatedInvestment
:ProgramRelatedInvestment rdf:type owl:Class ;
    rdfs:subClassOf :Grant ;
    rdfs:label "Program-Related Investment (PRI)"@en ;
    rdfs:comment "Investment primarily to accomplish charitable purpose, not investment return"@en .

###  http://example.org/trust-domain#Grantee
:Grantee rdf:type owl:Class ;
    rdfs:label "Grantee"@en ;
    rdfs:comment "Organization or individual receiving charitable grant"@en .

###  http://example.org/trust-domain#PublicCharity
:PublicCharity rdf:type owl:Class ;
    rdfs:subClassOf :Grantee ;
    rdfs:label "Public Charity"@en ;
    rdfs:comment "IRC §509(a) public charity - qualifying grantee"@en .

###  http://example.org/trust-domain#NonExemptGrantee
:NonExemptGrantee rdf:type owl:Class ;
    rdfs:subClassOf :Grantee ;
    rdfs:label "Non-Exempt Grantee"@en ;
    rdfs:comment "Non-exempt organization requiring expenditure responsibility"@en .

###  http://example.org/trust-domain#QualifyingDistribution
:QualifyingDistribution rdf:type owl:Class ;
    rdfs:label "Qualifying Distribution"@en ;
    rdfs:comment "Distribution that counts toward IRC §4942 minimum distribution requirement"@en .

###  http://example.org/trust-domain#DisqualifiedPerson
:DisqualifiedPerson rdf:type owl:Class ;
    rdfs:label "Disqualified Person"@en ;
    rdfs:comment "Person defined in IRC §4946 - substantial contributor, foundation manager, or related party"@en .

###  http://example.org/trust-domain#SubstantialContributor
:SubstantialContributor rdf:type owl:Class ;
    rdfs:subClassOf :DisqualifiedPerson ;
    rdfs:label "Substantial Contributor"@en ;
    rdfs:comment "Person who contributed over $5,000 if that exceeds 2% of total contributions"@en .

###  http://example.org/trust-domain#FoundationManager
:FoundationManager rdf:type owl:Class ;
    rdfs:subClassOf :DisqualifiedPerson ;
    rdfs:label "Foundation Manager"@en ;
    rdfs:comment "Officer, director, trustee, or person with similar powers"@en .

###  http://example.org/trust-domain#Transaction
:Transaction rdf:type owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "Any exchange, transfer, or dealing involving trust assets or income"@en .

###  http://example.org/trust-domain#SelfDealingTransaction
:SelfDealingTransaction rdf:type owl:Class ;
    rdfs:subClassOf :Transaction ;
    rdfs:label "Self-Dealing Transaction"@en ;
    rdfs:comment "Transaction between foundation and disqualified person - PROHIBITED under IRC §4941"@en .

###  http://example.org/trust-domain#PermittedTransaction
:PermittedTransaction rdf:type owl:Class ;
    rdfs:subClassOf :Transaction ;
    owl:disjointWith :SelfDealingTransaction ;
    rdfs:label "Permitted Transaction"@en ;
    rdfs:comment "Transaction that does not involve self-dealing or is explicitly permitted"@en .

###  http://example.org/trust-domain#ExcessBenefit
:ExcessBenefit rdf:type owl:Class ;
    rdfs:label "Excess Benefit"@en ;
    rdfs:comment "Benefit exceeding fair market value provided to disqualified person"@en .

###  http://example.org/trust-domain#Investment
:Investment rdf:type owl:Class ;
    rdfs:label "Investment"@en ;
    rdfs:comment "Trust investment in securities, property, or business interests"@en .

###  http://example.org/trust-domain#JeopardizingInvestment
:JeopardizingInvestment rdf:type owl:Class ;
    rdfs:subClassOf :Investment ;
    rdfs:label "Jeopardizing Investment"@en ;
    rdfs:comment "Investment that jeopardizes carrying out exempt purpose - PROHIBITED under IRC §4944"@en .

###  http://example.org/trust-domain#PrudentInvestment
:PrudentInvestment rdf:type owl:Class ;
    rdfs:subClassOf :Investment ;
    owl:disjointWith :JeopardizingInvestment ;
    rdfs:label "Prudent Investment"@en ;
    rdfs:comment "Investment exercising ordinary business care and prudence"@en .

###  http://example.org/trust-domain#ExcessBusinessHolding
:ExcessBusinessHolding rdf:type owl:Class ;
    rdfs:label "Excess Business Holding"@en ;
    rdfs:comment "Business holdings exceeding permitted percentage - PROHIBITED under IRC §4943"@en .

###  http://example.org/trust-domain#PermittedBusinessHolding
:PermittedBusinessHolding rdf:type owl:Class ;
    rdfs:subClassOf :Investment ;
    rdfs:label "Permitted Business Holding"@en ;
    rdfs:comment "Business holding within IRC §4943 limits (generally 20% or 2% depending on control)"@en .

###  http://example.org/trust-domain#TaxableExpenditure
:TaxableExpenditure rdf:type owl:Class ;
    rdfs:subClassOf :Expenditure ;
    rdfs:label "Taxable Expenditure"@en ;
    rdfs:comment "Expenditure for prohibited purpose under IRC §4945 (lobbying, political, non-charitable grants without expenditure responsibility)"@en .

###  http://example.org/trust-domain#LobbyingExpenditure
:LobbyingExpenditure rdf:type owl:Class ;
    rdfs:subClassOf :TaxableExpenditure ;
    rdfs:label "Lobbying Expenditure"@en ;
    rdfs:comment "Expenditure to influence legislation - taxable under IRC §4945"@en .

###  http://example.org/trust-domain#PoliticalExpenditure
:PoliticalExpenditure rdf:type owl:Class ;
    rdfs:subClassOf :TaxableExpenditure ;
    rdfs:label "Political Expenditure"@en ;
    rdfs:comment "Expenditure to influence election or carry on voter registration - taxable under IRC §4945"@en .

###  http://example.org/trust-domain#GrantWithoutExpenditureResponsibility
:GrantWithoutExpenditureResponsibility rdf:type owl:Class ;
    rdfs:subClassOf :TaxableExpenditure ;
    rdfs:label "Grant Without Expenditure Responsibility"@en ;
    rdfs:comment "Grant to non-qualifying organization without required oversight - taxable under IRC §4945"@en .

#################################################################
#    Restrictions and Axioms
#################################################################

###  Foreign Private Irrevocable Non-Grantor Trust must have Trustee
:ForeignPrivateIrrevocableNonGrantorTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasTrustee ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Every Instrument must be governed by at least one DoctrinalSource
:Instrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Every Instrument must be substantiated by Evidence
:Instrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :substantiatedBy ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Accountable Plan requires substantiation and return of excess
:AccountablePlan rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresEvidence ;
      owl:someValuesFrom :BusinessRecords
    ] .

###  Reimbursement Instrument must follow Accountable Plan
:ReimbursementInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresEvidence ;
      owl:someValuesFrom :AccountablePlan
    ] .

###  Operational Activity must advance a Purpose
:OperationalActivity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :advancesPurpose ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Operational Activity within boundary must be Ordinary and Necessary
[ rdf:type owl:Restriction ;
  owl:onProperty :withinBoundary ;
  owl:someValuesFrom :OperatingBoundary
] rdfs:subClassOf :OrdinaryAndNecessaryExpense .

###  Safeguard Mechanisms prevent Authority Collapse
:SafeguardMechanism rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :preventsMisuse ;
      owl:someValuesFrom :AuthorityCollapse
    ] .

###  Trust Entity must exercise Authority
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :exercisesAuthority ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Depreciation Instrument applies to Depreciable Assets
:DepreciationInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :substantiatedBy ;
      owl:someValuesFrom :AssetRecords
    ] .

###  Fringe Benefit governed by Pub 15-B
:FringeBenefit rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_15B
    ] .

###  Wage Instrument governed by Pub 15
:WageInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_15
    ] .

###  Non-Cash Operational Instrument governed by IRC §132
:NonCashOperationalInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_132
    ] .

###  Mobility Instrument governed by Pub 463
:MobilityInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :Pub_463
    ] .

###  Ordinary and Necessary Expense governed by IRC §162
:OrdinaryAndNecessaryExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_162
    ] .

###  Capital Expenditure governed by IRC §263
:CapitalExpenditure rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_263
    ] .

###  Capability Investment governed by IRC §117 or §127
:CapabilityInvestmentInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:someValuesFrom [ rdf:type owl:Class ;
                           owl:unionOf ( :IRC_117 :IRC_127 )
                         ]
    ] .

###  Non-Grantor Trust System - THE GATEWAY under IRC §§671-679
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_671_679
    ] .

###  Non-Grantor Trust operates as autonomous accounting system under IRC §§641-685
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_641_685
    ] .

###  Non-Grantor Trust must have system identifier (EIN)
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasSystemIdentifier ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Non-Grantor Trust must file fiduciary return
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requiresFiling ;
      owl:someValuesFrom :FiduciaryReturn
    ] .

###  Non-Grantor Trust can compute DNI
:NonGrantorTrustSystem rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :computesDNI ;
      owl:someValuesFrom :DistributableNetIncome
    ] .

###  Foreign Trust determined by IRC §7701 jurisdictional tests
[ rdf:type owl:Restriction ;
  owl:onProperty :isForeign ;
  owl:hasValue "true"^^xsd:boolean
] rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_7701
    ] .

###  Domestic Trust must pass both court and control tests
:DomesticTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :passesJurisdictionalTest ;
      owl:minCardinality "2"^^xsd:nonNegativeInteger
    ] .

###  Income Production Expense governed by IRC §212
:IncomeProductionExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_212
    ] .

###  Fiduciary-Specific Expense governed by IRC §67(e)
:FiduciarySpecificExpense rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_67e
    ] .

###  Distribution must flow character through to beneficiary
:Distribution rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :flowsCharacterThrough ;
      owl:someValuesFrom :CharacterFlowThrough
    ] .

###  EIN is NOT an Instrument - disjoint classes
:EIN owl:disjointWith :Instrument .

###  System Identifier is NOT an Instrument - disjoint classes
:SystemIdentifier owl:disjointWith :Instrument .

###  Private Irrevocable Non-Grantor Trust is a Non-Grantor Trust System
:PrivateIrrevocableNonGrantorTrust rdfs:subClassOf :NonGrantorTrustSystem .

###  Foreign Private Irrevocable Non-Grantor Trust governed by IRC §7701
:ForeignPrivateIrrevocableNonGrantorTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :governedBy ;
      owl:hasValue :IRC_7701
    ] .

###  Trust Entity must have Purpose - Purpose legitimizes Authority
:TrustEntity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :hasPurpose ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Exempt Purpose enables use of Charitable Instruments
:ExemptPurpose rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :implementedBy ;
      owl:someValuesFrom :Instrument
    ] .

###  THE KEYSTONE CONSTRAINT - Permissible Private Enablement MUST satisfy both tests
:PermissiblePrivateEnablement rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :satisfiesKeystoneConstraint ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Improper Private Enablement violates the Keystone Constraint
:ImproperPrivateEnablement rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :violatesKeystoneConstraint ;
      owl:someValuesFrom :KeystoneConstraint
    ] .

###  Improper Private Enablement leads to Authority Collapse (Private Inurement)
:ImproperPrivateEnablement rdfs:subClassOf :PrivateInurement .

###  Compensation Instruments may enable privately - must satisfy Keystone Constraint
:CompensationInstrument rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :enablesPrivately ;
      owl:someValuesFrom :PrivateEnablement
    ] .

###  (Removed in the keystone fix: four axioms that made every compensation and benefit
###  incidental and inseparable by category. The keystone check now derives that from evidence.)

###  Keystone Constraint prevents Authority Collapse
:KeystoneConstraint rdfs:subClassOf :SafeguardMechanism .

###  THE AUTHORITY CASCADE - Enforcing the traceable chain

###  Authorized Activity MUST be authorized by a Purpose
:AuthorizedActivity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty [ owl:inverseOf :authorizes ] ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Authorized Activity MUST require at least one Operator in Role
:AuthorizedActivity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :requires ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Operator in Role MUST serve an Authorized Activity
:OperatorInRole rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :servesActivity ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Operator in Role MUST necessitate at least one Expense Domain
:OperatorInRole rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :necessitates ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Expense Domain MUST sustain an Operator in Role
:ExpenseDomain rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :sustains ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Expense Domain MUST manifest as Actual Spend
:ExpenseDomain rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :manifestsAs ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Actual Spend MUST trace back to a Purpose (PROOF of keystone constraint)
:ActualSpend rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :tracesBackTo ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Purpose legitimizes Authority - without Purpose, no Authority
:Purpose rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :legitimizes ;
      owl:someValuesFrom :Authority
    ] .

###  Expense Domain is a type of Private Enablement
:ExpenseDomain rdfs:subClassOf :PrivateEnablement .

###  Compensation Domain creates Employee Compensation Enablement
:CompensationDomain rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :enablesPrivately ;
      owl:someValuesFrom :EmployeeCompensationEnablement
    ] .

###  Benefits Domain creates Operational Benefit Enablement
:BenefitsDomain rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :enablesPrivately ;
      owl:someValuesFrom :OperationalBenefitEnablement
    ] .

###  TEMPORAL AXIOMS - Expenditures and DNI bound to time

###  Actual Spend MUST occur during a temporal period
:ActualSpend rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :occursDuring ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  DNI MUST be computed for a fiscal year
:DistributableNetIncome rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :computedFor ;
      owl:someValuesFrom :FiscalYear
    ] .

###  Fiscal Year MUST have start and end dates
:FiscalYear rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :fiscalYearStart ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ rdf:type owl:Restriction ;
      owl:onProperty :fiscalYearEnd ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

###  GRANTMAKING AXIOMS - Grants distinct from operations

###  Grantmaking Activity MUST produce Grants
:GrantmakingActivity rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty [ owl:inverseOf :makesGrant ] ;
      owl:someValuesFrom :Grant
    ] .

###  Grant MUST be received by Grantee
:Grant rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty [ owl:inverseOf :receivesGrant ] ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Grant MUST have amount
:Grant rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :grantAmount ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Grant to Public Charity is Qualifying Distribution
:Grant rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :receivesGrant ;
      owl:allValuesFrom [
        rdf:type owl:Restriction ;
        owl:onProperty rdf:type ;
        owl:hasValue :PublicCharity
      ] ;
      owl:onProperty :satisfiesQualifyingDistribution ;
      owl:someValuesFrom :QualifyingDistribution
    ] .

###  IRC §4941 AXIOMS - Self-Dealing Prohibition (FULLY AXIOMATIZED)

###  Self-Dealing Transaction MUST involve Disqualified Person
:SelfDealingTransaction rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :involvesDisqualifiedPerson ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Self-Dealing Transaction triggers IRC §4941 violation
:SelfDealingTransaction rdfs:subClassOf :PrivateInurement .

###  Self-Dealing Prohibition prevents Self-Dealing Transactions
:SelfDealingProhibition rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :preventsMisuse ;
      owl:hasValue :SelfDealingTransaction
    ] .

###  Transaction with Disqualified Person is presumptively Self-Dealing
[ rdf:type owl:Restriction ;
  owl:onProperty :involvesDisqualifiedPerson ;
  owl:someValuesFrom :DisqualifiedPerson
] rdfs:subClassOf :SelfDealingTransaction .

###  Permitted Transactions are DISJOINT from Self-Dealing
:PermittedTransaction owl:disjointWith :SelfDealingTransaction .

###  IRC §4942 AXIOMS - Minimum Distribution Requirements (FULLY AXIOMATIZED)

###  Private Foundation MUST make Qualifying Distributions
:ForeignPrivateIrrevocableNonGrantorTrust rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :makesGrant ;
      owl:someValuesFrom [
        rdf:type owl:Restriction ;
        owl:onProperty :satisfiesQualifyingDistribution ;
        owl:someValuesFrom :QualifyingDistribution
      ]
    ] .

###  Fiscal Year tracks minimum distribution requirement
:FiscalYear rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :minimumDistributionRequired ;
      owl:someValuesFrom xsd:decimal
    ] .

###  Failure to meet minimum distribution is Authority Collapse
[ rdf:type owl:Class ;
  owl:intersectionOf (
    :FiscalYear
    [ rdf:type owl:Restriction ;
      owl:onProperty :qualifyingDistributionsMade ;
      owl:someValuesFrom [
        rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:decimal
      ]
    ]
  )
] .

###  IRC §4943 AXIOMS - Excess Business Holdings (FULLY AXIOMATIZED)

###  Excess Business Holding MUST have percentage
:ExcessBusinessHolding rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :excessHoldingPercentage ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Investment with excessive percentage is Excess Holding
[ rdf:type owl:Restriction ;
  owl:onProperty :excessHoldingPercentage ;
  owl:someValuesFrom [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:decimal ;
    owl:withRestrictions ([xsd:minInclusive "20.0"^^xsd:decimal])
  ]
] rdfs:subClassOf :ExcessBusinessHolding .

###  Excess Business Holding triggers IRC §4943 violation
:ExcessBusinessHolding rdfs:subClassOf :AuthorityCollapse .

###  Permitted Holdings are DISJOINT from Excess Holdings
:PermittedBusinessHolding owl:disjointWith :ExcessBusinessHolding .

###  IRC §4944 AXIOMS - Jeopardizing Investments (FULLY AXIOMATIZED)

###  Jeopardizing Investment MUST jeopardize a Purpose
:JeopardizingInvestment rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :jeopardizesMission ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

###  Jeopardizing Investment is Authority Collapse
:JeopardizingInvestment rdfs:subClassOf :AuthorityCollapse .

###  Jeopardizing Investment Rule prevents Jeopardizing Investments
:JeopardizingInvestmentRule rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :preventsMisuse ;
      owl:hasValue :JeopardizingInvestment
    ] .

###  Prudent Investment is DISJOINT from Jeopardizing Investment
:PrudentInvestment owl:disjointWith :JeopardizingInvestment .

###  IRC §4945 AXIOMS - Taxable Expenditures (FULLY AXIOMATIZED)

###  Taxable Expenditure is Authority Collapse
:TaxableExpenditure rdfs:subClassOf :AuthorityCollapse .

###  Lobbying Expenditure triggers IRC §4945(d)(1)
:LobbyingExpenditure rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :isTaxableExpenditure ;
      owl:hasValue :TaxableExpenditure
    ] .

###  Political Expenditure triggers IRC §4945(d)(2)
:PoliticalExpenditure rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :isTaxableExpenditure ;
      owl:hasValue :TaxableExpenditure
    ] .

###  Grant Without Expenditure Responsibility triggers IRC §4945(d)(4)
:GrantWithoutExpenditureResponsibility rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :isTaxableExpenditure ;
      owl:hasValue :TaxableExpenditure
    ] .

###  Grant to Non-Exempt Grantee requires Expenditure Responsibility
[ rdf:type owl:Restriction ;
  owl:onProperty :receivesGrant ;
  owl:someValuesFrom [
    rdf:type owl:Restriction ;
    owl:onProperty rdf:type ;
    owl:hasValue :NonExemptGrantee
  ]
] rdfs:subClassOf :GrantWithoutExpenditureResponsibility .

#################################################################
#    Individuals (Example Instances)
#################################################################

###  http://example.org/trust-domain#ExampleForeignTrust
:ExampleForeignTrust rdf:type owl:NamedIndividual ,
                              :ForeignPrivateIrrevocableNonGrantorTrust ;
    :isRevocable "false"^^xsd:boolean ;
    :isGrantorTrust "false"^^xsd:boolean ;
    :isForeign "true"^^xsd:boolean ;
    :isDomestic "false"^^xsd:boolean ;
    :jurisdiction "Nevis" ;
    :hasCourtJurisdiction "Nevis High Court" ;
    :hasControlLocation "Nevis" ;
    :establishedDate "2024-01-15"^^xsd:date ;
    :hasSystemIdentifier :ExampleForeignTrust_EIN ;
    :hasTrustee :ExampleTrustee ;
    rdfs:label "Example Foreign Private Irrevocable Non-Grantor Trust"@en ;
    rdfs:comment "Demonstrates foreign trust that has crossed IRC §§671-679 gateway, operates under IRC §§641-685 as autonomous system, classified under IRC §7701"@en .

###  http://example.org/trust-domain#ExampleForeignTrust_EIN
:ExampleForeignTrust_EIN rdf:type owl:NamedIndividual ,
                                  :EIN ;
    rdfs:label "Example EIN (system identifier; no number recorded)"@en ;
    rdfs:comment "System identifier for ExampleForeignTrust - enables interaction but is NOT an instrument"@en .

###  http://example.org/trust-domain#ExampleTrustee
:ExampleTrustee rdf:type owl:NamedIndividual ,
                         :Trustee ;
    rdfs:label "Example Trustee"@en ;
    rdfs:comment "Fiduciary holding legal title and exercising authority"@en .

###  http://example.org/trust-domain#ExampleDNI_2024
:ExampleDNI_2024 rdf:type owl:NamedIndividual ,
                          :DistributableNetIncome ;
    :dniAmount "150000.00"^^xsd:decimal ;
    rdfs:label "2024 DNI"@en ;
    rdfs:comment "Distributable Net Income for tax year 2024"@en .

###  http://example.org/trust-domain#ExampleIncomeDistribution
:ExampleIncomeDistribution rdf:type owl:NamedIndividual ,
                                    :IncomeDistribution ;
    :flowsCharacterThrough :ExampleCharacterFlow ;
    rdfs:label "Example Income Distribution"@en ;
    rdfs:comment "Distribution of current income to beneficiary with character flow-through"@en .

###  http://example.org/trust-domain#ExampleCharacterFlow
:ExampleCharacterFlow rdf:type owl:NamedIndividual ,
                               :CharacterFlowThrough ;
    rdfs:label "Example Character Flow"@en ;
    rdfs:comment "Income character (ordinary, capital gain, etc.) flowing through to beneficiary"@en .

###  http://example.org/trust-domain#Example_IRC_671_679_Gateway
:Example_IRC_671_679_Gateway rdf:type owl:NamedIndividual ,
                                      :IRC_671_679 ;
    rdfs:label "IRC §§671-679 Control-of-Income Boundary"@en ;
    rdfs:comment "The gateway that determines whether trust is its own system - absence of retained control powers creates non-grantor status"@en .

###  http://example.org/trust-domain#Example_IRC_641_685_OperatingSystem
:Example_IRC_641_685_OperatingSystem rdf:type owl:NamedIndividual ,
                                              :IRC_641_685 ;
    rdfs:label "IRC §§641-685 Autonomous Accounting System"@en ;
    rdfs:comment "Enables non-grantor trust to retain income, deploy expenses, distribute outputs with DNI and character flow-through"@en .

###  http://example.org/trust-domain#Example_IRC_7701_Jurisdiction
:Example_IRC_7701_Jurisdiction rdf:type owl:NamedIndividual ,
                                        :IRC_7701 ;
    rdfs:label "IRC §7701 Jurisdictional Identity"@en ;
    rdfs:comment "Determines which sovereign's rules apply via court test and control test"@en .

#################################################################
#    FINCH-DAGEN FOUNDATION MODEL (mission-grounded examples)
#
#    Rebuilt 2026-11-20 on the owner's full mission statement and his own
#    program ideas, run through the asset-to-program pipeline:
#      Asset -> Program (authorized activity) -> Operator in role ->
#      Expense domain -> Actual spend -> traces back to Purpose,
#      and every program names the lasting capability it builds.
#    This is a model (a digital twin). No trust or foundation has been
#    formed, nothing here has been filed, and every amount is illustrative.
#################################################################

###  Mission and purpose domains

:FoundationMission rdf:type owl:NamedIndividual ,
                            :CharitablePurpose ;
    :hasMissionStatement "Empowering lives through health, education, innovation, and opportunity in furtherance of long-term human and systemic capability." ;
    :purposeDescription "Health, education, innovation and opportunity are the means; long-term human and systemic capability is the end. A program that helps today but builds nothing lasting passes the first half of the mission and fails the second." ;
    :hasSubPurpose :FoundationHealthMission ,
                   :FoundationEducationMission ,
                   :FoundationInnovationMission ,
                   :FoundationOpportunityMission ;
    :legitimizes :FoundationAuthority ;
    rdfs:label "Foundation Mission"@en ;
    rdfs:comment "The overarching exempt purpose that legitimizes the foundation's authority. Every program, asset and dollar must trace back to it."@en .

:FoundationHealthMission rdf:type owl:NamedIndividual ,
                                  :HealthPurpose ;
    :authorizes :Program_ResidentHealthGraph ;
    rdfs:label "Health"@en .

:FoundationEducationMission rdf:type owl:NamedIndividual ,
                                     :EducationalPurpose ;
    :authorizes :Program_ChicagoGridLiteracy ,
                :Program_HempCurriculumGrants ;
    rdfs:label "Education"@en .

:FoundationInnovationMission rdf:type owl:NamedIndividual ,
                                      :InnovationPurpose ;
    :authorizes :Program_InstitutionalCapacity ;
    rdfs:label "Innovation"@en .

:FoundationOpportunityMission rdf:type owl:NamedIndividual ,
                                       :OpportunityPurpose ;
    :authorizes :Program_AIAgentTraining ;
    rdfs:label "Opportunity"@en .

###  The foundation (modeled, not formed)

:ExampleFoundationTrust rdf:type owl:NamedIndividual ,
                                 :ForeignPrivateIrrevocableNonGrantorTrust ;
    :isRevocable "false"^^xsd:boolean ;
    :isGrantorTrust "false"^^xsd:boolean ;
    :hasPurpose :FoundationMission ;
    :exercisesAuthority :FoundationAuthority ;
    :hasTrustee :FoundationTrustee ;
    :controls :Asset_PatternLibrary , :Asset_LocalAIWorkstation ,
              :Asset_GridCurriculumKit , :Asset_AgentTrainingTemplate ,
              :Asset_ResidentHealthGraphApp , :Asset_ScreeningIntakeTablets ;
    rdfs:label "Finch-Dagen Foundation (model)"@en ;
    rdfs:comment "Modeled private foundation. Not formed, no identifier issued, nothing filed. The trust class and jurisdiction are the repo's original example structure, not a decision; structure is for counsel."@en .

:FoundationAuthority rdf:type owl:NamedIndividual ,
                              :FiduciaryAuthority ;
    rdfs:label "Foundation Authority"@en ;
    rdfs:comment "Cascade link 1: the fiduciary authority the foundation exercises, legitimized by the mission."@en .

:FoundationTrustee rdf:type owl:NamedIndividual ,
                            :Trustee ;
    rdfs:label "Foundation Trustee"@en ;
    rdfs:comment "Fiduciary exercising authority to advance the mission."@en .

:TheKeystoneConstraint rdf:type owl:NamedIndividual ,
                                :KeystoneConstraint ;
    rdfs:label "The Keystone Constraint"@en ;
    rdfs:comment "Private enablement is permissible when and only when it is BOTH incidental to AND inseparable from purpose-driven execution. Graded by trust-domain-keystone-shapes.ttl."@en .

:ExampleOperatingBoundary rdf:type owl:NamedIndividual ,
                                   :OperatingBoundary ;
    rdfs:label "Foundation Operating Boundary"@en .

:FiscalYear2027 rdf:type owl:NamedIndividual ,
                         :FiscalYear ;
    :fiscalYearStart "2027-01-01"^^xsd:date ;
    :fiscalYearEnd "2027-12-31"^^xsd:date ;
    :yearNumber "2027"^^xsd:integer ;
    rdfs:label "Fiscal Year 2027 (modeled)"@en .

:USD_Unit_Note rdfs:comment "Amounts use gist:Magnitude in US dollars; all are illustrative."@en .
<http://qudt.org/vocab/currency/USD> rdf:type gist:UnitOfMeasure ;
    rdfs:label "US dollar"@en .

#################################################################
#    PROGRAM 1 - Innovation: Canonical Governance Infrastructure
#    (the owner's institutional capacity program for nonprofits)
#################################################################

:Program_InstitutionalCapacity rdf:type owl:NamedIndividual ,
                                        :AuthorizedActivity ;
    :advancesPurpose :FoundationInnovationMission ;
    :withinBoundary :ExampleOperatingBoundary ;
    :requires :Role_OntologySteward ;
    :buildsCapability :Cap_NonprofitSemanticCapacity ;
    rdfs:label "Canonical Governance Infrastructure for nonprofits"@en ;
    rdfs:comment "Delivers institutional capacity to nonprofits as shared vocabularies, governance patterns and reference implementations, run on local AI for underserved neighborhoods."@en .

:Cap_NonprofitSemanticCapacity rdf:type owl:NamedIndividual , :LongTermCapability ;
    :capabilityTest "A governance pattern reaches Emerging: replicated in two partner nonprofits beyond its first two pilots, and still in use a year later." ;
    rdfs:label "Nonprofits run their own shared vocabularies and governance patterns, without vendor lock-in"@en .

:Asset_PatternLibrary rdf:type owl:NamedIndividual , :IntangibleAsset ;
    :deployedIn :Program_InstitutionalCapacity ;
    rdfs:label "A Pattern Language for Public Benefit (pattern library)"@en .

:Asset_LocalAIWorkstation rdf:type owl:NamedIndividual , :TangibleAsset ;
    :deployedIn :Program_InstitutionalCapacity ;
    rdfs:label "Local AI workstation for neighborhood deployments"@en .

:Role_OntologySteward rdf:type owl:NamedIndividual , :OperatorInRole ;
    :servesActivity :Program_InstitutionalCapacity ;
    :necessitates :CompDomain_OntologySteward ;
    rdfs:label "Ontology steward"@en .

:CompDomain_OntologySteward rdf:type owl:NamedIndividual , :CompensationDomain ;
    :sustains :Role_OntologySteward ;
    :manifestsAs :Pay_OntologySteward_Jan2027 ;
    :enablesPrivately :Enable_OntologyStewardStipend ;
    rdfs:label "Compensation domain: ontology steward"@en .

:Pay_OntologySteward_Jan2027 rdf:type owl:NamedIndividual , :ActualSpend ;
    :tracesBackTo :FoundationInnovationMission ;
    :occursDuring :FiscalYear2027 ;
    gist:hasMagnitude [ rdf:type gist:Magnitude ; gist:numericValue "6000.00"^^xsd:decimal ;
