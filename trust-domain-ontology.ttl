#################################################################

:Program_HempCurriculumGrants rdf:type owl:NamedIndividual ,
                                       :GrantmakingActivity ;
    :advancesPurpose :FoundationEducationMission ;
    :hasTemporalExtent :FiscalYear2027 ;
    :buildsCapability :Cap_HempWorkforce ;
    rdfs:label "Grants for an industrial hemp and textiles curriculum"@en ;
    rdfs:comment "Grantmaking, distinct from operations: funds a public charity to teach industrial hemp and textile skills. No intoxicating or cannabis products."@en .

:Cap_HempWorkforce rdf:type owl:NamedIndividual , :LongTermCapability ;
    :capabilityTest "A cohort completes the curriculum and the grantee keeps offering it without a second grant." ;
    rdfs:label "Local learners qualified for industrial hemp and textile work"@en .

:Grant_HempCurriculum rdf:type owl:NamedIndividual , :Grant ;
    :grantAmount "40000.00"^^xsd:decimal ;
    :grantedUnder :Program_HempCurriculumGrants ;
    :tracesBackTo :FoundationEducationMission ;
    :satisfiesQualifyingDistribution :QD_HempCurriculumGrant ;
    :occursDuring :FiscalYear2027 ;
    rdfs:label "Hemp curriculum grant: $40,000 (illustrative)"@en .

:Grantee_CommunityCollege rdf:type owl:NamedIndividual , :PublicCharity ;
    :receivesGrant :Grant_HempCurriculum ;
    rdfs:label "Community college (public charity, unnamed)"@en .

:QD_HempCurriculumGrant rdf:type owl:NamedIndividual , :QualifyingDistribution ;
    rdfs:label "Qualifying distribution: hemp curriculum grant"@en ;
    rdfs:comment "A grant to a public charity counts toward the IRC §4942 minimum distribution."@en .

:TheAuthorityCascade rdf:type owl:NamedIndividual ,
                              :AuthorityCascade ;
    rdfs:label "The Authority Cascade: Mission to Spend"@en ;
    rdfs:comment """THE CASCADE, WITH THE ASSET-TO-PROGRAM PIPELINE (AI trainer example):

1. MISSION (FoundationMission) legitimizes FoundationAuthority
2. PURPOSE DOMAIN (FoundationOpportunityMission) authorizes the program
3. PROGRAM (Program_AIAgentTraining) builds a lasting capability (Cap_ResidentAgentOperators) and holds its asset (Asset_AgentTrainingTemplate)
4. OPERATOR IN ROLE (Role_AITrainer) is required by the program
5. EXPENSE DOMAINS (CompDomain_AITrainer, BenefitsDomain_AITrainer) sustain the operator
6. ACTUAL SPEND (Pay_AITrainer_Feb2027, Pay_AITrainerBenefits_Feb2027), within market rate
7. TRACES BACK TO the Opportunity purpose, confirmed by the path above

trust-domain-keystone-shapes.ttl checks every link; validate_keystone.py runs it."""@en .


#################################################################
#    PROGRAM 5 - Health: resident-owned personal health knowledge graphs
#################################################################

:Program_ResidentHealthGraph rdf:type owl:NamedIndividual ,
                                      :AuthorizedActivity ;
    :advancesPurpose :FoundationHealthMission ;
    :withinBoundary :ExampleOperatingBoundary ;
    :requires :Role_HealthNavigator ;
    :buildsCapability :Cap_ResidentHealthBaseline ;
    rdfs:label "Resident-owned personal health knowledge graphs"@en ;
    rdfs:comment "For residents of neighborhoods with food deserts and thin access to care. Each resident keeps their own health graph, on their own device, gathering results over time from free community screenings (kidney checks, blood panels, dental) and their own doctor visits, read against optimal ranges as well as reference ranges, so they hold a baseline. The resident owns the record; the foundation owns only the tools."@en .

:Cap_ResidentHealthBaseline rdf:type owl:NamedIndividual , :LongTermCapability ;
    :capabilityTest "Twelve months after joining, participants still keep their own record, it holds results from at least two separate screenings, and they can show or share it with a clinician of their choosing." ;
    rdfs:label "Residents hold and use their own longitudinal health baseline"@en .

:Asset_ResidentHealthGraphApp rdf:type owl:NamedIndividual , :IntangibleAsset ;
    :deployedIn :Program_ResidentHealthGraph ;
    rdfs:label "Open-source on-device health record app and health ontology"@en .

:Asset_ScreeningIntakeTablets rdf:type owl:NamedIndividual , :TangibleAsset ;
    :deployedIn :Program_ResidentHealthGraph ;
    rdfs:label "Tablets for loading results at community screening events"@en .

:Role_HealthNavigator rdf:type owl:NamedIndividual , :OperatorInRole ;
    :servesActivity :Program_ResidentHealthGraph ;
    :necessitates :CompDomain_HealthNavigator ;
    rdfs:label "Community health navigator"@en .

:CompDomain_HealthNavigator rdf:type owl:NamedIndividual , :CompensationDomain ;
    :sustains :Role_HealthNavigator ;
    :manifestsAs :Pay_HealthNavigator_Apr2027 ;
    :enablesPrivately :Enable_HealthNavigatorPay ;
    rdfs:label "Compensation domain: community health navigator"@en .

:Pay_HealthNavigator_Apr2027 rdf:type owl:NamedIndividual , :ActualSpend ;
    :tracesBackTo :FoundationHealthMission ;
    :occursDuring :FiscalYear2027 ;
    gist:hasMagnitude [ rdf:type gist:Magnitude ; gist:numericValue "3500.00"^^xsd:decimal ;
        gist:hasUnitOfMeasure <http://qudt.org/vocab/currency/USD> ; :hasPaymentPeriod :PerMonth ] ;
    rdfs:label "Health navigator pay, April 2027: $3,500 (illustrative)"@en .

:Enable_HealthNavigatorPay rdf:type owl:NamedIndividual , :EmployeeCompensationEnablement ;
    :isIncidentalTo :FoundationHealthMission ;
    :isInseparableFrom :Program_ResidentHealthGraph ;
    :hasMarketBenchmark :Benchmark_HealthNavigator ;
    rdfs:label "Health navigator pay"@en ;
    rdfs:comment "Expected to pass: $42,000 a year against a $52,000 benchmark."@en .

:Benchmark_HealthNavigator rdf:type gist:Magnitude ;
    gist:numericValue "52000.00"^^xsd:decimal ;
    gist:hasUnitOfMeasure <http://qudt.org/vocab/currency/USD> ;
    :hasPaymentPeriod :PerYear ;
    dcterms:source "Illustrative value, not a market survey" ;
    rdfs:label "Market rate: community health worker, $52,000 per year (illustrative)"@en .

###  Two participants (anonymous, illustrative). No health data is modeled.

:Participant_A rdf:type owl:NamedIndividual , :ProgramParticipant ;
    :participatesIn :Program_ResidentHealthGraph ;
    rdfs:label "Participant A (anonymous)"@en .

:Record_ParticipantA rdf:type owl:NamedIndividual , :ParticipantRecord ;
    :ownedBy :Participant_A ;
    :heldUnder :Program_ResidentHealthGraph ;
    rdfs:label "Participant A's health graph (local only)"@en .

:Participant_B rdf:type owl:NamedIndividual , :ProgramParticipant ;
    :participatesIn :Program_ResidentHealthGraph ;
    rdfs:label "Participant B (anonymous)"@en .

:Record_ParticipantB rdf:type owl:NamedIndividual , :ParticipantRecord ;
    :ownedBy :Participant_B ;
    :heldUnder :Program_ResidentHealthGraph ;
    :sharedWith :Recipient_ParticipantBClinician ;
    :hasConsent :Consent_ParticipantB_Clinician ;
    rdfs:label "Participant B's health graph, shared with B's own clinician"@en .

:Recipient_ParticipantBClinician rdf:type owl:NamedIndividual ;
    rdfs:label "Participant B's own clinician (unnamed)"@en .

:Consent_ParticipantB_Clinician rdf:type owl:NamedIndividual , :ConsentRecord ;
    :grantedBy :Participant_B ;
    :consentFor :Recipient_ParticipantBClinician ;
    :consentScope :SharedWithNamedRecipient ;
    :consentRevocable "true"^^xsd:boolean ;
    rdfs:label "B's consent to share with their own clinician"@en .

###  The founder, as the graph must see him: a disqualified person.

:Founder rdf:type owl:NamedIndividual , :FoundationManager , :SubstantialContributor ;
    rdfs:label "Founder (disqualified person)"@en ;
    rdfs:comment "Foundation manager and substantial contributor, so a disqualified person under IRC §4946, as are family members. Foundation money cannot pay for his own care or build his own health records."@en .

###  IRC §§4941-4945 VIOLATION EXAMPLES

###  http://example.org/trust-domain#ExampleSelfDealing
:ExampleSelfDealing rdf:type owl:NamedIndividual ,
                             :SelfDealingTransaction ;
    :involvesDisqualifiedPerson :ExampleTrusteeAsDisqualifiedPerson ;
    rdfs:label "Example: Self-Dealing Transaction"@en ;
    rdfs:comment "Transaction between foundation and trustee (disqualified person) - PROHIBITED under IRC §4941"@en .

###  http://example.org/trust-domain#ExampleTrusteeAsDisqualifiedPerson
:ExampleTrusteeAsDisqualifiedPerson rdf:type owl:NamedIndividual ,
                                             :FoundationManager ,
                                             :DisqualifiedPerson ;
    rdfs:label "Trustee (Disqualified Person)"@en ;
    rdfs:comment "Foundation manager is disqualified person under IRC §4946"@en .

###  http://example.org/trust-domain#ExampleJeopardizingInvestment
:ExampleJeopardizingInvestment rdf:type owl:NamedIndividual ,
                                        :JeopardizingInvestment ;
    :jeopardizesMission :FoundationHealthMission ;
    rdfs:label "Example: Jeopardizing Investment"@en ;
    rdfs:comment "Speculative investment jeopardizing ability to carry out health mission - PROHIBITED under IRC §4944"@en .

###  http://example.org/trust-domain#ExampleLobbyingExpense
:ExampleLobbyingExpense rdf:type owl:NamedIndividual ,
                                 :LobbyingExpenditure ,
